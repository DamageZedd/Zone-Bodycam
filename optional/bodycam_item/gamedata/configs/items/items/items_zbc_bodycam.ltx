; Zone Bodycam - bodycam item (optional FOMOD component)
; Carried anywhere in the inventory, it powers the bodycam effect (scripts\zbc_item.script).
; Condition = battery charge; batteries are swapped like vanilla devices (mod_devices_zbc_bodycam.ltx).

[zbc_bodycam_item]:identity_immunities
GroupControlSection  = spawn_group
discovery_dependency =
$spawn               = "devices\zbc_bodycam_item"
class                = II_ATTCH
kind                 = i_device
cform                = skeleton
visual               = dynamics\devices\zbc_bodycam\zbc_bodycam.ogf
inv_name             = st_zbc_bodycam_item_name
inv_name_short       = st_zbc_bodycam_item_name
description          = st_zbc_bodycam_item_descr
inv_weight           = 0.32
icons_texture        = ui\ui_icon_zbc_bodycam
inv_grid_width       = 2
inv_grid_height      = 2
inv_grid_x           = 0
inv_grid_y           = 0
cost                 = 5000
tier                 = 2
power_critical       = 0.05
use6_functor         = item_device.menu_battery
use6_action_functor  = item_device.func_battery

; First-person hand animations (scripts\zbc_item_anim.script): battery dead / new battery.
; Hand motions: meshes\anomaly_weapons\hud_hands_animation\zbc_bodycam_hud_animation.omf.
; anm_* = hand motion, item motion (the in-hand model's own motion: its battery bone).
[zbc_bodycam_anim_hud]
hands_position         = 0, 0, 0
hands_orientation      = 0, 0, 0
hands_position_16x9    = 0, 0, 0
hands_orientation_16x9 = 0, 0, 0
item_visual            = dynamics\devices\zbc_bodycam\zbc_bodycam_hud.ogf
anm_zbc_dead           = zbc_bodycam_dead, zbc_bodycam_dead_item
anm_zbc_insert         = zbc_bodycam_insert, zbc_bodycam_insert_item
