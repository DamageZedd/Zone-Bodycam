; Zone Bodycam - bodycam items (optional FOMOD component)
; Carried anywhere in the inventory, any charged Axon Body camera powers the bodycam effect
; (scripts\zbc_item.script). Condition = battery charge; batteries are swapped like vanilla devices
; (mod_devices_zbc_bodycam.ltx). Axon Body 4 keeps [zbc_bodycam_item] for save compatibility.
; Generations 1 (worst) .. 5 (best), scripts\zbc_tiers.script. Only Body 1 is sold (cost 5000, also given on
; a new game); Body 2-5 are crafted from the generation before (items\settings\mod_craft_zbc_bodycam.ltx).
; Icons: 1x1, one 50x50 cell each in textures\ui\ui_icon_zbc_bodycam.dds (256x64, inv_grid_x 0..4). The FOMOD
; "HD icons" option (optional\bodycam_item_hd_icons) swaps in 100x100 icons for HD Inventory Icons Framework.

[zbc_bodycam_item]:identity_immunities
GroupControlSection  = spawn_group
discovery_dependency =
$spawn               = "devices\zbc_bodycam_item"
class                = II_ATTCH
kind                 = i_device
cform                = skeleton
visual               = dynamics\devices\zbc_bodycam\zbc_bodycam.ogf
inv_name             = st_zbc_bodycam_item_name
inv_name_short       = st_zbc_bodycam_item_name
description          = st_zbc_bodycam_item_descr
inv_weight           = 0.32
icons_texture        = ui\ui_icon_zbc_bodycam
inv_grid_width       = 1
inv_grid_height      = 1
inv_grid_x           = 0
inv_grid_y           = 0
cost                 = 16000
tier                 = 4
power_critical       = 0.05
use_condition        = true                ; with condition_bar: the blue charge bar on the icon (vanilla tch_device)
condition_bar        = power_progess_bar
use6_functor         = item_device.menu_battery
use6_action_functor  = item_device.func_battery

[zbc_bodycam_1]:zbc_bodycam_item
$spawn               = "devices\zbc_bodycam_1"
visual               = dynamics\devices\zbc_bodycam\zbc_bodycam_1.ogf
inv_name             = st_zbc_bodycam_1_name
inv_name_short       = st_zbc_bodycam_1_name
description          = st_zbc_bodycam_1_descr
inv_weight           = 0.20
inv_grid_x           = 1
inv_grid_y           = 0
cost                 = 5000
tier                 = 1

