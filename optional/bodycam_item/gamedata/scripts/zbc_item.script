--[[
	Zone Bodycam - bodycam item (optional FOMOD component)

	The bodycam effect only runs while the actor carries a charged Axon Body camera (Gen 1, 2, 3, 4, or 5)
	anywhere in the inventory, like the Wearable Devices items. The item's condition is its charge:
	it drains in real time while the camera runs (scaled per camera generation) and is swapped with vanilla
	batteries (drag a battery onto it, or "Unpack battery"), registered in items\settings\mod_devices_zbc_bodycam.ltx.

	Hooks into zbc_bodycam.script through zbc_bodycam.set_power_gate(), set_battery_source(), and
	set_device_source(); the base mod never looks this script up, so without this component it stays always-on.
]]

ITEM_SECTION = "zbc_bodycam_item"

CAMERA_ORDER = {
	"zbc_bodycam_1",
	"zbc_bodycam_2",
	"zbc_bodycam_3",
	"zbc_bodycam_item",
	"zbc_bodycam_5",
}

CAMERAS = {
	zbc_bodycam_1    = { gen = 1, hud = "zbc_bodycam_1_anim_hud", label = "AXON BODY",   drain_mult = 1.333 },
	zbc_bodycam_2    = { gen = 2, hud = "zbc_bodycam_2_anim_hud", label = "AXON BODY 2", drain_mult = 1.143 },
	zbc_bodycam_3    = { gen = 3, hud = "zbc_bodycam_3_anim_hud", label = "AXON BODY 3", drain_mult = 1.053 },
	zbc_bodycam_item = { gen = 4, hud = "zbc_bodycam_anim_hud",   label = "AXON BODY 4", drain_mult = 1.000 },
	zbc_bodycam_5    = { gen = 5, hud = "zbc_bodycam_5_anim_hud", label = "AXON BODY 5", drain_mult = 0.833 },
}

STICKY_EPS            = 0.002    -- anti-ping-pong charge bonus for the currently active charged camera
local TIE_EPS         = 1e-6
local DEFAULT_HOURS   = 4        -- real hours of recording per full charge (Axon Body 4 baseline)
local MIN_HOURS       = 0.25
local MAX_HOURS       = 48
local DEFAULT_CRIT    = 0.05     -- vanilla condition_critical, used if item_device has no value
local SCAN_MS         = 1000     -- inventory re-scan period
local MAX_STEP_MS     = 1000     -- longer gaps (loading, pause hitches) are not drained

---------------------------------------------------------------------------------------------------
-- Pure logic (tested by tools\tests\zbc_item_test.lua)
---------------------------------------------------------------------------------------------------

-- battery life in real hours, from the MCM value (any type), clamped
function clamp_hours(v)
	v = tonumber(v)
	if not v or v ~= v then return DEFAULT_HOURS end
	if v < MIN_HOURS then return MIN_HOURS end
	if v > MAX_HOURS then return MAX_HOURS end
	return v
end

-- charge after dt_ms milliseconds of recording; factor scales the drain (difficulty economy * generation)
function drain_step(charge, dt_ms, hours, factor)
	charge = tonumber(charge) or 0
	dt_ms = tonumber(dt_ms) or 0
	if dt_ms <= 0 or dt_ms > MAX_STEP_MS then return charge end
	factor = tonumber(factor) or 1
	if factor < 0 then factor = 0 end
	local loss = (dt_ms / 1000) / (clamp_hours(hours) * 3600) * factor
	local c = charge - loss
	if c < 0 then c = 0 end
	return c
end

-- The engine keeps an item's condition as a float32. One frame of drain is often smaller than half a float
-- step near full charge (long battery life, a low difficulty factor, high fps), so subtracting it from the
-- stored condition every frame rounds straight back and the camera never drains. The exact charge is kept
-- here as a Lua double instead and only rounded when it is written. base_charge picks what to drain from:
-- the exact charge while the item still holds what we last wrote, else the item's own (a battery put in,
-- a trade, another script changed it).
function base_charge(exact, written, current)
	if exact and written and current == written then return exact end
	return current
end

-- true while the charge is above the critical level (vanilla: devices stop below it)
function is_charged(charge, critical)
	charge = tonumber(charge)
	if not charge then return false end
	return charge > (tonumber(critical) or DEFAULT_CRIT)
end

-- Low-battery warning: a message and a beep at 10% and again at 6%; re-armed once the charge is
-- back above 15% (a new battery). given: warnings already given (0..2). Returns the new count and
-- whether to warn now.
LOW_LEVELS = { 0.10, 0.06 }
LOW_RESET  = 0.15
function low_warning(charge, given)
	charge = tonumber(charge)
	given = tonumber(given) or 0
	if not charge then return given, false end
	if charge > LOW_RESET then return 0, false end
	for i = #LOW_LEVELS, 1, -1 do
		if given < i and charge <= LOW_LEVELS[i] then return i, true end
	end
	return given, false
end

-- index of the entry with the highest charge in a list of charges (nil for an empty list).
-- When `gens` is supplied, equal charges (within TIE_EPS) break ties toward higher camera generation.
function best_index(charges, gens)
	local best, best_gen, bi = nil, -1, nil
	for i = 1, #charges do
		local c = tonumber(charges[i])
		if c then
			if not gens then
				if not best or c > best then best, bi = c, i end
			else
				local g = tonumber(gens[i]) or 0
				if not best or c > best + TIE_EPS then
					best, best_gen, bi = c, g, i
				elseif math.abs(c - best) <= TIE_EPS and g > best_gen then
					if c > best then best = c end
					best_gen, bi = g, i
				end
			end
		end
	end
	return bi
end

---------------------------------------------------------------------------------------------------
-- Runtime
---------------------------------------------------------------------------------------------------

local cam_id = nil           -- id of the bodycam being drained, nil: none carried
local cam_charged = false
local next_scan = 0
local last_t = nil
local hours = DEFAULT_HOURS
local enabled = true
local tier_limits = true     -- MCM: each camera generation has its own features and picture quality
local crit_charge = DEFAULT_CRIT
local crit_by_sec = {}
local eco_mult = 1
local warned_dead = false
local warned_low = 0         -- low-battery warnings given for this battery (low_warning)
local seen_charge = {}       -- camera id -> its charge at the previous look, for EVERY carried camera: a
                             -- battery put into any of them (not only the active one) is a jump here
local last_charge_id = nil   -- the active camera at the previous look
local exact_id = nil         -- camera whose exact (double) charge is kept, see base_charge
local exact_charge = nil
local exact_written = nil    -- the condition the item held right after our last write

local function crit_of(sec)
	return (sec and crit_by_sec[sec]) or crit_charge
end

local function mcm(id, def)
	if ui_mcm and ui_mcm.get then
		local ok, v = pcall(ui_mcm.get, id)
		if ok and v ~= nil then return v end
	end
	return def
end

local function load_settings()
	hours = clamp_hours(mcm("zone_bodycam_item/battery_hours", DEFAULT_HOURS))
	enabled = mcm("zone_bodycam/enabled", true) == true
	tier_limits = mcm("zone_bodycam_item/tier_limits", true) ~= false
	crit_by_sec = {}
	for i = 1, #CAMERA_ORDER do
		local sec = CAMERA_ORDER[i]
		local c = item_device and item_device.get_power_critical and item_device.get_power_critical(sec)
		crit_by_sec[sec] = tonumber(c) or DEFAULT_CRIT
	end
	crit_charge = crit_by_sec[ITEM_SECTION] or DEFAULT_CRIT
	eco_mult = 1
	if game_difficulties and game_difficulties.get_eco_factor then
		local ok, f = pcall(game_difficulties.get_eco_factor, "battery_consumption")
		if ok and tonumber(f) then eco_mult = tonumber(f) end
	end
	if not enabled then
		last_t = nil
		seen_charge, last_charge_id = {}, nil
		next_scan = 0
		if zbc_item_anim then zbc_item_anim.reset() end
	end
end

local function carried_cam()
	local obj = cam_id and level.object_by_id(cam_id)
	local parent = obj and obj:parent()
	if not (parent and parent:id() == (AC_ID or 0)) then return nil end
	if not CAMERAS[obj:section()] then return nil end
	return obj
end

-- picks the carried bodycam with the most charge (breaking ties by generation, with STICKY_EPS
-- hysteresis for the already-active charged camera so two full cameras do not ping-pong every second).
-- Also looks at every carried camera's charge: returns the HUD section of a camera that just got a new
-- battery (its charge jumped since the previous look), else nil. A battery put into a dead camera other
-- than the active one makes that camera the active one, so the active camera alone cannot spot it.
local function scan()
	local actor = db.actor
	local prev_obj = carried_cam()
	local sticky_id = nil
	if prev_obj and is_charged(prev_obj:condition(), crit_of(prev_obj:section())) then
		sticky_id = prev_obj:id()
	end
	cam_id = nil
	if not actor then return end
	local ids, scores, gens = {}, {}, {}
	local seen, inserted = {}, nil
	local anim = zbc_item_anim
	actor:iterate_inventory(function(_, obj)
		local sec = obj and obj:section()
		local def = sec and CAMERAS[sec]
		if def then
			local id = obj:id()
			local c = tonumber(obj:condition()) or 0
			if anim and anim.is_insert(seen_charge[id], c) then inserted = def.hud end
			seen[id] = c
			if sticky_id and id == sticky_id then
				c = c + STICKY_EPS
			end
			ids[#ids + 1] = id
			scores[#scores + 1] = c
			gens[#gens + 1] = def.gen
		end
	end, actor)
	seen_charge = seen               -- cameras no longer carried are forgotten (picked up charged: no insert)
	local i = best_index(scores, gens)
	if i then cam_id = ids[i] end
	return inserted
end

-- message and a short vanilla beep (the RF detector's)
local beep = nil
function low_battery_alert()
	if actor_menu and actor_menu.set_msg then
		actor_menu.set_msg(1, game.translate_string("st_zbc_bodycam_item_low"), 4)
	end
	local ok = pcall(function()
		beep = beep or sound_object("detectors\\RF\\beep_02")
		beep:play(db.actor, 0, sound_object.s2d)
	end)
	return ok
end

local function refresh(now, silent)
	local prev_obj = carried_cam()
	local prev_sec = prev_obj and prev_obj:section()
	local inserted = nil
	if now >= next_scan then
		next_scan = now + SCAN_MS
		inserted = scan()
	end
	local obj = carried_cam()
	if not obj then cam_id = nil end
	local sec = obj and obj:section()
	local cam_def = sec and CAMERAS[sec]
	local was = cam_charged
	cam_charged = (obj and cam_def and is_charged(obj:condition(), crit_of(sec))) or false
	local anim = zbc_item_anim
	if was and not cam_charged and obj then
		if not warned_dead and actor_menu and actor_menu.set_msg then
			actor_menu.set_msg(1, game.translate_string("st_zbc_bodycam_item_dead"), 4)
		end
		warned_dead = true
		local dead_hud = (prev_sec and CAMERAS[prev_sec] and CAMERAS[prev_sec].hud) or (cam_def and cam_def.hud)
		if anim then anim.request("dead", now, dead_hud) end
	elseif cam_charged then
		warned_dead = false
	end
	-- a battery put on the camera (in the inventory) shows up as a jump in its charge
	local charge = obj and obj:condition()
	if not obj then
		warned_low = 0
	elseif silent or cam_id ~= last_charge_id then
		warned_low = low_warning(charge, 0)
	elseif charge and cam_charged then
		local warn
		warned_low, warn = low_warning(charge, warned_low)
		if warn then low_battery_alert() end
	end
	if anim and charge and cam_id and anim.is_insert(seen_charge[cam_id], charge) then
		inserted = cam_def and cam_def.hud
	end
	if cam_id and charge then seen_charge[cam_id] = charge end
	if anim and inserted and not silent then anim.request("insert", now, inserted) end
	last_charge_id = cam_id
	return obj
end

-- the power gate for zbc_bodycam.script: off while a battery-insert animation has not yet put the
-- camera back on the chest
function has_power()
	if cam_charged and zbc_item_anim and zbc_item_anim.holding_power() then return false end
	return cam_charged
end

-- the overlay's battery gauge (zbc_bodycam.script): charge 0..1 of the carried camera, nil without one
function battery_level()
	local obj = carried_cam()
	return obj and obj:condition() or nil
end

-- the overlay's default device label (zbc_bodycam.script): generation label of the carried camera, nil without one
function active_device_label()
	local obj = carried_cam()
	local def = obj and CAMERAS[obj:section()]
	return def and def.label or nil
end

-- the camera tier for zbc_bodycam.script (zbc_tiers.script): generation of the carried camera, nil
-- without one or with the generation limits turned off in the MCM (every camera then works like Body 4)
function tier_of(sec, limits_on)
	if limits_on == false then return nil end
	local def = sec and CAMERAS[sec]
	return def and def.gen or nil
end

function active_tier()
	local obj = carried_cam()
	return tier_of(obj and obj:section(), tier_limits)
end

local function actor_on_update()
	if not enabled then return end
	local now = time_global()
	local last = last_t
	last_t = now
	local obj = refresh(now)
	if obj and has_power() and last then
		local def = CAMERAS[obj:section()]
		local mult = def and def.drain_mult or 1
		local id = obj:id()
		local base = obj:condition()
		if exact_id == id then base = base_charge(exact_charge, exact_written, base) end
		local c = drain_step(base, now - last, hours, eco_mult * mult)
		obj:set_condition(c)
		exact_id, exact_charge, exact_written = id, c, obj:condition()
		seen_charge[id] = exact_written  -- our own drain is never mistaken for a new battery
	end
	if zbc_item_anim then zbc_item_anim.update(now, obj ~= nil) end
end

local function actor_on_first_update()
	load_settings()
	last_t = nil
	next_scan = 0
	cam_charged = false
	warned_low = 0
	seen_charge, last_charge_id = {}, nil
	exact_id, exact_charge, exact_written = nil, nil, nil
	if zbc_item_anim then zbc_item_anim.reset() end
	refresh(time_global(), true)
	warned_dead = not cam_charged    -- no "battery dead" message for a camera that was already dead
end

local function actor_on_net_destroy()
	if zbc_item_anim then zbc_item_anim.reset() end
end

local function inventory_changed()
	next_scan = 0                    -- re-scan on the next update
end

local function main_menu_on_quit()
	last_t = nil                     -- the pause is not drained
end

function on_game_start()
	load_settings()
	if zbc_bodycam and zbc_bodycam.set_power_gate then
		zbc_bodycam.set_power_gate(has_power)
		if zbc_bodycam.set_battery_source then zbc_bodycam.set_battery_source(battery_level) end
		if zbc_bodycam.set_device_source then zbc_bodycam.set_device_source(active_device_label) end
		if zbc_bodycam.set_tier_source then zbc_bodycam.set_tier_source(active_tier) end
	else
		printf("! [Zone Bodycam] bodycam item: zbc_bodycam.script not found, the item component needs the base mod")
	end
	RegisterScriptCallback("actor_on_first_update", actor_on_first_update)
	RegisterScriptCallback("actor_on_update", actor_on_update)
	RegisterScriptCallback("actor_on_net_destroy", actor_on_net_destroy)
	RegisterScriptCallback("actor_on_item_take", inventory_changed)
	RegisterScriptCallback("actor_on_item_drop", inventory_changed)
	RegisterScriptCallback("main_menu_on_quit", main_menu_on_quit)
	RegisterScriptCallback("on_option_change", load_settings)
end
