#include "common.h"
#include "hdr10.h"
// Zone Bodycam: this is the modded-exes / Slop-Ray postprocess.ps (db\mods\00_modded_exes_gamedata.db0)
// with the bodycam lens added. Everything outside the ZBC_ACTIVE branches is unchanged.
#include "zbc_lens.h"
#include "zbc_osd.h"
/*
struct 	v2p
{
//D3DFVF_XYZRHW|D3DFVF_DIFFUSE|D3DFVF_SPECULAR|D3DFVF_TEX3
	float4 	color:		COLOR0;		// multiplier, color.w = noise_amount
	float4	gray:		COLOR1;		// (.3,.3,.3.,amount)
 	float2 	tc0: 		TEXCOORD0;	// base1 (duality)
 	float2 	tc1: 		TEXCOORD1;	// base2 (duality)
 	float2 	tc2: 		TEXCOORD2;	// base  (noise)
};
*/

Texture2D 	s_base0;
Texture2D 	s_base1;
Texture2D 	s_noise;
uniform float4 		c_brightness;

//////////////////////////////////////////////////////////////////////////////////////////
// Pixel
float4 main( p_postpr I ) : SV_Target
{
	float3	t_0;
	float3	t_1;
	[branch] if (ZBC_ACTIVE)
	{
		t_0 = zbc_lens_sample(s_base0, I.Tex0);
		t_1 = (abs(I.Tex1.x - I.Tex0.x) + abs(I.Tex1.y - I.Tex0.y) < 0.000001) ? t_0 : zbc_lens_sample(s_base1, I.Tex1);
	}
	else
	{
		t_0 	= s_base0.Sample( smp_rtlinear, I.Tex0);
		t_1 	= s_base1.Sample( smp_rtlinear, I.Tex1);
	}
	float3 	image	= (t_0+t_1)*.5;					// add_d2
	// Lens bezel / corner vignette applies to the optical scene BEFORE compositing the top-right Axon overlay
	float	scene_vis = 1.0;
	[branch] if (ZBC_ACTIVE)
	{
		scene_vis = zbc_valid(I.Tex0);
		if (bus_zbc_extra.w >= 0.5)
			scene_vis *= lerp(1.0, zbc_render(I.Tex0), saturate(bus_zbc_motion.x * 4.0));
		image *= scene_vis;
	}
	float	osd_mask = 0.0;
	[branch] if (ZBC_ACTIVE)
		zbc_osd_composite(image, I.Tex0, osd_mask);
	float3	ddx_img	= ddx(image);
	float3	ddy_img	= ddy(image);
	[branch] if (ZBC_ACTIVE)
		image = zbc_sensor_pass(image, I.Tex0, ddx_img, ddy_img);

	float	gray 	= dot		(image,I.Gray);			// dp3
			image 	= lerp 		(gray,image,I.Gray.w);		// mul/mad

	float4	t_noise	= s_noise.Sample( smp_linear, I.Tex2);
	float3 	noised 	= image * t_noise.rgb * 2;                     		// mul_2x
			image	= lerp( noised, image, I.Color.w); 	// lrp ?
			image	= (image * I.Color + c_brightness * saturate(scene_vis + osd_mask))*2;		// mad

	[branch] if (ZBC_ACTIVE && bus_zbc_extra.w >= 0.5)
		image = zbc_grain(image, I.Tex0, osd_mask, scene_vis);

	// out
	image = HDR10_ToDisplay_World(image);

	return  float4( image, 1.0h);					// +mov
}
