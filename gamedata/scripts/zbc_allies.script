--[[
	Zone Bodycam - ally markers (zbc_allies.script)

	"Ally safe" markers from bodycam_effect, rebuilt:
	- boxes (or corner brackets) on every stalker: white while unknown, then decoded to friendly green
	  (neutrals included) or enemy red, another colour for companions,
	  dots past a distance, plus optional enemy and mutant markers
	- placed through the exact inverse of the Zone Bodycam lens (fisheye, zoom, body motion), so a box
	  sits on the NPC you see, not where it would be without the lens
	- a fixed pool of HUD statics, reused every frame (the original created new ones and leaked)
	- candidates rescanned 4x a second; positions updated every frame
	- optional: only NPCs the actor can see

	Called by zbc_bodycam.script: build() from the HUD constructor, update() every frame.
]]

local abs, floor, min, max, sin, cos, sqrt = math.abs, math.floor, math.min, math.max, math.sin, math.cos, math.sqrt

local POOL = 20
local SCAN_INTERVAL = 0.25
local MAX_DT = 0.1

local LOS_GRACE = 0.05
local LOS_INTERVAL = 0.05
local RQ_FLAGS = 3               -- rqtObject (1) + rqtStatic (2)
local FL_PASSABLE = 128             -- bit 7
local FL_VISION_OPAQUE = 1073741824 -- bit 30 (0x40000000): set on opaque solids in gamemtl.xr
local LOS_MAX_STEPS = 3

local POP_IN_RATE = 2.5
local POP_OUT_RATE = 2.5
local DEAD_OUT_RATE = 5.0
local MORPH_RATE = 1.8
local HYST_LOW = 0.96
local HYST_HIGH = 1.04

-- Name labels above the boxes, in the overlay's glyph font (zbc_font_metrics, textures\ui\zbc_font).
-- Shown only while the box itself is: never on a dot.
-- Two lines: the name, and the faction under it in smaller text. Both decode from scrambled characters
-- when the box appears (decode_text).
LABEL_CHARS         = 24     -- longest name drawn
FACTION_CHARS       = 20     -- longest faction drawn
INFO_CHARS          = 24     -- longest info line drawn ("IDENT 45%  142 M", "VETERAN  87 M", "KIA")
DEAD_HOLD           = 5      -- seconds a body keeps its grey KIA box before it fades
DEAD_COL            = { 150, 150, 150 }
local LABEL_VW      = 0.85   -- name height in % of the effective 16:9 width (the overlay is 1.2)
local FACTION_SCALE = 0.72   -- faction line size relative to the name
local LABEL_GAP     = 0.30   -- space between the faction line and the top of the box, in name ems
local LINE_GAP      = 0.12   -- space between the two lines, in name ems
local FACTION_DELAY = 0.10   -- the faction line starts decoding this much after the name

-- MCM list value -> colour; the last entry hides that kind of NPC
local COLORS = {
	{ 255, 255, 255 },  -- 0 white
	{  80, 255,  90 },  -- 1 green
	{  70, 230, 255 },  -- 2 cyan
	{  80, 140, 255 },  -- 3 blue
	{ 255, 225,   0 },  -- 4 yellow
	{ 255,  70,  60 },  -- 5 red
	{ 200,  90, 255 },  -- 6 purple
	false,              -- 7 none
}

local candidates = {}
local next_scan = 0
local states = {}
local last_now = nil

local cand_set = {}
local proc_ids = {}
local draw_list = {}
local scan_ids, scan_d2 = {}, {}
local frame_W = {}
local los_ray = nil
local tmp_top, tmp_pos, tmp_sz
local tmp_cam, tmp_bone, tmp_ray_p, tmp_ray_d

local function clamp01(x) return min(max(x, 0), 1) end
local function lerp(a, b, t) return a + (b - a) * t end

local function has_bit(flags, mask)
	if not flags then return false end
	if bit and bit.band then return bit.band(flags, mask) ~= 0 end
	if bit_and then return bit_and(flags, mask) ~= 0 end
	if flags < 0 then flags = flags + 4294967296 end
	return floor(flags / mask) % 2 == 1
end

local function smoothstep(a, b, x)
	local t = clamp01((x - a) / (b - a))
	return t * t * (3 - 2 * t)
end

local function ease_out3(t)
	local u = 1 - clamp01(t)
	return 1 - u * u * u
end

local function move_toward(cur, target, step)
	if cur < target then return min(cur + step, target) end
	if cur > target then return max(cur - step, target) end
	return target
end

---------------------------------------------------------------------------------------------------
-- Lens model, mirrored from shaders\r3\zbc_lens.h (zbc_warp).
-- L = { k, ox, oy, roll, dist, zoom, shutter }
---------------------------------------------------------------------------------------------------

-- Precompute frame-constant lens parameters for warp/unwarp.
local function fill_warp_frame(W, L, a)
	local k = L.k
	local get_rs = zbc_bodycam and zbc_bodycam.get_rolling_shutter
	local rs = (L.shutter ~= nil) and L.shutter or (get_rs and get_rs() or 0)
	local zoom = max(1 + (L.zoom - 1) * k, 0.25)
	local safe_a = max(a, 0.1)
	local uw = min(1, (16 / 9) / safe_a)
	local ang = L.roll * k
	W.k = k
	W.a = safe_a
	W.inv_a = 1 / safe_a
	W.rsk = rs * k
	W.k1 = L.dist * k
	W.k2 = 0.5 * W.k1 * W.k1
	W.zoom = zoom
	W.inv_zoom = 1 / zoom
	W.uw2 = uw * uw
	W.s = sin(ang)
	W.c = cos(ang)
	W.oxk = L.ox * k
	W.oyk = L.oy * k
	return W
end

-- screen uv -> rendered-image uv using precomputed frame constants W
local function warp_frame(W, u, v)
	local px, py = (u - 0.5) * W.a, v - 0.5
	px = px + W.rsk * py
	local r2_eff = (px * px + py * py) * W.uw2
	local f = (1 + W.k1 * r2_eff + W.k2 * r2_eff * r2_eff) * W.inv_zoom
	px, py = px * f, py * f
	local s, c = W.s, W.c
	px, py = c * px - s * py, s * px + c * py
	return (px + W.oxk) * W.inv_a + 0.5, py + W.oyk + 0.5
end

-- rendered-image uv -> screen uv (where that point is shown): Newton's method with a numerical
-- Jacobian. Tested offline against the warp over the whole screen at the most extreme MCM settings:
-- worst error 0.01 px at 1080p.
local function unwarp(L, a, su, sv, W)
	if L.k <= 0.0005 then return su, sv end
	W = W or fill_warp_frame(frame_W, L, a)
	local zoom = W.zoom
	local u, v = 0.5 + (su - 0.5) * zoom, 0.5 + (sv - 0.5) * zoom
	local h = 0.0005
	for _ = 1, 10 do
		local wu, wv = warp_frame(W, u, v)
		local eu, ev = su - wu, sv - wv
		if abs(eu) + abs(ev) < 0.000005 then break end
		local au, av = warp_frame(W, u + h, v)
		local bu, bv = warp_frame(W, u, v + h)
		local j11, j21 = (au - wu) / h, (av - wv) / h
		local j12, j22 = (bu - wu) / h, (bv - wv) / h
		local det = j11 * j22 - j12 * j21
		if abs(det) < 1e-9 then break end
		u = u + ( j22 * eu - j12 * ev) / det
		v = v + (-j21 * eu + j11 * ev) / det
	end
	return u, v
end

---------------------------------------------------------------------------------------------------
-- Pool
---------------------------------------------------------------------------------------------------

local function hide_line(line)
	if not line or not line.shown then return end
	line.shown = false
	for c = 1, #line.glyphs do line.glyphs[c]:Show(false) end
end

local function hide_label(lbl)
	if not lbl then return end
	hide_line(lbl.name)
	hide_line(lbl.fac)
	hide_line(lbl.info)
end

local function hide(slot)
	slot.box:Show(false)
	slot.brk:Show(false)
	slot.dot:Show(false)
	hide_label(slot.lbl)
end

-- Upper case for the game's Windows-1251 text: ASCII plus the Russian letters (a..ya -> A..YA, yo -> YO),
-- which string.upper leaves alone. Shared with zbc_bodycam.script.
local function upper_byte(c)
	if c >= 97 and c <= 122 then return c - 32 end    -- a..z
	if c >= 224 then return c - 32 end                -- Russian a..ya (224..255) -> A..YA (192..223)
	if c == 184 then return 168 end                   -- yo -> YO
	return c
end

function upper_cp1251(s)
	if type(s) ~= "string" then return "" end
	return (s:gsub("[%a\184\224-\255]", function(ch) return string.char(upper_byte(ch:byte())) end))
end

-- the text as the label shows it: upper case like the overlay, trimmed, cut to n (LABEL_CHARS)
function label_text(name, n)
	if type(name) ~= "string" then return "" end
	name = name:gsub("^%s+", ""):gsub("%s+$", "")
	return upper_cp1251(name):sub(1, n or LABEL_CHARS)
end

-- Decode effect: each letter shows random characters until it locks, one after another from the
-- left. t: decode time (how far identification has got, see reveal_speed); seed: per NPC, so
-- neighbours scramble differently; flicker_t: real time for the scramble, so it keeps flickering
-- while a far NPC's identification is paused. Returns the text and whether it is fully decoded.
-- Spaces stay spaces.
local SCRAMBLE = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789+=/<>#%"
DECODE_DELAY = 0.40          -- seconds of pure scramble before the first letter locks
DECODE_STEP  = 0.08          -- seconds between letters locking (a 10-letter name: about 1.2 s)
DECODE_HZ    = 20            -- scramble changes per second

local decode_buf = {}

-- Order letters lock in when the decode is random (MCM): a fixed shuffle of 1..len per NPC, cached.
-- rank[i] = when letter i locks (0-based).
local order_cache = {}
function lock_ranks(len, seed)
	local key = len * 100000 + (seed or 0) % 100000
	local ranks = order_cache[key]
	if ranks then return ranks end
	local order = {}
	for i = 1, len do order[i] = i end
	local s = (seed or 0) % 2147483646 + 1
	for i = len, 2, -1 do
		s = (s * 48271) % 2147483647
		local j = s % i + 1
		order[i], order[j] = order[j], order[i]
	end
	ranks = {}
	for k = 1, len do ranks[order[k]] = k - 1 end
	if len > 0 then order_cache[key] = ranks end
	return ranks
end

function decode_text(text, t, seed, flicker_t, random_order)
	local len = #text
	if t >= DECODE_DELAY + len * DECODE_STEP then return text, true end
	local step = floor(max(flicker_t or t, 0) * DECODE_HZ)
	local ranks = random_order and lock_ranks(len, seed) or nil
	for i = 1, len do
		local ch = text:sub(i, i)
		local rank = ranks and ranks[i] or (i - 1)
		if ch == " " or t >= DECODE_DELAY + rank * DECODE_STEP then
			decode_buf[i] = ch
		else
			local h = (seed * 7919 + i * 104729 + step * 1299709) % #SCRAMBLE
			decode_buf[i] = SCRAMBLE:sub(h + 1, h + 1)
		end
	end
	return table.concat(decode_buf, "", 1, len), false
end

-- the faction's display name in the game's language (as the news feed shows it), e.g. "CLEAR SKY"
function faction_text(obj)
	local comm = obj and obj.character_community and obj:character_community()
	if type(comm) ~= "string" or comm == "" then return "" end
	local s = game and game.translate_string and game.translate_string(comm)
	if type(s) ~= "string" or s == "" then s = comm end
	return label_text(s, FACTION_CHARS)
end

-- atlas cell of a character, nil for a space or a character the font has no glyph for
local function glyph_cell(code, F)
	if F.index then return F.index(code) end
	if code > 32 and code >= F.first and code <= F.last then return code - F.first end
	return nil
end

local function glyph_code_ok(code, F)
	return glyph_cell(code, F) ~= nil
end

local function reset_state()
	for i = 1, #candidates do candidates[i] = nil end
	next_scan = 0
	states = {}
	last_now = nil
	los_ray = nil
	for k in pairs(cand_set) do cand_set[k] = nil end
	for i = 1, #proc_ids do proc_ids[i] = nil end
	for i = 1, #draw_list do draw_list[i] = nil end
	for i = 1, #scan_ids do
		scan_ids[i] = nil
		scan_d2[i] = nil
	end
end

function build(hud, xml)
	reset_state()
	local pool = {}
	for i = 1, POOL do
		pool[i] = {
			box = xml:InitStatic("zbc_box", hud),
			brk = xml:InitStatic("zbc_brackets", hud),
			dot = xml:InitStatic("zbc_dot", hud),
		}
		if zbc_font_metrics then
			local function new_line(n)
				local glyphs = {}
				for c = 1, n do
					local g = xml:InitStatic("zbc_glyph", hud)
					g:SetStretchTexture(true)
					g:Show(false)
					glyphs[c] = g
				end
				return { glyphs = glyphs, text = nil, shown = true, argb = nil }
			end
			pool[i].lbl = { name = new_line(LABEL_CHARS), fac = new_line(FACTION_CHARS), info = new_line(INFO_CHARS) }
		end
		hide(pool[i])
	end
	pool.edges = {}
	for i = 1, EDGE_MAX do
		local d = xml:InitStatic("zbc_dot", hud)
		d:Show(false)
		pool.edges[i] = d
	end
	return pool
end

local function hide_edges(pool)
	if not (pool and pool.edges) then return end
	for i = 1, #pool.edges do pool.edges[i]:Show(false) end
end

function hide_all(pool)
	if not pool then return end
	for i = 1, #pool do hide(pool[i]) end
	hide_edges(pool)
end

---------------------------------------------------------------------------------------------------
-- Candidates
---------------------------------------------------------------------------------------------------

local scan_enemies = true        -- cfg.allies_enemies, set by update()
local scan_mutants = true        -- cfg.allies_mutants, set by update()
local frame_cols = {}            -- relation -> colour, set by update()
local lens_override = 0          -- cfg.allies_lens: scope lens radius set by hand (0 = measured)
companion_ids = {}               -- companions at any distance (edge markers), set by scan()
met = {}                         -- id -> true for stalkers you have talked to ("known only" names), saved

---------------------------------------------------------------------------------------------------
-- Who a camera can mark, and where the gun points
---------------------------------------------------------------------------------------------------

-- Ghost zombies and poltergeists are never marked, and a bloodsucker only while it is not cloaked.
function markable(obj)
	if not obj then return false end
	local sec = obj.section and obj:section()
	if type(sec) == "string" and (sec == "zombie_ghost" or sec:match("_zombie_ghost$")) then return false end
	if IsStalker(obj) then return true end
	if not (IsMonster and IsMonster(obj)) then return false end
	local c = clsid and obj.clsid and obj:clsid()
	if c then
		if c == clsid.poltergeist_s or c == clsid.poltergeist then return false end
		if (c == clsid.bloodsucker_s or c == clsid.bloodsucker) and obj:alive()
			and obj.get_visibility_state and obj:get_visibility_state() ~= 2 then
			return false
		end
	end
	return true
end

-- The Bodycam exes can decouple the camera from the gun; first_person's "camera_aim" pose is where the
-- gun really points. Unarmed, sprinting, in freelook or while the weapon is busy, the camera centre
-- counts instead. Returns position, direction or nil.
local aim_pose = nil
local function freelook_held()
	local b = key_bindings and key_bindings.kFREELOOK
	if not (b and bind_to_dik and key_state) then return false end
	for i = 0, 1 do
		local k = bind_to_dik(b, i)
		if k and k > 0 and key_state(k) then return true end
	end
	return false
end

local function read_aim_pose(pose) return first_person.get_pose("camera_aim", -1, "", pose) end

local function weapon_aim()
	if not (first_person and first_person.pose and first_person.get_pose) then return nil end
	local actor = db.actor
	local item = actor and actor:active_item()
	if not (item and IsWeapon and IsWeapon(item)) or item:section() == "rw_emptyhands" then return nil end
	if IsMoveState and IsMoveState("mcSprint") then return nil end
	local st = item.get_state and item:get_state()
	if st == 2 or st == 3 then return nil end
	if freelook_held() then return nil end
	aim_pose = aim_pose or first_person.pose()
	local ok, got = pcall(read_aim_pose, aim_pose)
	if not (ok and got and aim_pose.position and aim_pose.forward) then return nil end
	return aim_pose.position, aim_pose.forward
end

-- the first stalker or mutant along the gun's aim, through glass, foliage and other see-through
-- materials (their transparency multiplies up; past a third of the light the trace stops)
local trace_ray, tmp_trace = nil, nil
local function trace_aim(actor, pos, dir)
	if not ray_pick then return nil end
	trace_ray = trace_ray or ray_pick()
	tmp_trace = tmp_trace or vector()
	trace_ray:set_flags(RQ_FLAGS)
	trace_ray:set_ignore_object(actor)
	trace_ray:set_direction(dir)
	tmp_trace:set(pos.x, pos.y, pos.z)
	local left, light = 1000, 1
	for _ = 1, 16 do
		trace_ray:set_position(tmp_trace)
		trace_ray:set_range(left)
		if not trace_ray:query() then return nil end
		local o = trace_ray:get_object()
		if o then return o end
		local res = trace_ray:get_result()
		local d = res and res.range
		local tr = res and res.material_vis_transparency_factor
		if not (d and d >= 0 and d < left and type(tr) == "number") then return nil end
		light = light * tr
		if light <= 0.34 then return nil end
		local step = d + 0.01
		left = left - step
		if left <= 0 then return nil end
		tmp_trace:set(tmp_trace.x + dir.x * step, tmp_trace.y + dir.y * step, tmp_trace.z + dir.z * step)
	end
	return nil
end

local frame_aim_pos, frame_aim_dir = nil, nil   -- the gun's aim this frame (nil: the camera's)

local function scan(actor, range)
	local apos = actor:position()
	local r2 = range * range
	local n = 0
	for id, st in pairs(db.storage) do
		local obj = st and st.object
		local is_mon = obj and IsMonster and IsMonster(obj)
		if obj and id ~= 0 and (IsStalker(obj) or (scan_mutants and is_mon)) and obj:alive() and markable(obj) then
			local d2 = obj:position():distance_to_sqr(apos)
			if d2 <= r2 and (is_mon or scan_enemies or obj:relation(actor) ~= game_object.enemy) then
				if n < POOL or d2 < scan_d2[POOL] then
					local limit = (n < POOL) and (n + 1) or POOL
					local pos = limit
					while pos > 1 and d2 < scan_d2[pos - 1] do
						scan_d2[pos] = scan_d2[pos - 1]
						scan_ids[pos] = scan_ids[pos - 1]
						pos = pos - 1
					end
					scan_d2[pos] = d2
					scan_ids[pos] = id
					if n < POOL then n = n + 1 end
				end
			end
		end
	end
	for i = 1, n do candidates[i] = scan_ids[i] end
	for i = n + 1, #candidates do candidates[i] = nil end
	-- companions at any distance, for the edge markers
	for i = #companion_ids, 1, -1 do companion_ids[i] = nil end
	for id, st in pairs(db.storage) do
		local obj = st and st.object
		if obj and id ~= 0 and IsStalker(obj) and obj:alive() and obj:has_info("npcx_is_companion") then
			companion_ids[#companion_ids + 1] = id
		end
	end
end

---------------------------------------------------------------------------------------------------
-- Companions off screen: a marker at the screen edge, toward where they are
---------------------------------------------------------------------------------------------------

EDGE_MAX = 4                     -- companions shown at once
EDGE_MARGIN = 26                 -- UI units from the screen edge

-- where on the screen border a marker for something at camera-space (x right, y up, f forward)
-- goes, in UI units (1024 x 768). Behind you it slides to the bottom edge.
function edge_ui(x, y, f)
	if f <= 0 then y = min(y, f) end
	local len = sqrt(x * x + y * y)
	if len < 1e-6 then return 512, 768 - EDGE_MARGIN end
	local ex, ey = x / len, -y / len
	local rx, ry = 512 - EDGE_MARGIN, 384 - EDGE_MARGIN
	local s = min(abs(ex) > 1e-6 and rx / abs(ex) or 1e9, abs(ey) > 1e-6 and ry / abs(ey) or 1e9)
	return 512 + ex * s, 384 + ey * s
end

-- Picture-in-picture scopes (3DSS, the engine's second viewport): the lens shows a magnified view
-- while the main camera does not zoom. While it is up, everything is placed (and boxes sized) through
-- the scope's magnification about the view centre, and only what shows inside the lens is marked:
-- the rest of the screen is the scope body and the blurred surroundings.
-- PIP.m: magnification relative to the main view (1 = no scope view), PIP.r: lens radius on screen in
-- screen heights (measured on GAMMA's 3DSS scopes), PIP.a: aspect. Set by pip_refresh().
-- PIP.au / PIP.av: where the gun points on screen (the lens shows what is around that point, magnified,
-- in the middle of the screen; with the camera decoupled from the gun that is not the view centre).
PIP = { m = 1, r = 0.12, a = 16 / 9, t = -1, au = 0.5, av = 0.5 }

function pip_active(P) return (P or PIP).m > 1.01 end

-- screen uv of a point as the scope shows it (magnified about the aim point, placed at the lens
-- centre); the third value says whether it is inside the lens
function pip_map(u, v, P)
	P = P or PIP
	if not u then return nil end
	if P.m <= 1.01 then return u, v, true end
	local mu, mv = 0.5 + (u - (P.au or 0.5)) * P.m, 0.5 + (v - (P.av or 0.5)) * P.m
	local dx, dy = (mu - 0.5) * P.a, mv - 0.5
	return mu, mv, dx * dx + dy * dy <= P.r * P.r
end

-- a box (centre and size, UI units 1024 x 768) as the lens shows it: nil when its centre is outside
-- the lens, otherwise clipped to the lens so it never spills over the scope body
function pip_clip_box(cx, cy, w, h, P)
	P = P or PIP
	if P.m <= 1.01 then return cx, cy, w, h end
	local ry = P.r * 768
	local rx = P.r / P.a * 1024
	local dx, dy = (cx - 512) / rx, (cy - 384) / ry
	if dx * dx + dy * dy > 1 then return nil end
	local x0, x1 = max(cx - w * 0.5, 512 - rx), min(cx + w * 0.5, 512 + rx)
	local y0, y1 = max(cy - h * 0.5, 384 - ry), min(cy + h * 0.5, 384 + ry)
	if x1 - x0 < 2 or y1 - y0 < 2 then return nil end
	return (x0 + x1) * 0.5, (y0 + y1) * 0.5, x1 - x0, y1 - y0
end

local function project(vec)
	if not vec then return nil end
	local p = game.world2ui(vec, false)
	if not p or p.x == -9999 then return nil end
	return pip_map(p.x / 1024, p.y / 768)
end

local function project_dot(obj, L, a, W)
	local su, sv = project(utils_obj.safe_bone_pos(obj, "bip01_spine"))
	if not su then return nil end
	local u, v = unwarp(L, a, su, sv, W)
	if u > 0 and u < 1 and v > 0 and v < 1 then
		if pip_active() and not pip_clip_box(u * 1024, v * 768, 4, 4) then return nil end
		return u * 1024, v * 768
	end
	return nil
end

-- Mutants: the class names Anomaly uses for them (dynamic_news_helper.GetMonsterDescription), each
-- with a display name st_zbc_mutant_<kind> in configs\text\<language>\ui_st_zbc_bodycam.xml
MUTANT_KINDS = {
	"bloodsucker", "boar", "burer", "cat", "chimera", "controller", "dog", "flesh", "fracture", "gigant",
	"poltergeist", "pseudodog", "psy_dog_phantom", "psy_dog", "rat", "snork", "tushkano", "zombie",
	"karlik", "psysucker", "lurker",
}
local QUADRUPED = { boar = true, cat = true, chimera = true, dog = true, flesh = true, pseudodog = true,
	psy_dog = true, psy_dog_phantom = true, rat = true, tushkano = true, lurker = true }

local function mutant_kind(obj)
	local h = dynamic_news_helper and dynamic_news_helper.GetMonsterDescription
	if not h then return nil end
	local ok, kind = pcall(h, obj)
	return ok and type(kind) == "string" and kind or nil
end

-- box width / height: stalkers stand upright, four-legged mutants are long and low
function box_aspect(obj, kind)
	if IsStalker and IsStalker(obj) then return 0.42 end
	kind = kind or mutant_kind(obj)
	return QUADRUPED[kind] and 1.3 or 0.5
end

-- label lines: a stalker's name and faction; a mutant's species and "MUTANT"
local function npc_name(obj)
	if IsStalker(obj) then return label_text(obj:character_name()) end
	local kind = mutant_kind(obj)
	local key = kind and ("st_zbc_mutant_" .. kind)
	local s = key and game.translate_string(key)
	if not s or s == key then s = kind or "" end            -- no string: the class name itself
	return label_text((s:gsub("_", " ")))
end

-- a stalker's rank as the game names it ("st_rank_veteran"), as Identification UI shows it; none for mutants
local function read_rank(obj) return ranks.get_obj_rank_name(obj) end
local function npc_rank(obj)
	if not (IsStalker(obj) and ranks and ranks.get_obj_rank_name) then return "" end
	local ok, r = pcall(read_rank, obj)
	if not (ok and type(r) == "string" and r ~= "") then return "" end
	return label_text(game.translate_string("st_rank_" .. r), INFO_CHARS)
end

local function npc_faction(obj)
	if IsStalker(obj) then return faction_text(obj) end
	return label_text(game.translate_string("st_zbc_mutant"), FACTION_CHARS)
end

function box_top_y(head_y, feet_y, is_quad)
	local min_h = is_quad and 0.15 or 0.5
	local top_pad = is_quad and 0.12 or 0.22
	return max(head_y, feet_y + min_h) + top_pad
end

-- The box from the object's own bounding box: all eight corners through the camera (and a scope), so
-- it fits a crouching, prone or four-legged body. nil when the exes have no bounding_box / xform, or a
-- corner is behind the camera; the caller then falls back to the head and feet.
local tmp_corner = nil
local function read_bbox(obj) return obj:bounding_box(false), obj:xform(false) end
local function bbox_screen(obj, L, a, W)
	if not (obj.bounding_box and obj.xform) then return nil end
	local ok, box, xf = pcall(read_bbox, obj)
	if not (ok and box and xf and box.min and box.max and xf.transform_tiny) then return nil end
	tmp_corner = tmp_corner or vector()
	local u0, v0, u1, v1 = 1e9, 1e9, -1e9, -1e9
	for i = 0, 7 do
		tmp_corner:set((i % 2 == 0) and box.min.x or box.max.x,
			(floor(i / 2) % 2 == 0) and box.min.y or box.max.y,
			(floor(i / 4) == 0) and box.min.z or box.max.z)
		xf:transform_tiny(tmp_corner)
		local su, sv = project(tmp_corner)
		if not su then return nil end
		local u, v = unwarp(L, a, su, sv, W)
		u0, v0, u1, v1 = min(u0, u), min(v0, v), max(u1, u), max(v1, v)
	end
	return u0, v0, u1, v1
end

-- The box from the skeleton: head, neck, pelvis, elbows, hands, knees and feet through the camera (and a
-- scope), plus the top of the head and the ground, so it hugs the pose the body is in right now. (The
-- engine's bounding box covers every pose the model can take, which made boxes far too big.) Bones a
-- model does not have are skipped; with fewer than BONE_MIN found the caller falls back.
BOX_BONES = { "bip01_head", "bip01_neck", "bip01_pelvis", "bip01_l_forearm", "bip01_r_forearm",
	"bip01_l_hand", "bip01_r_hand", "bip01_l_calf", "bip01_r_calf", "bip01_l_foot", "bip01_r_foot" }
BONE_MIN = 5
BONE_PAD_W = 0.06            -- body width beyond the outermost joints (elbows, hands), as a share of the
                             -- joints' height on screen, each side: about 10 cm on a standing stalker
BONE_PAD_H = 0.02            -- above the top of the head / below the ground, each
HEAD_TOP = 0.14              -- metres from the head bone to the top of the head
local bone_cache = {}        -- id -> bone names this model has
local bone_cache_n = 0
local tmp_bone_pt = nil

local function read_bone_id(obj, name) return obj:get_bone_id(name) end
local function model_bones(obj)
	local id = obj:id()
	local list = bone_cache[id]
	if list then return list end
	bone_cache_n = (bone_cache_n or 0) + 1
	if bone_cache_n > 512 then                         -- ids get reused by new spawns: start over now and then
		bone_cache, bone_cache_n = {}, 1
	end
	list = {}
	for i = 1, #BOX_BONES do
		local ok, b = pcall(read_bone_id, obj, BOX_BONES[i])
		if ok and b and b ~= 65535 then list[#list + 1] = BOX_BONES[i] end
	end
	bone_cache[id] = list
	return list
end

-- bounds of points in screen uv, then padded for the body around the joints: u0, v0, u1, v1
function pad_joint_bounds(u0, v0, u1, v1, a)
	local h = v1 - v0
	local pw = h * BONE_PAD_W / max(a or 1, 0.1)
	local ph = h * BONE_PAD_H
	return u0 - pw, v0 - ph, u1 + pw, v1 + ph
end

local function read_bone_pos(obj, name) return obj:bone_position(name) end
local function bone_screen(obj, L, a, W)
	if not obj.bone_position then return nil end
	local bones = model_bones(obj)
	if #bones < BONE_MIN then return nil end
	tmp_bone_pt = tmp_bone_pt or vector()
	-- the extreme points (leftmost, topmost, rightmost, lowest), each kept whole so it can go through
	-- the lens warp on its own: the warp bends a rectangle's corners differently from the body's edges
	local lu, lv, tu, tv, ru, rv, bu, bv = 1e9, 0, 0, 1e9, -1e9, 0, 0, -1e9
	local n = 0
	local function add(p)
		local u, v = project(p)
		if u then
			if u < lu then lu, lv = u, v end
			if u > ru then ru, rv = u, v end
			if v < tv then tu, tv = u, v end
			if v > bv then bu, bv = u, v end
			n = n + 1
		end
	end
	for i = 1, #bones do
		local ok, p = pcall(read_bone_pos, obj, bones[i])
		if ok and p then
			add(p)
			if bones[i] == "bip01_head" then
				tmp_bone_pt:set(p.x, p.y + HEAD_TOP, p.z)
				add(tmp_bone_pt)
			end
		end
	end
	add(obj:position())                                     -- the ground under the feet
	if n < BONE_MIN then return nil end
	-- each extreme point through the lens warp, then the room for the body around the joints on screen
	local u0 = unwarp(L, a, lu, lv, W)
	local u1 = unwarp(L, a, ru, rv, W)
	local _, v0 = unwarp(L, a, tu, tv, W)
	local _, v1 = unwarp(L, a, bu, bv, W)
	return pad_joint_bounds(u0, v0, u1, v1, a)
end

local function project_box(obj, L, a, ux, uy, size, W, aspect, is_quad)
	-- the skeleton when the model has one; otherwise the head and feet below (the engine's bounding
	-- box, bbox_screen, covers every pose the model can take and is far too big for a box)
	local bu0, bv0, bu1, bv1 = bone_screen(obj, L, a, W)
	if bu0 then
		local w_ui = (bu1 - bu0) * 1024 * size
		local h_ui = (bv1 - bv0) * 768 * size
		if h_ui <= 2 or w_ui <= 1 then return nil end
		local cx, cy = (bu0 + bu1) * 0.5 * 1024, (bv0 + bv1) * 0.5 * 768
		if cx + w_ui * 0.5 <= 0 or cx - w_ui * 0.5 >= 1024 or cy + h_ui * 0.5 <= 0 or cy - h_ui * 0.5 >= 768 then
			return nil
		end
		return pip_clip_box(cx, cy, w_ui, h_ui)
	end
	local feet = obj:position()
	local head = utils_obj.safe_bone_pos(obj, "bip01_head") or feet
	tmp_top:set(head.x, box_top_y(head.y, feet.y, is_quad), head.z)
	local tu, tv = project(tmp_top)
	local fu, fv = project(feet)
	if not (tu and fu) then return nil end
	tu, tv = unwarp(L, a, tu, tv, W)
	fu, fv = unwarp(L, a, fu, fv, W)
	local h_ui = abs(fv - tv) * 768
	if h_ui <= 2 then return nil end
	h_ui = h_ui * size
	local asp = aspect or box_aspect(obj)
	local w_ui = (h_ui / uy) * asp * ux
	local cx = (tu + fu) * 0.5 * 1024
	local cy = (tv + fv) * 0.5 * 768
	if cx + w_ui * 0.5 <= 0 or cx - w_ui * 0.5 >= 1024 or cy + h_ui * 0.5 <= 0 or cy - h_ui * 0.5 >= 768 then
		return nil
	end
	-- through a picture-in-picture scope: only inside the lens, clipped to it
	return pip_clip_box(cx, cy, w_ui, h_ui)
end

---------------------------------------------------------------------------------------------------
-- Animation & Slot Rendering
---------------------------------------------------------------------------------------------------

local function ensure_entity_shape(ent, obj)
	if ent.aspect ~= nil then return end
	local kind = (not IsStalker(obj)) and mutant_kind(obj) or nil
	ent.aspect = box_aspect(obj, kind)
	ent.quad = kind and QUADRUPED[kind] or false
end

local function refresh_projections(ent, obj, L, a, ux, uy, size, dot_w, dot_h, W)
	local bcx, dcx
	if ent.target_dot == 0 or ent.dot_t < 0.99 then
		ensure_entity_shape(ent, obj)
		local bcy, bw, bh
		bcx, bcy, bw, bh = project_box(obj, L, a, ux, uy, size, W, ent.aspect, ent.quad)
		if bcx then
			ent.bcx, ent.bcy, ent.bw, ent.bh = bcx, bcy, bw, bh
		end
	end
	if ent.target_dot == 1 or ent.dot_t > 0.01 then
		local dcy
		dcx, dcy = project_dot(obj, L, a, W)
		if dcx then
			ent.dcx, ent.dcy = dcx, dcy
		end
	end
	ent.dw, ent.dh = dot_w, dot_h
	return (bcx ~= nil) or (dcx ~= nil)
end

local function ray_to_point(actor, obj_id, cam_vec, tx, ty, tz)
	local dx = tx - cam_vec.x
	local dy = ty - cam_vec.y
	local dz = tz - cam_vec.z
	local d = sqrt(dx * dx + dy * dy + dz * dz)
	if d <= 0.25 then return true end
	local inv = 1 / d
	tmp_ray_d:set(dx * inv, dy * inv, dz * inv)
	tmp_ray_p:set(cam_vec.x, cam_vec.y, cam_vec.z)
	local rem = d - 0.15

	los_ray = los_ray or ray_pick()
	if not los_ray then return false end
	los_ray:set_flags(RQ_FLAGS)
	los_ray:set_ignore_object(actor)

	for step = 0, LOS_MAX_STEPS do
		if rem <= 0.05 then return true end
		los_ray:set_position(tmp_ray_p)
		los_ray:set_direction(tmp_ray_d)
		los_ray:set_range(rem)
		if not los_ray:query() then return true end

		local hit_obj = los_ray:get_object()
		if hit_obj and hit_obj:id() == obj_id then return true end

		local rq = los_ray:get_result()
		local hit_dist = (rq and rq.range) or (los_ray.get_distance and los_ray:get_distance())
		if not hit_dist or hit_dist < 0 then return false end
		if hit_dist >= rem then return true end

		local flags = rq and rq.material_flags
		if not flags then return false end
		local vis_tr = rq.material_vis_transparency_factor or 0
		-- Bit 30 is set on opaque solids (concrete/bricks/metal/wood/earth) and clear on glass/bushes/mesh.
		local pass = (not has_bit(flags, FL_VISION_OPAQUE))
			and (has_bit(flags, FL_PASSABLE) or vis_tr >= 0.5)
		if not pass or step == LOS_MAX_STEPS then return false end

		local advance = hit_dist + 0.05
		tmp_ray_p:set(
			tmp_ray_p.x + tmp_ray_d.x * advance,
			tmp_ray_p.y + tmp_ray_d.y * advance,
			tmp_ray_p.z + tmp_ray_d.z * advance
		)
		rem = rem - advance
	end
	return false
end

-- Line of sight from the camera to one point, by the same rules as the markers (glass, bushes and
-- mesh let it through). Used by zbc_faces.script.
function los_point(actor, obj_id, cam_vec, x, y, z)
	if not (ray_pick and cam_vec) then return true end
	tmp_ray_p = tmp_ray_p or vector()
	tmp_ray_d = tmp_ray_d or vector()
	return ray_to_point(actor, obj_id, cam_vec, x, y, z)
end

local function has_los(actor, obj, obj_id, check_los, cam_vec)
	if not check_los then return true end
	if not (ray_pick and cam_vec) then
		return actor:see(obj)
	end
	los_ray = los_ray or ray_pick()
	if not los_ray then
		return actor:see(obj)
	end
	local safe_bone = utils_obj and utils_obj.safe_bone_pos
	local pos = obj:position()

	local head = safe_bone and safe_bone(obj, "bip01_head")
	if head then
		if ray_to_point(actor, obj_id, cam_vec, head.x, head.y, head.z) then return true end
	else
		tmp_bone:set(pos.x, pos.y + 1.5, pos.z)
		if ray_to_point(actor, obj_id, cam_vec, tmp_bone.x, tmp_bone.y, tmp_bone.z) then return true end
	end

	local spine = safe_bone and safe_bone(obj, "bip01_spine")
	if spine then
		if ray_to_point(actor, obj_id, cam_vec, spine.x, spine.y, spine.z) then return true end
	else
		tmp_bone:set(pos.x, pos.y + 1.0, pos.z)
		if ray_to_point(actor, obj_id, cam_vec, tmp_bone.x, tmp_bone.y, tmp_bone.z) then return true end
	end
	return false
end

local frame_dir = nil        -- camera direction this frame, set by update()
local aim_target = nil       -- id of the stalker or mutant you are aiming at (any distance, like the
                             -- Identification UI mod's crosshair target), kept while you stay on them
local ID_LENIENCE_COS = 0.984   -- = ID_LENIENCE (defined with the identification below)

-- are you looking at this stalker (their upper body within ID_LENIENCE of where the gun points, or of
-- the view centre when the camera counts)?
local function aimed_at(obj, cam_vec)
	local dir = frame_aim_dir or frame_dir
	local from = frame_aim_pos or cam_vec
	if not (dir and from) then return true end
	local p = obj:position()
	local dx, dy, dz = p.x - from.x, p.y + 1.3 - from.y, p.z - from.z
	local l = sqrt(dx * dx + dy * dy + dz * dz)
	if l < 0.01 then return true end
	return (dx * dir.x + dy * dir.y + dz * dir.z) / l >= (ID_LENIENCE or ID_LENIENCE_COS)
end

local function step_entity(
	id, actor, apos, cam_vec, now, range, dot_dist, in_cand,
	cfg, L, a, ux, uy, dot_w, dot_h, cols, dt, W
)
	local ent = states[id]
	local obj = level.object_by_id(id)
	local is_mon = obj and IsMonster and IsMonster(obj)
	local rel = obj and obj.relation and obj:relation(actor) or nil
	if not obj or (is_mon and not cfg.allies_mutants) or (not is_mon and rel == game_object.enemy and not cfg.allies_enemies)
		or (obj:alive() and not markable(obj)) then                -- a bloodsucker that just cloaked, say
		states[id] = nil
		return false
	end

	-- the colour the box decodes to. White only means "not identified yet" (see draw_slot): once
	-- decoded, everyone is either friendly (neutrals included) or an enemy
	local col
	local companion = IsStalker(obj) and obj:has_info("npcx_is_companion")
	if ent then
		ent.companion = companion
		ent.health = companion and tonumber(obj.health) or nil
		ent.mutant = is_mon and true or false
		ent.hostile = (is_mon or rel == game_object.enemy) and true or false
	end
	if companion then
		col = cols.companion
	elseif rel == game_object.enemy or (is_mon and rel == nil) then
		col = is_mon and (cols.enemy or COLORS[6]) or cols.enemy
	else
		col = is_mon and (cols.friend or COLORS[2]) or cols.friend
	end
	if not col then
		states[id] = nil
		return false
	end

	if not obj:alive() then
		if not ent then return false end
		-- killed while marked: a grey KIA box for DEAD_HOLD seconds, then it fades
		if not ent.dead_t then
			ent.dead_t = now
			ent.target_vis = (ent.vis > 0.05) and 1 or 0
		end
		if now - ent.dead_t >= DEAD_HOLD then ent.target_vis = 0 end
		ent.los_grace = 0
		ent.col = col
		ent.dist = obj:position():distance_to(apos)
		refresh_projections(ent, obj, L, a, ux, uy, cfg.allies_size, dot_w, dot_h, W)
		if ent.target_vis == 1 then return ent.bcx ~= nil or ent.dcx ~= nil end
		ent.vis = move_toward(ent.vis, 0, DEAD_OUT_RATE * dt)
		ent.dot_t = move_toward(ent.dot_t, ent.target_dot, MORPH_RATE * dt)
		if ent.vis <= 0 then
			states[id] = nil
			return false
		end
		return ent.bcx ~= nil or ent.dcx ~= nil
	end

	local dist = obj:position():distance_to(apos)
	-- the one you are aiming at gets a full box at any distance (through a scope, say)
	local is_target = (id == aim_target)
	local in_range = in_cand and (dist <= range or is_target)
	local function alpha_at(d)
		if is_target then return cfg.allies_opacity end
		return cfg.allies_opacity * (1 - smoothstep(range * 0.85, range, d))
	end

	if not ent then
		if not in_range then return false end
		local init_dot = (dist > dot_dist and not is_target) and 1 or 0
		local kind = (not IsStalker(obj)) and mutant_kind(obj) or nil
		local asp = box_aspect(obj, kind)
		local is_quad = kind and QUADRUPED[kind] or false
		local bcx, bcy, bw, bh, dcx, dcy
		if init_dot == 1 then
			dcx, dcy = project_dot(obj, L, a, W)
		else
			bcx, bcy, bw, bh = project_box(obj, L, a, ux, uy, cfg.allies_size, W, asp, is_quad)
		end
		if not (bcx or dcx) then return false end
		if not has_los(actor, obj, id, cfg.allies_los, cam_vec) then return false end
		ent = {
			vis = move_toward(0, 1, POP_IN_RATE * dt),
			target_vis = 1,
			los_grace = LOS_GRACE,
			los_ok = true,
			next_los = now + LOS_INTERVAL + (id % 4) * (LOS_INTERVAL * 0.25),
			dot_t = init_dot,
			target_dot = init_dot,
			col = col,
			aspect = asp,
			quad = is_quad,
			name = npc_name(obj),
			faction = npc_faction(obj),
			seed = id % 9973,
			id = id,
			dist = dist,
			aimed = aimed_at(obj, cam_vec),
			base_alpha = alpha_at(dist),
			bcx = bcx, bcy = bcy, bw = bw, bh = bh,
			dcx = dcx, dcy = dcy, dw = dot_w, dh = dot_h,
		}
		states[id] = ent
		return ent.vis > 0
	end

	ent.col = col
	if not ent.name then ent.name = npc_name(obj) end
	if not ent.faction then ent.faction = npc_faction(obj) end
	if not ent.seed then ent.seed = id % 9973 end
	if not ent.rank then ent.rank = npc_rank(obj) end
	ent.is_target = is_target
	ent.id = id
	ent.dist = dist
	ent.aimed = aimed_at(obj, cam_vec)
	if dist <= range or is_target then
		ent.base_alpha = alpha_at(dist)
	end

	if is_target then
		ent.target_dot = 0
	elseif in_range then
		if ent.target_dot == 0 then
			if dist > dot_dist * HYST_HIGH then ent.target_dot = 1 end
		else
			if dist < dot_dist * HYST_LOW then ent.target_dot = 0 end
		end
	end

	local live_ok = refresh_projections(ent, obj, L, a, ux, uy, cfg.allies_size, dot_w, dot_h, W)

	if not in_range or not live_ok then
		ent.los_grace = 0
		ent.target_vis = 0
	else
		local seen
		if not cfg.allies_los then
			seen = true
			ent.los_ok = true
			ent.next_los = now
		else
			if not ent.next_los or now >= ent.next_los then
				ent.los_ok = has_los(actor, obj, id, true, cam_vec)
				ent.next_los = now + LOS_INTERVAL
			end
			seen = ent.los_ok
		end
		if seen then
			ent.los_grace = LOS_GRACE
			ent.target_vis = 1
		else
			ent.los_grace = max(ent.los_grace - dt, 0)
			ent.target_vis = (ent.los_grace > 0) and 1 or 0
		end
	end

	local vis_rate = (ent.target_vis == 1) and POP_IN_RATE or POP_OUT_RATE
	ent.vis = move_toward(ent.vis, ent.target_vis, vis_rate * dt)
	ent.dot_t = move_toward(ent.dot_t, ent.target_dot, MORPH_RATE * dt)

	if ent.target_vis == 0 and ent.vis <= 0 then
		states[id] = nil
		return false
	end
	return (ent.vis > 0) and (ent.bcx ~= nil or ent.dcx ~= nil)
end

-- Prioritize active targets first, then highest-vis fading-out targets.
local function cmp_draw(a, b)
	local sa, sb = states[a], states[b]
	if sa.target_vis ~= sb.target_vis then return sa.target_vis > sb.target_vis end
	if sa.vis ~= sb.vis then return sa.vis > sb.vis end
	return a < b
end

local function apply_wnd(wnd, cx, cy, w, h, argb)
	wnd:SetWndPos(tmp_pos:set(cx - w * 0.5, cy - h * 0.5))
	wnd:SetWndSize(tmp_sz:set(w, h))
	wnd:SetTextureColor(argb)
	wnd:Show(true)
end

-- frame constants for the labels (UI units), filled in update()
local LG = {}

-- one line of glyphs centred on cx with its text top at y (UI units); M: that line's metrics
local function draw_line(line, text, cx, y, argb, M)
	local F = zbc_font_metrics
	local count = #line.glyphs
	local n = min(#text, count)
	if n == 0 then return hide_line(line) end

	local relay = line.text ~= text
	if relay then
		line.text = text
		for c = 1, n do
			local k = glyph_cell(string.byte(text, c), F)
			if k then
				local tx, ty = (k % F.cols) * F.cell_w, floor(k / F.cols) * F.cell_h
				line.glyphs[c]:SetTextureRect(LG.rect:set(tx, ty, tx + F.cell_w, ty + F.cell_h))
			end
		end
	end
	if relay or line.argb ~= argb then
		line.argb = argb
		for c = 1, n do line.glyphs[c]:SetTextureColor(argb) end
	end

	local total_w = n * M.adv
	local x0 = min(max(cx - total_w * 0.5, 0), max(1024 - total_w, 0)) - M.pad_x
	local y0 = min(max(y, 0), max(768 - M.line_h, 0)) - M.pad_y
	local was_shown = line.shown
	for c = 1, count do
		local gl = line.glyphs[c]
		if c <= n and glyph_code_ok(string.byte(text, c), F) then
			gl:SetWndPos(LG.pos:set(x0 + (c - 1) * M.adv, y0))
			if relay or not was_shown then
				gl:SetWndSize(LG.size:set(M.qw, M.qh))
				gl:Show(true)
			end
		elseif relay or not was_shown then
			gl:Show(false)
		end
	end
	line.shown = true
end

---------------------------------------------------------------------------------------------------
-- Labels: name, faction and an info line (identification progress, then rank and distance, or KIA),
-- laid out together once a frame so they stay on screen and never overlap each other
---------------------------------------------------------------------------------------------------

LABEL_MARGIN = 4             -- UI units kept clear of the screen edges
STACK_PAD    = 2             -- UI units between stacked labels
local label_queue, label_n = {}, 0

local STR = nil              -- translated words for the info line, read once
local function words()
	if not STR then
		local function tr(id, def)
			local s = game and game.translate_string and game.translate_string(id)
			if type(s) ~= "string" or s == "" or s == id then s = def end
			return label_text(s, INFO_CHARS)
		end
		STR = { kia = tr("st_zbc_kia", "KIA"), ident = tr("st_zbc_ident", "IDENT"), m = tr("st_zbc_m", "M"),
			unknown = label_text((function()
				local s = game and game.translate_string and game.translate_string("st_zbc_unknown")
				return (type(s) == "string" and s ~= "" and s ~= "st_zbc_unknown") and s or "Unknown"
			end)(), LABEL_CHARS) }
	end
	return STR
end

-- the info line: identification progress while unknown, rank and distance once known, KIA when dead
function info_text(dead, is_known, pct, rank, dist, W)
	W = W or { kia = "KIA", ident = "IDENT", m = "M" }
	if dead then return W.kia end
	local d = dist and (tostring(floor(dist + 0.5)) .. " " .. W.m) or ""
	if not is_known then
		return W.ident .. " " .. floor(clamp01(pct or 0) * 100) .. "%" .. ((d ~= "") and ("  " .. d) or "")
	end
	if rank and rank ~= "" then return rank .. ((d ~= "") and ("  " .. d) or "") end
	return d
end

-- Places label blocks (w, h centred on cx) above their boxes, below them when there is no room above
-- (someone close whose head is off the top of the screen), inside the screen edges, and stacked so they
-- never overlap: the aimed-at target first, then nearest first. Each q gets q.x (centre) and q.y (top).
-- Pure, so it is tested on its own.
function layout_labels(list, n, gap, scr_w, scr_h)
	scr_w, scr_h = scr_w or 1024, scr_h or 768
	for i = 2, n do                                        -- insertion sort by priority (n <= 20)
		local q = list[i]
		local j = i - 1
		while j >= 1 and list[j].prio > q.prio do
			list[j + 1] = list[j]
			j = j - 1
		end
		list[j + 1] = q
	end
	local placed = {}
	for i = 1, n do
		local q = list[i]
		local y = q.top - gap - q.h
		if y < LABEL_MARGIN then
			local below = q.bottom + gap
			y = (below + q.h <= scr_h - LABEL_MARGIN) and below or LABEL_MARGIN
		end
		local half = q.w * 0.5
		local x = min(max(q.cx, LABEL_MARGIN + half), scr_w - LABEL_MARGIN - half)
		for _ = 1, 8 do
			local hit = nil
			for k = 1, #placed do
				local p = placed[k]
				if abs(x - p.x) < (q.w + p.w) * 0.5 + STACK_PAD
					and y < p.y + p.h + STACK_PAD and y + q.h + STACK_PAD > p.y then
					hit = p
					break
				end
			end
			if not hit then break end
			local up = hit.y - STACK_PAD - q.h
			y = (up >= LABEL_MARGIN) and up or (hit.y + hit.h + STACK_PAD)
		end
		q.x, q.y = x, min(max(y, LABEL_MARGIN), scr_h - LABEL_MARGIN - q.h)
		placed[#placed + 1] = q
	end
end

-- queues a label for a box whose top and bottom edges are at top / bottom (UI units), in the box colour
local function queue_label(slot, ent, cx, top, bottom, alpha, r, g, b)
	local lbl = slot.lbl
	if not (lbl and zbc_font_metrics and LG.on) then return hide_label(lbl) end
	local a = floor(255 * clamp01(alpha))
	if a <= 0 then return hide_label(lbl) end
	local t = ent.reveal_t or 0
	local seed = ent.seed or 0
	label_n = label_n + 1
	local q = label_queue[label_n]
	if not q then
		q = {}
		label_queue[label_n] = q
	end
	q.slot = slot
	-- "known only" (MCM): a stalker's name shows only once you have talked to them; until then UNKNOWN
	local name = ent.name or ""
	if LG.known_only and not ent.mutant and not (ent.id and met[ent.id]) then name = words().unknown end
	q.name = (decode_text(name, t, seed, LG.now, LG.random))
	q.fac = (decode_text(ent.faction or "", t - FACTION_DELAY, seed + 17, LG.now, LG.random))
	q.info = lbl.info and ent.info or ""                -- a slot without an info line just has two
	q.argb = GetARGB(a, r, g, b)
	q.cx, q.top, q.bottom = cx, top, bottom
	q.prio = ent.is_target and -1 or (ent.dist or 0)
	q.w = max(#q.name * LG.n.adv, #q.fac * LG.f.adv, #q.info * LG.f.adv)
	q.h = LG.n.line_h + LG.line_gap + LG.f.line_h + ((#q.info > 0) and (LG.line_gap + LG.f.line_h) or 0)
end

-- lays out and draws every label queued this frame
local function flush_labels()
	layout_labels(label_queue, label_n, LG.gap or 0)
	for i = 1, label_n do
		local q = label_queue[i]
		local lbl = q.slot.lbl
		local fac_y = q.y + LG.n.line_h + LG.line_gap
		draw_line(lbl.name, q.name, q.x, q.y, q.argb, LG.n)
		draw_line(lbl.fac, q.fac, q.x, fac_y, q.argb, LG.f)
		if #q.info > 0 then
			draw_line(lbl.info, q.info, q.x, fac_y + LG.f.line_h + LG.line_gap, q.argb, LG.f)
		else
			hide_line(lbl.info)
		end
		q.slot = nil
	end
	label_n = 0
end

-- Box colour while it "identifies" the NPC: white until the name has decoded, then it fades to the
-- relation colour. t: seconds since the box appeared; name_len: letters in the name.
REVEAL_MIN  = 1.0            -- seconds before the colour starts to change, at the least
COLOR_FADE  = 0.35           -- seconds the change from white takes
function reveal_mix(t, name_len)
	local start = max(REVEAL_MIN, DECODE_DELAY + (name_len or 0) * DECODE_STEP)
	return smoothstep(start, start + COLOR_FADE, t or 0)
end

-- Identification by distance, after the Identification UI mod (factionID_hud_mcm): within
-- ID_INSTANT metres a stalker is identified as soon as the box appears. Further out the name, faction
-- and colour stay unknown (white, scrambled) and only decode while you look at them, at that mod's
-- rate: slower with distance, faster through a scope (smaller field of view). Once identified, a
-- stalker stays identified for the session; their box just replays the quick decode.
ID_INSTANT  = 50             -- metres
ID_LENIENCE = 0.984          -- cos of the largest angle from the view centre that counts as looking at them
ID_SPEED    = 0.5            -- the mod's speed as GAMMA sets it (targetID/speedID = 0.5)
local known = {}             -- id -> true once identified
local known_order = {}       -- ids, oldest first (the save keeps the last KNOWN_LIMIT)
local id_progress = {}       -- id -> 0..1, how far a not yet identified stalker has got
KNOWN_LIMIT = 256

local function remember_known(id)
	if known[id] then
		for i = 1, #known_order do
			if known_order[i] == id then table.remove(known_order, i) break end
		end
	end
	known[id] = true
	known_order[#known_order + 1] = id
	while #known_order > KNOWN_LIMIT do
		known[table.remove(known_order, 1)] = nil
	end
end

function clear_known()
	known, known_order = {}, {}
	id_progress = {}
	reset_state()
end

-- Identified people are kept in the save (m_data.zbc_known: ids, oldest first), so they stay
-- identified after loading. A game started or loaded without that data starts with nobody known.
local pending_clear = true
function save_state(m_data)
	local list = {}
	for i = 1, #known_order do list[i] = known_order[i] end
	m_data.zbc_known = list
	local met_list = {}
	for id in pairs(met) do met_list[#met_list + 1] = id end
	m_data.zbc_met = met_list
end

function load_state(m_data)
	known, known_order, id_progress = {}, {}, {}
	met = {}
	local ml = m_data and m_data.zbc_met
	if type(ml) == "table" then
		for _, id in ipairs(ml) do
			if type(id) == "number" and id >= 0 and id < 65535 then met[id] = true end
		end
	end
	local list = m_data and m_data.zbc_known
	if type(list) == "table" then
		for i = max(1, #list - KNOWN_LIMIT + 1), #list do
			local id = list[i]
			if type(id) == "number" and id >= 0 and id < 65535 then remember_known(id) end
		end
	end
	pending_clear = false
	reset_state()
end

local function on_first_update()
	if pending_clear then clear_known() else reset_state() end
	id_progress = {}
	pending_clear = true
end

-- hostiles (enemies and mutants) marked on the camera right now, alive (zbc_eventlog: CONTACT n)
function hostile_count()
	local n = 0
	for _, ent in pairs(states) do
		if ent.hostile and not ent.dead_t and (ent.vis or 0) > 0.5 then n = n + 1 end
	end
	return n
end

-- talking to someone tells you their name ("known only" option)
function on_gui_show(name)
	if name ~= "Dialog" then return end
	local npc = mob_trade and mob_trade.GetTalkingNpc and mob_trade.GetTalkingNpc()
	if npc and npc.id then met[npc:id()] = true end
end

local function on_net_destroy()
	reset_state()
	pending_clear = true
end

function is_known_id(id)
	return id ~= nil and known[id] == true
end

function id_progress_for(id)
	return id ~= nil and id_progress[id] or nil
end

-- share of a full identification gained per second at dist metres and fov degrees: the mod adds
-- 100 / ((d^2 - 2500) * 0.1) / fov * 20 * speed every 0.2 s
-- Nobody is identified instantly: it always takes at least ID_MIN_TIME seconds of looking at them,
-- also inside the mod's 50 m instant zone; further out the mod's rate takes over once it is slower.
ID_MIN_TIME = 2.0
function identify_rate(dist, fov)
	local cap = 1 / ID_MIN_TIME
	if dist <= ID_INSTANT then return cap end
	fov = max(fov or 75, 1)
	return min(cap, 5 * 20 * ID_SPEED * 100 / ((dist * dist - ID_INSTANT * ID_INSTANT) * 0.1 * fov))
end

-- how fast the decode time runs (1 = the quick decode of someone already identified, 0 = paused)
-- t_full: decode time until the name is fully readable. Unknown stalkers only decode while you look
-- at them, at any distance.
function reveal_speed(t_full, is_known, dist, aimed, fov)
	if is_known then return 1 end
	if not aimed then return 0 end
	return min(1, identify_rate(dist, fov) * t_full)
end

-- advances a box's identification by this frame; returns the white -> colour mix (0..1)
local function step_reveal(ent)
	local n = ent.name and #ent.name or 0
	local t_full = DECODE_DELAY + max(n, 1) * DECODE_STEP
	local id = ent.id
	local is_known = id and known[id]
	if not ent.reveal_t then
		-- someone already identified keeps their name, faction and colour: shown at once when the box
		-- comes back after you looked away; someone half identified carries on from where they were
		ent.reveal_t = is_known and (max(t_full, REVEAL_MIN) + COLOR_FADE + FACTION_DELAY + 1)
			or (id and id_progress[id] or 0) * t_full
	end
	local s = reveal_speed(t_full, is_known, ent.dist or 0, ent.aimed, LG.fov)
	ent.reveal_t = ent.reveal_t + (LG.dt or 0) * s
	ent.id_pct = is_known and 1 or clamp01(ent.reveal_t / t_full)
	if id and not is_known then
		if ent.reveal_t >= t_full then
			remember_known(id)
			id_progress[id] = nil
			if zbc_eventlog and zbc_eventlog.identified then zbc_eventlog.identified(ent.name) end
		else
			id_progress[id] = ent.reveal_t / t_full
		end
	end
	return reveal_mix(ent.reveal_t, n)
end

local function draw_slot(slot, ent, dot_w, dot_h, style)
	local col = ent.col
	local m = smoothstep(0, 1, ent.dot_t)
	local r, g, b = col[1], col[2], col[3]
	if ent.dead_t then
		r, g, b = DEAD_COL[1], DEAD_COL[2], DEAD_COL[3]
		ent.info = info_text(true, nil, nil, nil, nil, words())
	elseif m < 0.98 then
		-- a hurt companion's colour runs toward grey with their health
		if ent.companion and ent.health then
			local hurt = 1 - clamp01(ent.health)
			r = floor(lerp(r, DEAD_COL[1], hurt) + 0.5)
			g = floor(lerp(g, DEAD_COL[2], hurt) + 0.5)
			b = floor(lerp(b, DEAD_COL[3], hurt) + 0.5)
		end
		-- a box: white while unknown, decoding to its colour as the stalker is identified
		local k = step_reveal(ent)
		r, g, b = floor(lerp(255, r, k) + 0.5), floor(lerp(255, g, k) + 0.5), floor(lerp(255, b, k) + 0.5)
		ent.info = info_text(false, ent.id and known[ent.id], ent.id_pct, ent.rank, ent.dist, words())
	end
	local vis_e = (ent.target_vis == 1) and ease_out3(ent.vis) or smoothstep(0, 1, ent.vis)
	local pop_alpha = ent.base_alpha * vis_e

	local box_pop_scale = (ent.target_vis == 1) and lerp(1.24, 1.0, vis_e) or lerp(1.14, 1.0, vis_e)
	local dot_pop_scale = lerp(0.35, 1.0, vis_e)

	local dw, dh = ent.dw or dot_w, ent.dh or dot_h

	local bx, by, bw, bh
	if ent.bcx ~= nil then
		bx, by, bw, bh = ent.bcx, ent.bcy, ent.bw, ent.bh
	else
		bx, by = ent.dcx, ent.dcy
		bw, bh = dw * 2.5, dh * 5.0
	end

	local dx, dy = ent.dcx or bx, ent.dcy or by

	local brackets = (style ~= 1)
	local st = brackets and slot.brk or slot.box
	local other = brackets and slot.box or slot.brk

	if m <= 0.02 then
		local argb = GetARGB(floor(255 * clamp01(pop_alpha)), r, g, b)
		apply_wnd(st, bx, by, bw * box_pop_scale, bh * box_pop_scale, argb)
		other:Show(false)
		slot.dot:Show(false)
		queue_label(slot, ent, bx, by - bh * box_pop_scale * 0.5, by + bh * box_pop_scale * 0.5, pop_alpha, r, g, b)
	elseif m >= 0.98 then
		local argb = GetARGB(floor(255 * clamp01(pop_alpha)), r, g, b)
		apply_wnd(slot.dot, dx, dy, dw * dot_pop_scale, dh * dot_pop_scale, argb)
		slot.box:Show(false)
		slot.brk:Show(false)
		hide_label(slot.lbl)
		ent.reveal_t = nil                       -- decodes again when it turns back into a box
	else
		local mcx = lerp(bx, dx, m)
		local mcy = lerp(by, dy, m)

		local box_w = lerp(bw, dw * 1.35, m) * box_pop_scale
		local box_h = lerp(bh, dh * 1.35, m) * box_pop_scale
		local box_a = (1 - smoothstep(0.15, 0.95, m)) * pop_alpha
		apply_wnd(st, mcx, mcy, box_w, box_h, GetARGB(floor(255 * clamp01(box_a)), r, g, b))
		other:Show(false)
		queue_label(slot, ent, mcx, mcy - box_h * 0.5, mcy + box_h * 0.5, box_a, r, g, b)

		local d_scale = lerp(0.55, 1.0, m) * dot_pop_scale
		local dot_a = smoothstep(0.10, 0.85, m) * pop_alpha
		apply_wnd(slot.dot, mcx, mcy, dw * d_scale, dh * d_scale, GetARGB(floor(255 * clamp01(dot_a)), r, g, b))
	end
end

---------------------------------------------------------------------------------------------------
-- Per frame
---------------------------------------------------------------------------------------------------

-- How much the view is magnified: 1 normally, the scope's zoom while aiming through one.
-- base_deg: the normal field of view (console "fov"); cur_deg: the camera's field of view now.
local MAX_ZOOM = 40
function zoom_factor(base_deg, cur_deg)
	if type(base_deg) ~= "number" or type(cur_deg) ~= "number" or cur_deg <= 0.5 or base_deg <= cur_deg then
		return 1
	end
	local r = math.rad
	local z = math.tan(r(min(base_deg, 170)) * 0.5) / math.tan(r(cur_deg) * 0.5)
	if not (z == z) then return 1 end
	return min(max(z, 1), MAX_ZOOM)
end

local function console_fov()
	local c = get_console and get_console()
	if not (c and c.get_float) then return nil end
	local ok, v = pcall(c.get_float, c, "fov")
	return ok and v or nil
end

function view_zoom()
	local dev = device and device()
	return zoom_factor(console_fov(), dev and dev.fov)
end

-- Magnification of a picture-in-picture scope view relative to the main view. The weapon's
-- GetZoomFactor on these scopes (GAMMA's 3DSS: scope_zoom_factor 20 / 30) works out at 100 / zf
-- with the main view at its normal field of view (base_deg), as the Bodycam exes' scope
-- projection uses it; a main view zoomed in a little (cur_deg) magnifies the lens less relative to it.
-- A small value (up to ZF_FOV_MIN) is read as a plain magnification, for scope mods that use it so.
ZF_FOV_MIN = 8
function pip_magnification(zf, base_deg, cur_deg)
	zf = tonumber(zf)
	if not zf or zf <= 1 then return 1 end
	base_deg = tonumber(base_deg) or 75
	cur_deg = tonumber(cur_deg) or base_deg
	local r = math.rad
	local main = math.tan(r(min(cur_deg, 170)) * 0.5) / math.tan(r(min(base_deg, 170)) * 0.5)
	local m = ((zf > ZF_FOV_MIN) and (100 / zf) or zf) * main
	if not (m == m) then return 1 end
	return min(max(m, 1), MAX_ZOOM)
end

-- Lens size of the scope in use. The Bodycam exes measure the picture-in-picture lens when their
-- diagnostics are on (console r__svp_diag 1): pip.log lines "[SVP-RATIO] ... measH <h> ... aim <a> ...
-- frame <n>", h being the lens height in half screen heights. It is read once per scope (turning the
-- diagnostics on only while measuring), else PIP_LENS_FALLBACK, measured on GAMMA's 3DSS scopes.
PIP_LENS_FALLBACK = 0.12
function parse_lens_log(text, frame0, frame_now)
	local r
	for line in tostring(text or ""):gmatch("[^\r\n]+") do
		local h, aim, fr = line:match("%[SVP%-RATIO%].-measH ([%d.]+).-aim ([%d.]+).- frame (%d+)")
		h, aim, fr = tonumber(h), tonumber(aim), tonumber(fr)
		if h and h >= 0.04 and h <= 4 and aim and aim >= 0.99 and fr and fr >= (frame0 or 0)
			and (not frame_now or fr <= frame_now) then
			r = h * 0.25
		end
	end
	return r
end

local LENS = { key = nil, r = nil, frame0 = 0, next_poll = 0, tries = 0, ours = false }
local function lens_diag_off()
	if not LENS.ours then return end
	LENS.ours = false
	local c = get_console and get_console()
	if c then pcall(c.execute, c, "r__svp_diag 0") end
end
local function read_int(c, name) return c:get_integer(name) end
local function read_scope_name(w) return w:GetScopeName() end

local function lens_radius(item, w, dev)
	local ok_n, scope = pcall(read_scope_name, w)
	local key = item:id() .. "/" .. tostring(ok_n and scope or "") .. "/" .. tostring(dev.width) .. "x" .. tostring(dev.height)
	local frame = tonumber(dev.frame)
	if LENS.key ~= key then
		lens_diag_off()
		LENS.key, LENS.r, LENS.frame0, LENS.next_poll, LENS.tries = key, nil, frame or 0, 0, 0
	end
	if LENS.r or LENS.tries >= 20 then
		lens_diag_off()
		return LENS.r or PIP_LENS_FALLBACK
	end
	local now = time_global()
	if now < LENS.next_poll then return PIP_LENS_FALLBACK end
	LENS.next_poll = now + 250
	LENS.tries = LENS.tries + 1
	local c = get_console and get_console()
	if not c then return PIP_LENS_FALLBACK end
	local ok_d, diag = pcall(read_int, c, "r__svp_diag")
	if not ok_d then
		LENS.tries = 99                                    -- exes without the diagnostics
		return PIP_LENS_FALLBACK
	end
	if tonumber(diag) == 0 then
		pcall(c.execute, c, "r__svp_diag 1")
		LENS.ours = true
		return PIP_LENS_FALLBACK
	end
	local fs = getFS and getFS()
	local path = fs and fs:update_path("$logs$", "pip.log")
	local f = path and io.open(path, "rb")
	if not f then return PIP_LENS_FALLBACK end
	local size = f:seek("end") or 0
	f:seek("set", max(0, size - 32768))
	local tail = f:read("*a") or ""
	f:close()
	LENS.r = parse_lens_log(tail, LENS.frame0, frame)
	if LENS.r then lens_diag_off() end
	return LENS.r or PIP_LENS_FALLBACK
end

local function read_zoom(w) return w:GetZoomFactor() end
local tmp_aimpt = nil

-- updates PIP once a frame (shared with zbc_faces.script)
function pip_refresh()
	local now = time_global()
	if PIP.t == now then return PIP end
	PIP.t = now
	PIP.m = 1
	PIP.au, PIP.av = 0.5, 0.5
	local dev = device and device()
	if dev and dev.width and dev.height and dev.height > 0 then PIP.a = dev.width / dev.height end
	if type(is_svp_active) ~= "function" then return PIP end   -- engine without picture-in-picture scopes
	local ok, on = pcall(is_svp_active)
	if not (ok and on) then
		lens_diag_off()
		return PIP
	end
	local actor = db.actor
	local wpn = actor and actor:active_item()
	local w = wpn and wpn.cast_Weapon and wpn:cast_Weapon()
	if not w then return PIP end
	local ok2, zf = pcall(read_zoom, w)
	PIP.m = pip_magnification(ok2 and zf, console_fov(), dev and dev.fov)
	-- the lens size: set by hand in MCM for unusual scopes, otherwise measured / estimated
	PIP.r = (lens_override and lens_override > 0) and lens_override or lens_radius(wpn, w, dev)
	-- where the gun points on screen (decoupled camera): a point far along its aim
	local pos, dir = weapon_aim()
	if pos and game and game.world2ui then
		tmp_aimpt = tmp_aimpt or vector()
		tmp_aimpt:set(pos.x + dir.x * 200, pos.y + dir.y * 200, pos.z + dir.z * 200)
		local p = game.world2ui(tmp_aimpt, false)
		if p and p.x ~= -9999 and p.x >= 0 and p.x <= 1024 and p.y >= 0 and p.y <= 768 then
			PIP.au, PIP.av = p.x / 1024, p.y / 768
		end
	end
	return PIP
end

local function fill_metrics(M, F, em, ux, uy)
	local scale = em / F.em
	M.adv    = F.advance * scale * ux
	M.qw     = F.cell_w * scale * ux
	M.qh     = F.cell_h * scale * uy
	M.pad_x  = F.pad * scale * ux
	M.pad_y  = F.pad * scale * uy
	M.line_h = (F.cell_h - 2 * F.pad) * scale * uy
	return M
end

-- cfg: zbc_bodycam settings; L: lens state; visible: HUD shown
function update(pool, cfg, L, visible)
	if not pool then return end
	local actor = db.actor
	if not (cfg.allies and actor) then
		reset_state()
		hide_all(pool)
		return
	end
	if not visible then
		hide_all(pool)
		return
	end

	tmp_top   = tmp_top   or vector()
	tmp_pos   = tmp_pos   or vector2()
	tmp_sz    = tmp_sz    or vector2()
	tmp_cam   = tmp_cam   or vector()
	tmp_bone  = tmp_bone  or vector()
	tmp_ray_p = tmp_ray_p or vector()
	tmp_ray_d = tmp_ray_d or vector()

	-- through a scope the range (and the box/dot switch) grows with the zoom, so an ally that looks as
	-- big as one at the normal range still gets a box and a name
	local range = max(cfg.allies_range, 2) * max(view_zoom(), pip_refresh().m)
	local now = time_global() / 1000
	scan_enemies = cfg.allies_enemies and true or false
	scan_mutants = cfg.allies_mutants and true or false
	lens_override = tonumber(cfg.allies_lens) or 0
	LG.random = cfg.allies_decode_random and true or false
	LG.known_only = cfg.allies_known_only and true or false
	if last_now and now < last_now then
		next_scan = 0
		last_now = nil
		for eid, ent in pairs(states) do ent.next_los = now + (eid % 4) * (LOS_INTERVAL * 0.25) end
	end
	local dt = last_now and min(max(now - last_now, 0), MAX_DT) or 0
	last_now = now

	if now >= next_scan then
		next_scan = now + SCAN_INTERVAL
		scan(actor, range)
	end

	local dev = device()
	local sw, sh = dev and dev.width or 0, dev and dev.height or 0
	if sw <= 0 or sh <= 0 then
		hide_all(pool)
		return
	end
	local a = sw / sh
	local ux, uy = 1024 / sw, 768 / sh
	local W = fill_warp_frame(frame_W, L, a)
	local cam_vec = nil
	if dev.cam_pos then
		cam_vec = tmp_cam:set(dev.cam_pos.x, dev.cam_pos.y, dev.cam_pos.z)
	end
	local apos = actor:position()
	frame_cols.companion = COLORS[cfg.allies_color_companion + 1]
	frame_cols.friend    = COLORS[(cfg.allies_color_friend or 1) + 1]
	frame_cols.enemy     = COLORS[(cfg.allies_color_enemy or 5) + 1]
	LG.now = now
	LG.dt = dt
	LG.fov = dev.fov
	frame_dir = dev.cam_dir
	local dot_dist = range * cfg.allies_dot_ratio
	local dot_w, dot_h = 11 * cfg.allies_size * ux, 11 * cfg.allies_size * uy

	-- name labels: overlay glyph font, size from the effective 16:9 width like the overlay
	local F = zbc_font_metrics
	LG.on = cfg.allies_names and F ~= nil
	if LG.on then
		if LG.sw ~= sw or LG.sh ~= sh or not LG.n then
			LG.sw, LG.sh = sw, sh
			local em_px = LABEL_VW * 0.01 * min(sw, sh * (16 / 9))
			LG.n        = fill_metrics(LG.n or {}, F, em_px, ux, uy)
			LG.f        = fill_metrics(LG.f or {}, F, em_px * FACTION_SCALE, ux, uy)
			LG.gap      = LABEL_GAP * em_px * uy
			LG.line_gap = LINE_GAP * em_px * uy
		end
		LG.pos  = LG.pos or vector2()
		LG.size = LG.size or vector2()
		LG.rect = LG.rect or Frect()
	end

	-- the target, at any distance: whoever the gun points at (Bodycam exes, decoupled camera) or the
	-- crosshair target (Identification UI's level.get_target_obj); kept while you stay within
	-- ID_LENIENCE of them, dropped when you look away
	frame_aim_pos, frame_aim_dir = weapon_aim()
	local tobj
	if frame_aim_pos then
		tobj = trace_aim(actor, frame_aim_pos, frame_aim_dir)
	else
		tobj = level.get_target_obj and level.get_target_obj()
	end
	if tobj and tobj:id() ~= 0 and tobj.alive and tobj:alive() and markable(tobj)
		and (IsStalker(tobj) or (scan_mutants and IsMonster and IsMonster(tobj)))
		and (scan_enemies or tobj:relation(actor) ~= game_object.enemy)
	then
		aim_target = tobj:id()
	end
	if aim_target then
		local o = level.object_by_id(aim_target)
		if not (o and o:alive() and aimed_at(o, cam_vec)) then aim_target = nil end
	end

	for k in pairs(cand_set) do cand_set[k] = nil end
	local n_proc = 0
	if aim_target then
		cand_set[aim_target] = true
		n_proc = 1
		proc_ids[1] = aim_target
	end
	for i = 1, #candidates do
		local id = candidates[i]
		if not cand_set[id] then
			cand_set[id] = true
			n_proc = n_proc + 1
			proc_ids[n_proc] = id
		end
	end
	for id in pairs(states) do
		if not cand_set[id] then
			n_proc = n_proc + 1
			proc_ids[n_proc] = id
		end
	end

	local n_draw = 0
	for i = 1, n_proc do
		local id = proc_ids[i]
		local ok = step_entity(
			id, actor, apos, cam_vec, now, range, dot_dist, cand_set[id] == true,
			cfg, L, a, ux, uy, dot_w, dot_h, frame_cols, dt, W
		)
		if ok then
			n_draw = n_draw + 1
			draw_list[n_draw] = id
		end
	end
	for i = n_draw + 1, #draw_list do draw_list[i] = nil end

	if n_draw > 1 then
		table.sort(draw_list, cmp_draw)
	end

	label_n = 0
	local n_shown = min(n_draw, #pool)
	for i = 1, n_shown do
		draw_slot(pool[i], states[draw_list[i]], dot_w, dot_h, cfg.allies_style)
	end
	flush_labels()                                       -- every label at once: on screen, no overlaps
	for i = n_shown + 1, #pool do hide(pool[i]) end

	-- companions you can't see: a dot at the screen edge pointing toward them
	local shown_edges = 0
	if cfg.allies_companion_edge ~= false and pool.edges and frame_dir and cam_vec then
		local d = frame_dir
		local hl = sqrt(d.x * d.x + d.z * d.z)
		if hl > 1e-4 then
			local rx, rz = d.z / hl, -d.x / hl                  -- camera right (horizontal)
			local tx, ty, tz = d.y * rz, d.z * rx - d.x * rz, -d.y * rx   -- camera up = forward x right
			local col = frame_cols.companion or COLORS[2]
			local size_x, size_y = 9 * ux * cfg.allies_size, 9 * uy * cfg.allies_size
			for i = 1, #companion_ids do
				if shown_edges >= #pool.edges then break end
				local id = companion_ids[i]
				local ent = states[id]
				local obj = level.object_by_id(id)
				if obj and not (ent and ent.vis and ent.vis > 0.5) then
					local p = obj:position()
					local dx, dy, dz = p.x - cam_vec.x, p.y + 1.2 - cam_vec.y, p.z - cam_vec.z
					local f = dx * d.x + dy * d.y + dz * d.z
					local su, sv = nil, nil
					if f > 0.1 then su, sv = project(tmp_top:set(p.x, p.y + 1.2, p.z)) end
					local onscreen = su and su > 0.02 and su < 0.98 and sv > 0.02 and sv < 0.98
					if not onscreen then
						local ex, ey = edge_ui(dx * rx + dz * rz, dx * tx + dy * ty + dz * tz, f)
						shown_edges = shown_edges + 1
						apply_wnd(pool.edges[shown_edges], ex, ey, size_x, size_y,
							GetARGB(floor(255 * clamp01(cfg.allies_opacity)), col[1], col[2], col[3]))
					end
				end
			end
		end
	end
	if pool.edges then
		for i = shown_edges + 1, #pool.edges do pool.edges[i]:Show(false) end
	end
end

function on_game_start()
	if RegisterScriptCallback then
		RegisterScriptCallback("actor_on_first_update", on_first_update)
		RegisterScriptCallback("actor_on_net_destroy", on_net_destroy)
		RegisterScriptCallback("save_state", save_state)
		RegisterScriptCallback("load_state", load_state)
		RegisterScriptCallback("GUI_on_show", on_gui_show)
	end
end
