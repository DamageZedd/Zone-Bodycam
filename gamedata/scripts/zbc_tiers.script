--[[
	Zone Bodycam - camera generations (tiers)

	With the optional bodycam item, the carried Axon Body camera decides what the feed can do: Axon Body 1
	is the worst (low resolution, noisy, no GPS, no identification), Axon Body 5 the best. Axon Body 4 is
	the reference: its profile changes nothing, so it looks exactly like the MCM settings (and like the
	core mod without the item, which has no tier at all).

	How a tier meets the MCM (the MCM stays the player's preference):
	- features: on only when the MCM has them on AND the camera has them;
	- effect strengths: MCM value x the tier's multiplier, clamped to the MCM range (0 stays 0);
	- caps: never above the tier's limit (identification range).

	Pure logic, no engine calls (tested by tools\tests\zbc_tiers_test.lua). zbc_bodycam.script applies it.
]]

MIN_TIER, MAX_TIER = 1, 5
REFERENCE_TIER = 4

-- off: MCM keys a camera does not have (booleans forced false; night_mode forced to 2 = off; review_key
-- forced to 0 = no key). scale: multipliers on MCM values. cap: upper limits on MCM values.
-- decode: identification speed. dark_grain: extra grain share in the dark (0.6 = 60% more).
PROFILES = {
	[1] = {
		off = { show_name = true, gps_line = true, event_log = true, auto_exposure = true, night_mode = true,
			face_blur = true, allies = true, allies_companion_edge = true, allies_pip = true, review_key = true },
		scale = { grain = 1.8, compression = 2.0, sharpen = 0.3, edge_soft_blur = 1.6, aberration = 1.6,
			rolling_shutter = 1.6, highlight_blowout = 1.6, walk_bob = 1.3, impacts = 1.3, fx_glitch_strength = 1.5 },
		cap = {},
		decode = 0, dark_grain = 0.60,
	},
	[2] = {
		off = { gps_line = true, event_log = true, night_mode = true, face_blur = true, allies_enemies = true,
			allies_mutants = true, allies_companion_edge = true, allies_pip = true, review_key = true },
		scale = { grain = 1.4, compression = 1.5, sharpen = 0.6, edge_soft_blur = 1.3, aberration = 1.3,
			rolling_shutter = 1.35, highlight_blowout = 1.35, walk_bob = 1.2, impacts = 1.2, fx_glitch_strength = 1.3 },
		cap = { allies_range = 15 },
		decode = 0.5, dark_grain = 0.35,
	},
	[3] = {
		off = { face_blur = true, allies_mutants = true, allies_pip = true },
		scale = { grain = 1.15, compression = 1.2, sharpen = 0.85, edge_soft_blur = 1.1, aberration = 1.1,
			rolling_shutter = 1.15, highlight_blowout = 1.15, walk_bob = 1.1, impacts = 1.1, fx_glitch_strength = 1.15 },
		cap = { allies_range = 25 },
		decode = 0.75, dark_grain = 0.15,
	},
	[4] = { off = {}, scale = {}, cap = {}, decode = 1, dark_grain = 0 },
	[5] = {
		off = {},
		scale = { grain = 0.7, compression = 0.6, sharpen = 1.25, edge_soft_blur = 0.8, aberration = 0.7,
			rolling_shutter = 0.6, highlight_blowout = 0.7, walk_bob = 0.85, impacts = 0.85, fx_glitch_strength = 0.7 },
		cap = {},
		decode = 1.5, dark_grain = -0.20,
	},
}

-- clamps for values a tier may push past the MCM range (the MCM range itself comes from the caller)
local EXTRA_CLAMPS = { fx_glitch_strength = { 0, 1.5 } }

-- a valid tier number, or nil (no tier: the core mod alone, or the item's limits turned off)
function valid_tier(t)
	t = tonumber(t)
	if not t or t ~= t then return nil end
	t = math.floor(t + 0.5)
	if t < MIN_TIER or t > MAX_TIER then return nil end
	return t
end

-- true when the camera of tier t has the feature behind MCM key `key` (no tier: everything)
function has_feature(t, key)
	local p = PROFILES[valid_tier(t) or 0]
	if not p then return true end
	return not p.off[key]
end

-- Fills `out` (or a new table) with the settings the camera actually uses: `user` (the MCM values,
-- already clamped) with the tier applied. clamps: { key = { lo, hi } } (zbc_bodycam's MCM ranges).
-- Always sets the derived keys allies_decode_mult, allies_pip and dark_grain.
function apply(user, tier, clamps, out)
	out = out or {}
	for k in pairs(out) do
		if user[k] == nil then out[k] = nil end
	end
	for k, v in pairs(user) do out[k] = v end
	out.allies_pip = (user.allies_pip ~= false)
	out.allies_decode_mult = 1
	out.dark_grain = 0
	local p = PROFILES[valid_tier(tier) or 0]
	if not p then return out end

	for k in pairs(p.off) do
		if k == "night_mode" then
			out[k] = 2
		elseif k == "review_key" then
			out[k] = 0
		else
			out[k] = false
		end
	end
	for k, m in pairs(p.scale) do
		local v = tonumber(out[k])
		if v then
			v = v * m
			local b = EXTRA_CLAMPS[k] or (clamps and clamps[k])
			if b then v = math.min(math.max(v, b[1]), b[2]) end
			out[k] = v
		end
	end
	for k, c in pairs(p.cap) do
		local v = tonumber(out[k])
		if v and v > c then out[k] = c end
	end
	out.allies_decode_mult = p.decode
	out.dark_grain = p.dark_grain
	return out
end

-- grain with the low-light boost: dark 0 (lit) .. 1 (dark), boost from the profile (dark_grain)
function grain_in_dark(grain, dark_grain, dark)
	grain = tonumber(grain) or 0
	local d = math.min(math.max(tonumber(dark) or 0, 0), 1)
	local g = grain * (1 + (tonumber(dark_grain) or 0) * d)
	return math.min(math.max(g, 0), 1)
end
