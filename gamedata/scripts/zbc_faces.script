--[[
	Zone Bodycam - face pixelation (zbc_faces.script)

	Finds the heads of the human NPCs (alive or dead, at any distance) the camera can see and returns a
	square around each face in rendered-image uv. postprocess.ps snaps every pixel that samples inside
	one of those squares to a coarse block grid (zbc_face_snap in shaders\r3\zbc_lens.h) before the
	lens warp, so the mosaic bends with the fisheye like the rest of the picture.

	Called by zbc_bodycam.script every frame while the camera records (MCM: Blur faces).
]]

local floor, ceil, min, max, sqrt, tan, rad = math.floor, math.ceil, math.min, math.max, math.sqrt, math.tan, math.rad

local function clamp01(v)
	if v < 0 then return 0 end
	if v > 1 then return 1 end
	return v
end

-- No distance limit: through a scope a face hundreds of metres away fills the screen. What decides is
-- the face's size on screen, so a far face without a scope (a few pixels) is left alone.
local POOL          = 256    -- nearest online NPCs kept as candidates (only those on screen and in sight are drawn)
local SCAN_INTERVAL = 0.25   -- seconds between candidate rescans
local LOS_INTERVAL  = 0.1    -- seconds between line-of-sight checks per NPC
local HEAD_UP       = 0.07   -- metres from the head bone up to the middle of the face
local HEAD_HALF     = 0.105  -- half the side of the square around the face, metres (~21 cm face-sized)
local FACE_FWD      = 0.08   -- metres forward from head bone to face plane when eye bones are absent
FACING_COS          = 0.15   -- min dot(face_dir, to_cam) to blur (~81 deg; skips back and back-3/4)
BLOCKS              = 8      -- blocks across the square on a near face (even)
MIN_BLOCK_PX        = 5      -- smaller faces still get blocks at least this many pixels tall...
MIN_FACE_PX         = 3      -- ...and faces with a half side under this many pixels are not pixelated

local cands = {}
local scan_d2 = {}
local next_scan = 0
local last_now = nil
local los = {}               -- id -> { ok = bool, next = seconds }
local rows = {}              -- reused result rows { cu, cv, half_v, blk_v }
local tmp_c, tmp_t, tmp_up, tmp_side, tmp_cam

function reset()
	for i = #cands, 1, -1 do cands[i] = nil; scan_d2[i] = nil end
	next_scan = 0
	last_now = nil
	los = {}
	last_uv = {}
end

-- The square for one face, in v units (screen heights; u units are these divided by the aspect).
-- cu, cv: face centre in uv; tu, tv: the point HEAD_HALF beside it in uv; a: aspect; H: height px.
-- Returns half_v, blk_v: the square is a whole, even number of blocks wide, at least 4. nil for a
-- face too small to recognise.
function face_square(cu, cv, tu, tv, a, H)
	H = max(H, 1)
	local du, dv = (tu - cu) * a, tv - cv
	local half = sqrt(du * du + dv * dv)
	if not (half == half) or half < MIN_FACE_PX / H then return nil end
	-- blocks: BLOCKS across a near face, at least MIN_BLOCK_PX, but never so big that 4 of them
	-- would make the square larger than the face
	local blk = min(max(2 * half / BLOCKS, MIN_BLOCK_PX / H), half / 2)
	local n = max(2 * ceil(half / blk - 0.001), 4)
	return n * 0.5 * blk, blk
end

-- Shader packing (bus_zbc_face_rows in shaders\r3\zbc_lens.h): two faces per uint4 row, each face
-- two uints of two 16-bit fixed-point halves: (centre u | centre v), (half side | block size).
-- Centres cover -0.25..1.25 uv, sizes 0..0.75 screen heights: steps of about 1/40000 of the screen.
POS_MIN, POS_SPAN, SIZE_SPAN = -0.25, 1.5, 0.75

local function q16(v, lo, span)
	local q = floor((v - lo) / span * 65535 + 0.5)
	if not (q == q) then return 0 end
	return min(max(q, 0), 65535)
end

function pack_face(cu, cv, half, blk)
	return q16(cu, POS_MIN, POS_SPAN) * 65536 + q16(cv, POS_MIN, POS_SPAN),
		q16(half, 0, SIZE_SPAN) * 65536 + q16(blk, 0, SIZE_SPAN)
end

-- fills out[1..ceil(n/2)] with uint4 rows for faces 1..n of list; returns the row count
function pack_rows(list, n, out)
	local rows_n = ceil(n / 2)
	for r = 1, rows_n do
		local row = out[r]
		if not row then
			row = { 0, 0, 0, 0 }
			out[r] = row
		end
		local a = list[2 * r - 1]
		row[1], row[2] = pack_face(a[1], a[2], a[3], a[4])
		local b = (2 * r <= n) and list[2 * r]
		if b then
			row[3], row[4] = pack_face(b[1], b[2], b[3], b[4])
		else
			row[3], row[4] = 0, 0
		end
	end
	for r = rows_n + 1, #out do out[r] = nil end
	return rows_n
end

-- Union AABB across list[1..n] in rendered-image uv, padded by 0.002 and quantized to 12 bits per bound.
-- Returns count, packed_u, packed_v, valid_flag for bus_zbc_faces.
function pack_bounds(list, n, asp)
	if not list or not n or n <= 0 then return 0, 0, 0, 0 end
	asp = max(tonumber(asp) or (16 / 9), 0.1)
	local pad = 0.002
	local min_u, min_v, max_u, max_v = 1, 1, 0, 0
	for i = 1, n do
		local f = list[i]
		local cu, cv, half = f[1], f[2], f[3]
		local hu = half / asp
		local x0, x1 = cu - hu - pad, cu + hu + pad
		local y0, y1 = cv - half - pad, cv + half + pad
		if x0 < min_u then min_u = x0 end
		if x1 > max_u then max_u = x1 end
		if y0 < min_v then min_v = y0 end
		if y1 > max_v then max_v = y1 end
	end
	local min_u_q = floor(clamp01(min_u) * 4095)
	local max_u_q = ceil(clamp01(max_u) * 4095)
	local min_v_q = floor(clamp01(min_v) * 4095)
	local max_v_q = ceil(clamp01(max_v) * 4095)
	return n, min_u_q + max_u_q * 4096, min_v_q + max_v_q * 4096, 1.0
end

-- Which heads get blurred: configs\zbc_face_models.ltx can list models to skip (a full face mask has
-- no face to hide) in [skip], or limit blurring to listed models in [only]. Both empty by default.
local MODELS = nil
function model_key(path)
	return (tostring(path or ""):lower():gsub("/", "\\"):gsub("^meshes\\", ""):gsub("%.ogf$", ""))
end

local function read_model_list(ini, section)
	local list = {}
	if not (ini and ini.section_exist and ini:section_exist(section)) then return list end
	for i = 0, ini:line_count(section) - 1 do
		local ok, key = ini:r_line(section, i, "", "")
		if ok and key and key ~= "" then list[model_key(key)] = true end
	end
	return list
end

local function read_models(ini) return { skip = read_model_list(ini, "skip"), only = read_model_list(ini, "only") } end

function face_allowed(model, lists)
	local key = model_key(model)
	if lists.skip[key] then return false end
	if next(lists.only) and not lists.only[key] then return false end
	return true
end

local function read_visual(obj) return obj:get_visual_name() end

local function has_face(obj)
	if not MODELS then
		local ok, lists = pcall(function() return read_models(ini_file and ini_file("zbc_face_models.ltx")) end)
		MODELS = ok and lists or { skip = {}, only = {} }
	end
	if not (next(MODELS.skip) or next(MODELS.only)) then return true end
	local ok, model = pcall(read_visual, obj)
	return not ok or face_allowed(model, MODELS)
end

local function scan(actor)
	local apos = actor:position()
	local n = 0
	for id, st in pairs(db.storage) do
		local obj = st and st.object
		if obj and id ~= 0 and (IsStalker(obj) or (IsTrader and IsTrader(obj))) and has_face(obj) then
			local d2 = obj:position():distance_to_sqr(apos)
			if n < POOL or d2 < scan_d2[POOL] then
				local pos = (n < POOL) and (n + 1) or POOL
				while pos > 1 and d2 < scan_d2[pos - 1] do
					scan_d2[pos] = scan_d2[pos - 1]
					cands[pos] = cands[pos - 1]
					pos = pos - 1
				end
				scan_d2[pos] = d2
				cands[pos] = id
				if n < POOL then n = n + 1 end
			end
		end
	end
	for i = n + 1, #cands do cands[i] = nil; scan_d2[i] = nil end
	for id in pairs(los) do
		local keep = false
		for i = 1, n do if cands[i] == id then keep = true break end end
		if not keep then los[id] = nil end
	end
end

-- Lag-free placement: the face centre one frame ahead, from its own last on-screen step, capped so a
-- sudden jump (a teleport, a new target) is never overshot. prev: { u, v } of the last frame or nil.
PREDICT_MAX = 0.04           -- largest step carried forward, in uv
last_uv = {}
function predict(prev, u, v, mode)
	if not prev then return u, v end
	if mode ~= nil and prev[3] ~= nil and prev[3] ~= mode then return u, v end
	local du, dv = u - prev[1], v - prev[2]
	if math.abs(du) > PREDICT_MAX or math.abs(dv) > PREDICT_MAX then return u, v end
	return u + du, v + dv
end

local function project_raw(vec)
	local p = game.world2ui(vec, false)
	if not p or p.x == -9999 then return nil end
	return p.x / 1024, p.y / 768
end

local function project_point(vec, use_pip, P)
	local u, v = project_raw(vec)
	if not u then return nil end
	if use_pip then
		local mu, mv = zbc_allies.pip_map(u, v, P)
		return mu, mv
	end
	return u, v
end

local function visible(actor, obj, id, now, cam)
	local e = los[id]
	if not e then
		e = { ok = false, next = now + (id % 5) * (LOS_INTERVAL * 0.2) }
		los[id] = e
	end
	if now >= e.next then
		e.next = now + LOS_INTERVAL
		if cam and zbc_allies and zbc_allies.los_point then
			e.ok = zbc_allies.los_point(actor, id, cam, tmp_c.x, tmp_c.y, tmp_c.z)
		else
			e.ok = actor:see(obj)
		end
	end
	return e.ok
end

-- Returns true when a face at (fx, fy, fz) with forward direction (dx, dy, dz) is facing the
-- camera at (cx, cy, cz). Missing direction or camera defaults to true so mocks without facing
-- APIs still blur.
function face_visible_to_cam(fx, fy, fz, dx, dy, dz, cx, cy, cz)
	if not (dx and dy and dz and cx and cy and cz) then return true end
	local dlen = sqrt(dx * dx + dy * dy + dz * dz)
	if dlen < 1e-6 then return true end
	local vx, vy, vz = cx - fx, cy - fy, cz - fz
	local vlen = sqrt(vx * vx + vy * vy + vz * vz)
	if vlen < 1e-6 then return true end
	return (dx * vx + dy * vy + dz * vz) / (dlen * vlen) > FACING_COS
end

-- Resolves face centre (fx, fy, fz) and forward direction (dx, dy, dz) from eye/jaw bones when
-- present (works for both alive head-turning stalkers and ragdolled corpses), falling back to
-- head_orientation() / direction() for alive NPCs without eye bones.
local function face_pose(obj, head)
	if obj.get_bone_id and obj.bone_position then
		local l_id = obj:get_bone_id("eye_left")
		local r_id = obj:get_bone_id("eye_right")
		if l_id and l_id ~= 65535 and r_id and r_id ~= 65535 then
			local el = obj:bone_position("eye_left")
			local er = obj:bone_position("eye_right")
			if el and er then
				local ex = 0.5 * (el.x + er.x)
				local ey = 0.5 * (el.y + er.y)
				local ez = 0.5 * (el.z + er.z)
				local cx, cy, cz = ex, ey, ez
				local dx, dy, dz = ex - head.x, ey - head.y, ez - head.z
				local j_id = obj:get_bone_id("jaw_1")
				if j_id and j_id ~= 65535 then
					local jaw = obj:bone_position("jaw_1")
					if jaw then
						cx = ex * 0.65 + jaw.x * 0.35
						cy = ey * 0.65 + jaw.y * 0.35
						cz = ez * 0.65 + jaw.z * 0.35
						local ux, uy, uz = ex - jaw.x, ey - jaw.y, ez - jaw.z
						local ulen = sqrt(ux * ux + uy * uy + uz * uz)
						if ulen > 1e-4 then
							ux, uy, uz = ux / ulen, uy / ulen, uz / ulen
							local proj = dx * ux + dy * uy + dz * uz
							local fx, fy, fz = dx - proj * ux, dy - proj * uy, dz - proj * uz
							if fx * fx + fy * fy + fz * fz > 1e-6 then
								dx, dy, dz = fx, fy, fz
							end
						end
					end
				end
				return cx, cy, cz, dx, dy, dz
			end
		end
	end
	local fx, fy, fz = head.x, head.y + HEAD_UP, head.z
	if obj.alive and obj:alive() then
		local d = (IsStalker and IsStalker(obj) and obj.head_orientation and obj:head_orientation())
			or (obj.direction and obj:direction())
		if d then
			local dlen = sqrt(d.x * d.x + d.y * d.y + d.z * d.z)
			if dlen > 1e-4 then
				local dx, dy, dz = d.x / dlen, d.y / dlen, d.z / dlen
				return fx + dx * FACE_FWD, fy + dy * FACE_FWD, fz + dz * FACE_FWD, dx, dy, dz
			end
		end
	end
	return fx, fy, fz, nil, nil, nil
end

-- Returns rows, n, aspect: up to max_n squares { cu, cv, half_v, blk_v }, nearest first.
function update(actor, max_n)
	if not actor then return rows, 0, 16 / 9 end
	tmp_c   = tmp_c   or vector()
	tmp_t   = tmp_t   or vector()
	tmp_up   = tmp_up   or vector():set(0, 1, 0)
	tmp_side = tmp_side or vector()
	tmp_cam  = tmp_cam  or vector()

	local now = time_global() / 1000
	if last_now and now < last_now then reset() end
	last_now = now
	if now >= next_scan then
		next_scan = now + SCAN_INTERVAL
		scan(actor)
	end

	local dev = device()
	local W, H = dev and dev.width or 0, dev and dev.height or 0
	if W <= 0 or H <= 0 then return rows, 0, 16 / 9 end
	local a = max(W / H, 0.1)
	local fov = tonumber(dev.fov) or 75
	local tan_half = tan(rad(min(max(fov, 1), 170) * 0.5))
	-- through a picture-in-picture scope faces show magnified, so far faces are big enough to blur there
	local mag = 1
	local P = nil
	local pip_on = false
	if zbc_allies then
		P = (zbc_allies.pip_refresh and zbc_allies.pip_refresh()) or zbc_allies.PIP
		mag = max(tonumber(P and P.m) or 1, 1)
		pip_on = zbc_allies.pip_active and zbc_allies.pip_active(P) and zbc_allies.pip_map ~= nil
	end
	local max_dist = (HEAD_HALF * H * max(a, 1) * mag) / (2 * MIN_FACE_PX * max(tan_half, 1e-4)) + 5
	local max_d2 = max_dist * max_dist
	-- the square's size comes from a point HEAD_HALF to the side of the face: a sideways offset stays
	-- its full length on screen whatever the pitch (world up, only when looking straight up or down)
	local side = tmp_up
	local dir = dev.cam_dir
	if dir then
		local l = sqrt(dir.x * dir.x + dir.z * dir.z)
		if l > 0.05 then side = tmp_side:set(dir.z / l, 0, -dir.x / l) end
	end
	local cam = nil
	if dev.cam_pos then cam = tmp_cam:set(dev.cam_pos.x, dev.cam_pos.y, dev.cam_pos.z) end

	local n = 0
	for i = 1, #cands do
		if n >= max_n then break end
		if scan_d2[i] and scan_d2[i] > max_d2 then break end
		local id = cands[i]
		local obj = level.object_by_id(id)
		-- cheap skip for NPCs behind the camera before the bone lookup (wider margin for lying corpses)
		if obj and cam and dir then
			local p = obj:position()
			local hy = (obj.alive and obj:alive()) and 1.6 or 0.15
			if (p.x - cam.x) * dir.x + (p.y + hy - cam.y) * dir.y + (p.z - cam.z) * dir.z < -2.0 then obj = nil end
		end
		local head = obj and utils_obj.safe_bone_pos(obj, "bip01_head")
		if head then
			local fx, fy, fz, dx, dy, dz = face_pose(obj, head)
			if not cam or face_visible_to_cam(fx, fy, fz, dx, dy, dz, cam.x, cam.y, cam.z) then
				tmp_c:set(fx, fy, fz)
				-- Dual-view 3DSS PiP projection: inside the lens we use magnified pip_map; outside the
				-- circular lens we keep the raw 1x main-camera view so nearby faces stay pixelated.
				local ru, rv = project_raw(tmp_c)
				local cu, cv, use_pip
				if ru then
					if pip_on then
						local mu, mv, in_lens = zbc_allies.pip_map(ru, rv, P)
						if in_lens then
							cu, cv, use_pip = mu, mv, true
						else
							local pa = (P and P.a) or a
							local pr = (P and P.r) or 0.12
							local dx_l, dy_l = (ru - 0.5) * pa, rv - 0.5
							if dx_l * dx_l + dy_l * dy_l > pr * pr then
								cu, cv, use_pip = ru, rv, false
							end
						end
					else
						cu, cv, use_pip = ru, rv, false
					end
				end
				if cu and cu > -0.25 and cu < 1.25 and cv > -0.25 and cv < 1.25 then
					tmp_t:set(tmp_c.x + side.x * HEAD_HALF, tmp_c.y + side.y * HEAD_HALF, tmp_c.z + side.z * HEAD_HALF)
					local tu, tv = project_point(tmp_t, use_pip, P)   -- only sizes the square: may lie past the lens edge
					if not tu then
						tmp_t:set(tmp_c.x - side.x * HEAD_HALF, tmp_c.y - side.y * HEAD_HALF, tmp_c.z - side.z * HEAD_HALF)
						tu, tv = project_point(tmp_t, use_pip, P)
					end
					local half, blk
					if tu then half, blk = face_square(cu, cv, tu, tv, a, H) end
					if half and (cu + half / a > 0 and cu - half / a < 1 and cv + half > 0 and cv - half < 1)
						and visible(actor, obj, id, now, cam) then
						n = n + 1
						local r = rows[n]
						if not r then
							r = {}
							rows[n] = r
						end
						-- one frame ahead: the square is placed from this frame's camera but drawn on the
						-- next, so it would trail a fast turn; move it on by its own last step
						local pu, pv = predict(last_uv[id], cu, cv, use_pip)
						last_uv[id] = last_uv[id] or {}
						last_uv[id][1], last_uv[id][2], last_uv[id][3] = cu, cv, use_pip
						r[1], r[2], r[3], r[4] = pu, pv, half, blk
					end
				end
			else
				last_uv[id] = nil
			end
		end
	end
	return rows, n, a
end
