--[[
	Zone Bodycam - camera effects state (zbc_fx.script)

	Works out, every frame, the values the post shader needs for:
	- interference: the picture tears and breaks up in emissions and psy storms, in psy fields, in
	  strong radiation, next to anomalies, and in short bursts when you are hit hard
	- signal lost: when you die the feed glitches, cuts to black and shows "SIGNAL LOST" over the
	  last timestamp (started from the death callback, then timed by the shader itself)
	- low-light mode: a grainy, nearly black-and-white infrared look at night and underground
	- event marker: "EVENT" after REC for a few seconds after you fire or take a big hit
	- GPS line: coordinates under the name in the overlay
	- blood on the lens after someone is shot right in front of you
	- rain on the lens: the game's own visor drops, shown on the camera with or without a mask

	zbc_bodycam.script calls frame() from actor_on_update and sends the result through its Shader Bus
	lanes (bus_zbc_glitch, bus_zbc_ir, bus_zbc_dirt, bus_zbc_blood, bus_zbc_event in shaders\r3\zbc_lens.h / zbc_osd.h).
]]

local floor, min, max, abs, sqrt, cos, rad = math.floor, math.min, math.max, math.abs, math.sqrt, math.cos, math.rad

local function clamp01(v) return min(max(v, 0), 1) end
-- interference strength: the MCM's 0..1, times the camera tier (Axon Body 1 up to 1.5)
MAX_STRENGTH = 1.5
function clamp_strength(s) return min(max(tonumber(s) or 1, 0), MAX_STRENGTH) end

---------------------------------------------------------------------------------------------------
-- Pure helpers (tested in tools\tests\zbc_fx_test.lua)
---------------------------------------------------------------------------------------------------

-- moves v toward target by at most rate * dt
function approach(v, target, rate, dt)
	local step = rate * dt
	if v < target then return min(v + step, target) end
	return max(v - step, target)
end

-- The game's visor drops are driven for the bodycam while it records with its lens look and
-- "Rain on the lens" on.
function drops_wanted(fx_on, lens_on, lens_rain)
	return (fx_on and lens_on and lens_rain) and true or false
end

-- interference from an anomaly d metres away: full at 1.5 m, nothing past ANOMALY_RANGE
ANOMALY_RANGE = 7
function anomaly_interference(d)
	if not d or d >= ANOMALY_RANGE then return 0 end
	return clamp01((ANOMALY_RANGE - d) / (ANOMALY_RANGE - 1.5)) * 0.6
end

-- interference from psy damage (0 healthy .. 1 none left): a light flicker in a steady psy field,
-- heavy only once psy health is nearly gone
function psy_interference(psy)
	psy = clamp01(tonumber(psy) or 0)
	local deep = clamp01((psy - 0.75) / 0.25)
	return 0.3 * clamp01(psy / 0.5) + 0.6 * deep * deep
end

-- overall interference 0..1 from its sources (each 0..1), times the MCM strength (default 1)
function interference(storm, psy, rad, anomaly, strength)
	local v = max(storm * 0.55, psy_interference(psy), (rad - 0.25) * 0.6, anomaly)
	return clamp01(v * clamp_strength(strength))
end

-- An emission or psy storm builds up: faint when it starts, full STORM_BUILD seconds in.
STORM_BUILD = 40
function storm_level(age)
	if not age or age < 0 then return 0 end
	local x = clamp01(age / STORM_BUILD)
	return 0.35 + 0.65 * x * x * (3 - 2 * x)
end

-- Slow swells (0..1, never twice the same) so a steady source never sits at one flat level.
function swell(t)
	t = tonumber(t) or 0
	return 0.5 + 0.25 * math.sin(t * 1.3) + 0.15 * math.sin(t * 3.1 + 1.7) + 0.1 * math.sin(t * 0.47 + 0.4)
end

-- the interference sent to the shader: the smoothed level, swelling between 0.6x and 1.25x
function interference_out(level, t)
	if level <= 0 then return 0 end
	return clamp01(level * (0.6 + 0.65 * swell(t)))
end

-- Spikes: short random bursts on top of the interference, more often and stronger the more of it
-- there is. r: random 0..1.
function spike_gap(level, r)
	return (2.6 - 2.2 * clamp01(level)) * (0.5 + (r or 0.5))
end

function spike_amp(level, r)
	return clamp01(level * (0.6 + 0.8 * (r or 0.5)))
end

-- one spike's shape: up in 30 ms, then dies away in about a quarter of a second
SPIKE_ATTACK, SPIKE_DECAY, SPIKE_LIFE = 0.03, 0.09, 0.6
function spike_env(age)
	if not age or age < 0 or age >= SPIKE_LIFE then return 0 end
	if age < SPIKE_ATTACK then return age / SPIKE_ATTACK end
	return math.exp(-(age - SPIKE_ATTACK) / SPIKE_DECAY)
end

-- A hard hit breaks the picture up in 2-4 jolts, each weaker than the last. power: hit power;
-- rand(): random 0..1. Returns { {delay, amp}, ... }.
function hit_spikes(power, strength, rand)
	rand = rand or math.random
	local amp = clamp01(clamp01((tonumber(power) or 0) * 1.6) * clamp_strength(strength))
	local out = {}
	if amp <= 0 then return out end
	local n, delay = 2 + floor(rand() * 2.999), 0
	for i = 1, n do
		out[i] = { delay, amp }
		delay = delay + 0.07 + 0.18 * rand()
		amp = amp * (0.55 + 0.2 * rand())
	end
	return out
end

-- the strongest spike at time now; drops spikes that are over. spikes: { {start, amp}, ... }
function spikes_value(spikes, now)
	local v = 0
	for i = #spikes, 1, -1 do
		local s = spikes[i]
		local age = now - s[1]
		if age >= SPIKE_LIFE then
			table.remove(spikes, i)
		else
			v = max(v, s[2] * spike_env(age))
		end
	end
	return clamp01(v)
end

-- How far the blood drips have run: 1 after DRIP_TIME seconds of a still camera, faster while it
-- swings (shake 0..1); they keep running (up to DRIP_MAX) until the blood fades.
DRIP_TIME, DRIP_MAX = 14, 3
function drip_step(p, dt, shake)
	local v = (p or 0) + max(dt or 0, 0) / DRIP_TIME * (1 + 2.5 * clamp01(shake or 0))
	return min(max(v, 0), DRIP_MAX)
end

-- Camera turning, from its view direction last frame and now: shake 0..1 (how fast it swings) and
-- yaw rate (rad/s, + to the right).
function cam_turn(px, py, pz, x, y, z, dt)
	if not (px and x) or not dt or dt <= 0 then return 0, 0 end
	local d = px * x + py * y + pz * z
	local ang = math.acos(min(max(d, -1), 1))
	local yaw = math.atan2(x, z) - math.atan2(px, pz)
	if yaw > math.pi then yaw = yaw - 2 * math.pi elseif yaw < -math.pi then yaw = yaw + 2 * math.pi end
	return clamp01(ang / dt / 3), yaw / dt
end

-- Blood on the lens stacks: every splatter stays until it has faded (BLOOD_LIFE s, the shader's fade)
-- and a new one is added beside it; with BLOOD_SLOTS up, the oldest gives way. Each is {t, drip}.
BLOOD_SLOTS, BLOOD_LIFE = 4, 26
function blood_add(list, now)
	if #list >= BLOOD_SLOTS then table.remove(list, 1) end
	list[#list + 1] = { t = now, drip = 0 }
	return list
end

-- drops the splatters that have faded; runs the drips of the others
function blood_step(list, now, dt, shake)
	for i = #list, 1, -1 do
		local b = list[i]
		if now - b.t >= BLOOD_LIFE then
			table.remove(list, i)
		else
			b.drip = drip_step(b.drip, dt, shake)
		end
	end
	return list
end

-- Compression blocks up while the camera swings, like a real bodycam's encoder. base: the steady
-- amount (the MCM value with the camera tier applied: Body 1 the most, Body 5 the least, Body 4 or no
-- item the MCM value); env: the swing envelope 0..1 (compression_env).
function compression_level(base, env)
	return clamp01((base or 0) * (1 + COMP_BOOST * clamp01(env or 0)))
end

-- The swing envelope: follows how fast the camera turns, building up over ~COMP_ATTACK s and falling
-- back over ~COMP_RELEASE s (exponential, so it eases off and never snaps back to the baseline).
COMP_BOOST, COMP_ATTACK, COMP_RELEASE = 0.8, 0.25, 0.9
function compression_env(env, shake, dt)
	env = clamp01(env or 0)
	dt = max(dt or 0, 0)
	if dt <= 0 then return env end
	local target = clamp01(shake or 0)
	local tau = (target > env) and COMP_ATTACK or COMP_RELEASE
	return env + (target - env) * (1 - math.exp(-dt / tau))
end

-- EVENT blinks: three quick flashes, then a steady 1.25 Hz blink. age: seconds since it was flagged.
function event_blink(age)
	if not age or age < 0 then return false end
	if age < 0.6 then return floor(age / 0.1) % 2 == 0 end
	return ((age - 0.6) % 0.8) < 0.5
end

-- Auto-exposure, like a small camera sensor: the gain the light where you stand needs (luminocity 0..1,
-- the engine's light level on you), reached through a slightly under-damped spring, so stepping from
-- a dark room into daylight blows out for a moment and the picture settles with a small overshoot.
EXP_MID, EXP_MIN, EXP_MAX = 0.42, 0.72, 1.75
EXP_STIFF, EXP_DAMP = 7.0, 3.6
function exposure_target(lum)
	lum = clamp01(tonumber(lum) or 0.5)
	return min(max(EXP_MID / (lum * 0.85 + 0.12), EXP_MIN), EXP_MAX)
end

function exposure_step(g, vel, target, dt)
	dt = min(max(dt or 0, 0), 0.1)
	vel = vel + ((target - g) * EXP_STIFF - vel * EXP_DAMP) * dt
	g = g + vel * dt
	return min(max(g, EXP_MIN * 0.8), EXP_MAX * 1.15), vel
end

local function read_lum_global(actor) return get_object_luminocity(actor) end
local function read_lum_level(actor) return level.get_object_luminocity(actor) end
function light_level(actor)
	for _, f in ipairs({ read_lum_global, read_lum_level }) do
		local ok, v = pcall(f, actor)
		if ok and tonumber(v) then return tonumber(v) end
	end
	return nil
end

-- darkness 0..1 from the light level where you stand: lit above DARK_LIT, fully dark at DARK_FULL
DARK_LIT, DARK_FULL = 0.35, 0.10
function dark_level(lum)
	lum = tonumber(lum)
	if not lum then return 0 end
	return clamp01((DARK_LIT - lum) / (DARK_LIT - DARK_FULL))
end

-- low-light mode wanted? mode: 0 auto, 1 always, 2 off
function night_hours(h)
	h = tonumber(h) or 12
	return h >= 21 or h < 5
end

function ir_target(mode, hour, underground)
	if mode == 1 then return 1 end
	if mode == 2 then return 0 end
	return (underground or night_hours(hour)) and 1 or 0
end

-- levels that are always dark (labs and tunnels)
UNDERGROUND = {
	l03u_agr_underground = true, l04u_labx18 = true, l08u_brainlab = true, l10u_bunker = true,
	l12u_sarcofag = true, l12u_control_monolith = true, l13u_warlab = true, jupiter_underground = true,
	labx8 = true,
}

-- GPS line: the Chernobyl NPP plus the actor's offset on the level, in degrees (1 degree of latitude
-- is 111 320 m). x east, z north.
GPS_LAT, GPS_LON = 51.38912, 30.09921
function gps_text(x, z)
	x, z = tonumber(x) or 0, tonumber(z) or 0
	local lat = GPS_LAT + z / 111320
	local lon = GPS_LON + x / (111320 * cos(rad(GPS_LAT)))
	return string.format("N%.5f E%.5f", lat, lon)
end

---------------------------------------------------------------------------------------------------
-- State
---------------------------------------------------------------------------------------------------

local F = {
	level = 0,           -- smoothed interference from its sources 0..1
	glitch = 0,          -- interference sent to the shader: level with its swells
	burst = 0,           -- random spikes and hit jolts 0..1
	ir = 0,              -- low-light mix 0..1
	dark = 0,            -- how dark it is where you stand 0 (lit) .. 1 (dark), smoothed (tier grain)
	blood = {},          -- splatters on the lens, oldest first: {t = hit time (shader clock), drip}
	blood_t = 0,         -- time of the newest splatter, 0 none
	shake = 0,           -- how fast the camera swings 0..1 (smoothed)
	comp = 0,            -- compression swing envelope 0..1 (compression_env)
	death_t = 0,         -- time of death (seconds, shader clock), 0 alive
	event = false,       -- show EVENT after REC
	event_on = false,    -- ... and it is in the lit part of its blink
}
local event_until, event_t0 = 0, 0
glitch_strength = 1    -- MCM interference strength, kept from the last frame for hit bursts
local next_anom_scan = 0
local anom_near = 0
local spikes, next_spike, storm_t0 = {}, 0, 0
local MAX_SPIKES = 12

function reset()
	F.level, F.glitch, F.burst, F.ir, F.dark = 0, 0, 0, 0, 0
	F.blood, F.blood_t, F.death_t = {}, 0, 0
	F.shake, F.comp, F.cdx, F.cdy, F.cdz = 0, 0, nil, nil, nil
	F.event, F.event_on = false, false
	event_until, event_t0, next_anom_scan, anom_near = 0, 0, 0, 0
	spikes, next_spike, storm_t0 = {}, 0, 0
end

local function add_spike(t, amp)
	if amp <= 0 then return end
	if #spikes >= MAX_SPIKES then table.remove(spikes, 1) end
	spikes[#spikes + 1] = { t, amp }
end

local function now_s() return time_global() / 1000 end

local function read_psy(actor) return actor.psy_health end
local function read_rad(actor) return actor.radiation end

local function read_storm()
	local surge = surge_manager and surge_manager.is_started and surge_manager.is_started()
	local pm = psi_storm_manager and psi_storm_manager.get_psi_storm_manager
		and psi_storm_manager.get_psi_storm_manager()
	return surge or (pm and pm.started)
end

local function storm_active()
	local ok, s = pcall(read_storm)
	return ok and s and true or false
end

-- strongest anomaly interference around the actor (rescanned twice a second)
local function scan_anomalies(actor, now)
	if now < next_anom_scan then return anom_near end
	next_anom_scan = now + 0.5
	local best = 0
	local apos = actor:position()
	for _, a in pairs(db.anomaly_by_name or {}) do
		local obj = a and a.object
		if obj then
			local d = obj:position():distance_to(apos)
			if d < ANOMALY_RANGE then best = max(best, anomaly_interference(d)) end
		end
	end
	anom_near = best
	return best
end

local function underground()
	local n = level and level.name and level.name()
	return n and UNDERGROUND[n] or false
end

-- cfg: zbc_bodycam settings; dt seconds; is_powered: false decays effects while off. Returns the state table (read only).
function frame(cfg, dt, is_powered)
	cfg = cfg or {}
	local actor = db.actor
	local now = now_s()
	if not actor then return F end
	if F.death_t ~= 0 and actor.alive and actor:alive() then F.death_t = 0 end
	dt = min(max(dt or 0, 0), 0.1)
	local on = is_powered ~= false

	-- interference: the level from its sources (a storm builds up), smoothed, then swelling, with
	-- random spikes on top
	local target = 0
	glitch_strength = clamp_strength(cfg.fx_glitch_strength)
	if on and cfg.fx_glitch then
		local storm = storm_active()
		if not storm then storm_t0 = 0 elseif storm_t0 == 0 then storm_t0 = now end
		local ok_p, psy = pcall(read_psy, actor)
		local ok_r, radv = pcall(read_rad, actor)
		target = interference(storm and storm_level(now - storm_t0) or 0,
			1 - clamp01(ok_p and tonumber(psy) or 1),
			clamp01(ok_r and tonumber(radv) or 0),
			scan_anomalies(actor, now), glitch_strength)
	elseif not cfg.fx_glitch then
		spikes, storm_t0 = {}, 0
	end
	F.level = approach(F.level, target, 0.8, dt)
	F.glitch = interference_out(F.level, now)
	if on and cfg.fx_glitch and F.level > 0.05 then
		if next_spike == 0 then
			next_spike = now + spike_gap(F.level, math.random())
		elseif now >= next_spike then
			add_spike(now, spike_amp(F.level, math.random()))
			next_spike = now + spike_gap(F.level, math.random())
		end
	else
		next_spike = 0
	end
	F.burst = spikes_value(spikes, now)

	-- how fast the camera swings: blood drips run faster, compression blocks up
	local dev = device and device()
	local dir = dev and dev.cam_dir
	local shake_now = 0
	if dir then
		shake_now = cam_turn(F.cdx, F.cdy, F.cdz, dir.x, dir.y, dir.z, dt)
		F.cdx, F.cdy, F.cdz = dir.x, dir.y, dir.z
	end
	F.shake = approach(F.shake, shake_now, 3, dt)
	F.comp = compression_env(F.comp, shake_now, dt)
	blood_step(F.blood, now, dt, F.shake)
	if #F.blood == 0 then F.blood_t = 0 end

	-- low light
	local is_ug = underground()
	local ir_goal = 0
	if on then
		local hour = level and level.get_time_hours and level.get_time_hours() or 12
		ir_goal = ir_target(cfg.night_mode or 0, hour, is_ug)
	end
	F.ir = approach(F.ir, ir_goal, 0.7, dt)

	-- how dark it is (the camera tier's low-light grain)
	local lum = light_level(actor)
	if lum then F.dark = approach(F.dark or 0, dark_level(lum), 1.5, dt) end

	-- auto-exposure: follows the light where you stand, lagging and overshooting a little
	if cfg.auto_exposure then
		if lum then
			F.exposure, F.exp_vel = exposure_step(F.exposure or 1, F.exp_vel or 0, exposure_target(lum), dt)
		end
	else
		F.exposure, F.exp_vel = 1, 0
	end

	if not cfg.lens_dirt then F.blood, F.blood_t = {}, 0 end

	F.event = (on and cfg.event_marker and now < event_until) or false
	F.event_on = F.event and event_blink(now - event_t0) or false
	return F
end

---------------------------------------------------------------------------------------------------
-- Callbacks
---------------------------------------------------------------------------------------------------

local function enabled()
	return zbc_bodycam and zbc_bodycam.fx_enabled and zbc_bodycam.fx_enabled()
end

-- shown for 5 s from the last event; the blink starts over only when it was not showing
local function flag_event()
	local now = now_s()
	if now >= event_until then event_t0 = now end
	event_until = now + 5
end

local function actor_on_weapon_fired(obj)
	if obj and db.actor and obj:id() ~= db.actor:id() then return end
	flag_event()
end

local function read_power(shit) return shit.power end

local function actor_on_before_hit(shit)
	local ok, p = pcall(read_power, shit)
	p = ok and tonumber(p) or 0.3
	local now = now_s()
	for _, s in ipairs(hit_spikes(p, glitch_strength)) do add_spike(now + s[1], s[2]) end
	if p >= 0.25 then flag_event() end
end

-- blood on the lens when someone is hit right in front of the camera
local function on_hit_near(victim, amount)
	local actor = db.actor
	if not (actor and victim and enabled() and zbc_bodycam.fx_option("lens_dirt")) then return end
	if (tonumber(amount) or 0) <= 0 then return end
	local dev = device()
	local cam = dev and dev.cam_pos
	local dir = dev and dev.cam_dir
	if not (cam and dir) then return end
	local p = victim:position()
	local dx, dy, dz = p.x - cam.x, p.y + 1.2 - cam.y, p.z - cam.z
	local d = sqrt(dx * dx + dy * dy + dz * dz)
	if d > 2.5 or d < 0.01 then return end
	if (dx * dir.x + dy * dir.y + dz * dir.z) / d < 0.4 then return end
	F.blood_t = now_s()
	blood_add(F.blood, F.blood_t)
end

local function npc_on_hit_callback(npc, amount) on_hit_near(npc, amount) end
local function monster_on_hit_callback(monster, amount) on_hit_near(monster, amount) end

-- Other death screens. While signal lost is on, it is the only death screen: another mod's death
-- handler is taken off actor_on_before_death and only called by us when signal lost does not play
-- (camera off or out of power, or a death another mod cancels, such as a Soulslike respawn).
-- Death Like Romeo (true_first_person_death.script) blacks out the screen, stops time, mutes the game
-- and shows its logo and a quote; its handler is a local, reached through its on_game_start.
OTHER_DEATH_SCREENS = {
	{ script = "true_first_person_death", starter = "on_game_start", handler = "on_actor_before_death" },
}
local taken = {}                                -- script -> its death handler, while we hold it

-- the value of upvalue `name` of function f, or nil
function find_upvalue(f, name)
	if type(f) ~= "function" or not (debug and debug.getupvalue) then return nil end
	local i = 1
	while true do
		local n, v = debug.getupvalue(f, i)
		if n == nil then return nil end
		if n == name then return v end
		i = i + 1
	end
end

local function script_present(name)
	local ok, yes = pcall(function() return getFS():exist("$game_scripts$", name .. ".script") end)
	return ok and yes and true or false
end

-- take (on) or give back (off) the other death screens' handlers
function take_death_screens(on, present)
	present = present or script_present
	for _, d in ipairs(OTHER_DEATH_SCREENS) do
		if on and not taken[d.script] and present(d.script) then
			local m = _G[d.script]
			local h = m and find_upvalue(m[d.starter], d.handler)
			if type(h) == "function" then
				UnregisterScriptCallback("actor_on_before_death", h)
				taken[d.script] = h
				printf("[Zone Bodycam] signal lost replaces the %s death screen", d.script)
			end
		elseif not on and taken[d.script] then
			RegisterScriptCallback("actor_on_before_death", taken[d.script])
			taken[d.script] = nil
		end
	end
end

local function want_signal_lost()
	return zbc_bodycam and zbc_bodycam.fx_option and zbc_bodycam.fx_option("signal_lost") or false
end

local function others_death(who, flags)
	for _, h in pairs(taken) do
		local ok, err = pcall(h, who, flags)
		if not ok then printf("! [Zone Bodycam] death screen handler failed: %s", tostring(err)) end
	end
end

function actor_on_before_death(who, flags)
	if (flags and flags.ret_value == false) or not (enabled() and want_signal_lost()) then
		others_death(who, flags)                -- signal lost does not play: theirs does
		return
	end
	F.death_t = now_s()
	-- signal lost cannot play without the Shader Bus: the death screen we took over plays instead
	if not zbc_bodycam.signal_lost or zbc_bodycam.signal_lost(F.death_t) == false then
		F.death_t = 0
		others_death(who, flags)
	end
end

-- Rain on the lens is the game's own visor drops: level_environment.update_rain_droplets (Dynamic
-- Visor Drops, or the base game) works out the water. That update only runs its drops while a mask
-- is on and the game's rain droplets option is on, so while the bodycam wants drops it is told both
-- are, for the length of the call. With a mask on there is still just the one effect.
-- The engine draws the drops only inside the mask glass pass (r2_mask_control.x > 0, the crack
-- texture index), so with no mask on screen the intact glass (index 1) is switched on too.
local function read_want_drops()
	return drops_wanted(enabled(), zbc_bodycam.fx_option("lens_enabled"), zbc_bodycam.fx_option("lens_rain"))
end

local function want_drops()
	local ok, yes = pcall(read_want_drops)
	return ok and yes or false
end

local function mask_always_on() return true end

local drops_hook
local function hook_visor_drops()
	local le = level_environment
	if not (le and type(le.update_rain_droplets) == "function") or le.update_rain_droplets == drops_hook then return end
	local original = le.update_rain_droplets
	drops_hook = function(...)
		local ae = actor_effects
		if not (ae and want_drops()) then return original(...) end
		local mask_on, droplets_opt = ae.is_mask_on, le.effects_droplets_enabled
		ae.is_mask_on, le.effects_droplets_enabled = mask_always_on, true
		local res = { pcall(original, ...) }
		ae.is_mask_on, le.effects_droplets_enabled = mask_on, droplets_opt
		if not res[1] then error(res[2], 0) end
		return unpack(res, 2, table.maxn(res))
	end
	le.update_rain_droplets = drops_hook
end

-- The mask-wipe key (cam_zoom_in, T by default) wipes the drops. With a mask on the game's own
-- handler plays the hand animation and wipes in step with it; without one (or with the Mask HUD
-- option off, when the game never sees a mask) the visor drops' own wipe runs instead.
local function read_mask_on() return actor_effects.is_mask_on() end

-- The game's mask-wipe hand animation (FDDA's, or the base one) checks for a mask only as it
-- starts, and wipes the drops in step with the hand; told a mask is on for that call, it plays
-- for the camera too. Returns true once a wipe is under way (actor_effects.mc_anm_state > 0).
local function wiping(ae) return (tonumber(ae.mc_anm_state) or 0) > 0 end

local function play_wipe_anim()
	local ae = actor_effects
	if not (ae and type(ae.Hit_MaskCleaning) == "function" and type(ae.is_mask_on) == "function") then return false end
	if wiping(ae) then return true end
	local mask_on = ae.is_mask_on
	ae.is_mask_on = mask_always_on
	pcall(ae.Hit_MaskCleaning)
	ae.is_mask_on = mask_on
	return wiping(ae)
end

function wipe_drops()
	if not want_drops() then return false end
	local ok, mask = pcall(read_mask_on)
	if ok and mask then return false end
	if play_wipe_anim() then return true end
	local le = level_environment   -- no animation possible right now: just wipe the drops
	if not (le and type(le.droplets_reset) == "function") then return false end
	pcall(le.droplets_reset)
	return true
end

local function on_key_release(key)
	if key_bindings and dik_to_bind and dik_to_bind(key) == key_bindings.kCAM_ZOOM_IN then wipe_drops() end
end

-- The mask glass pass for the drops: on while drops are wanted and no mask is on screen, sent again
-- every GLASS_REFRESH ms in case another script reset it; off again only if no mask took over.
GLASS_ON, GLASS_OFF, GLASS_REFRESH = "r2_mask_control 1,0,0,0", "r2_mask_control 0,0,0,0", 1000
function glass_needed(want, mask_on)
	return (want and not mask_on) and true or false
end

local glass_set, glass_next = false, 0
local function mask_on_screen()
	local ok, mask = pcall(read_mask_on)
	return ok and mask and true or false
end

local function send_cmd(cmd)
	return exec_console_cmd and pcall(exec_console_cmd, cmd) or false
end

local function update_glass()
	local mask = mask_on_screen()
	if glass_needed(want_drops(), mask) then
		local now = time_global()
		if (not glass_set or now >= glass_next) and send_cmd(GLASS_ON) then
			glass_set, glass_next = true, now + GLASS_REFRESH
		end
	elseif glass_set then
		glass_set = false
		if not mask then send_cmd(GLASS_OFF) end
	end
end

local function glass_off()
	if glass_set and not mask_on_screen() then send_cmd(GLASS_OFF) end
	glass_set, glass_next = false, 0
end

-- Other droplet mods (Dynamic Smoother Droplets) swap the drops update in on game load, whichever
-- order the callbacks run; wrap whatever version is in place, again if it changes.
local function actor_on_update()
	local le = level_environment
	if le and drops_hook and le.update_rain_droplets ~= drops_hook then pcall(hook_visor_drops) end
	update_glass()
end

local function actor_on_net_destroy()
	glass_off()
	reset()
end

local function actor_on_first_update()
	reset()
	pcall(hook_visor_drops)
	local ok, err = pcall(take_death_screens, want_signal_lost())
	if not ok then printf("! [Zone Bodycam] could not take over the death screen: %s", tostring(err)) end
end

local function on_option_change()
	if db.actor then pcall(take_death_screens, want_signal_lost()) end
end

function on_game_start()
	RegisterScriptCallback("actor_on_first_update", actor_on_first_update)
	RegisterScriptCallback("actor_on_net_destroy", actor_on_net_destroy)
	RegisterScriptCallback("actor_on_weapon_fired", actor_on_weapon_fired)
	RegisterScriptCallback("actor_on_before_hit", actor_on_before_hit)
	RegisterScriptCallback("npc_on_hit_callback", npc_on_hit_callback)
	RegisterScriptCallback("monster_on_hit_callback", monster_on_hit_callback)
	RegisterScriptCallback("actor_on_before_death", actor_on_before_death)
	RegisterScriptCallback("on_key_release", on_key_release)
	RegisterScriptCallback("actor_on_update", actor_on_update)
	RegisterScriptCallback("on_option_change", on_option_change)
end
