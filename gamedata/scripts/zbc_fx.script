--[[
	Zone Bodycam - camera effects state (zbc_fx.script)

	Works out, every frame, the values the post shader needs for:
	- interference: the picture tears and breaks up in emissions and psy storms, in psy fields, in
	  strong radiation, next to anomalies, and in short bursts when you are hit hard
	- signal lost: when you die the feed glitches, cuts to black and shows "SIGNAL LOST" over the
	  last timestamp (started from the death callback, then timed by the shader itself)
	- low-light mode: a grainy, nearly black-and-white infrared look at night and underground
	- event marker: "EVENT" after REC for a few seconds after you fire or take a big hit
	- GPS line: coordinates under the name in the overlay
	- lens dirt: rain drops while it rains, blood after someone is shot right in front of you

	zbc_bodycam.script calls frame() from actor_on_update and sends the result through its Shader Bus
	lanes (bus_zbc_glitch, bus_zbc_ir, bus_zbc_dirt, bus_zbc_event in shaders\r3\zbc_lens.h / zbc_osd.h).
]]

local floor, min, max, abs, sqrt, cos, rad, exp = math.floor, math.min, math.max, math.abs, math.sqrt, math.cos, math.rad, math.exp

local function clamp01(v) return min(max(v, 0), 1) end

---------------------------------------------------------------------------------------------------
-- Pure helpers (tested in tools\tests\zbc_fx_test.lua)
---------------------------------------------------------------------------------------------------

-- moves v toward target by at most rate * dt
function approach(v, target, rate, dt)
	local step = rate * dt
	if v < target then return min(v + step, target) end
	return max(v - step, target)
end

-- Rain on the lens, timed like the Dynamic Visor Drops mod: while rain reaches the lens the water
-- (0..rain strength) quickly gets a first scattering of drops, then builds slowly; otherwise it
-- dries exponentially. The shader shows more drops the more water there is.
RAIN_FIRST, RAIN_FIRST_RATE, RAIN_BUILD_RATE, RAIN_DRY_TAU = 0.18, 0.5, 0.03, 18
RAIN_LIFE = 4   -- seconds a sliding drop takes to run off the lens (ZBC_RAIN_LIFE in zbc_lens.h)
function lens_water(water, rain, exposed, dt)
	local target = exposed and clamp01(rain or 0) or 0
	if water < target then
		local rate = (water < RAIN_FIRST * target) and RAIN_FIRST_RATE or RAIN_BUILD_RATE
		return min(water + rate * dt, target)
	end
	water = target + (water - target) * exp(-dt / RAIN_DRY_TAU)
	if water < 0.002 and target == 0 then water = 0 end
	return water
end

-- Arrivals marker for the shader (bus_zbc_dirt.w): 0 while it rains on the lens; +t once covered at
-- shader time t (drops already sliding finish their run, no new ones fall); -t once uncovered at t
-- (drops that would be mid-run stay hidden until they start afresh), back to 0 after one drop life.
function rain_mark(mark, exposed, now)
	now = max(now or 0, 0.001)
	if exposed then
		if mark > 0 then return -now end
		if mark < 0 and now + mark >= RAIN_LIFE then return 0 end
		return mark
	end
	if mark <= 0 then return now end
	return mark
end

-- Wiping the lens (the mask-wipe key): a hand pass sweeps the drops off left to right over
-- WIPE_TIME seconds (the shader draws the sweep from F.wipe_t), then the lens is clean and only
-- drops that start falling afterwards show. Returns water, mark, wipe_t.
WIPE_TIME = 0.6
function lens_wipe(water, mark, wipe_t, now)
	if wipe_t > 0 and now >= wipe_t + WIPE_TIME then
		return 0, -max(now, 0.001), 0
	end
	return water, mark, wipe_t
end

-- Our lens drops are left out while a mask whose visor shows its own rain is worn
-- (visor_rain: mask on and the game's rain droplets option on, as the visor drops mods check).
function lens_rain_allowed(lens_rain, visor_rain)
	return (lens_rain and not visor_rain) and true or false
end

-- interference from an anomaly d metres away: full at 1.5 m, nothing past ANOMALY_RANGE
ANOMALY_RANGE = 7
function anomaly_interference(d)
	if not d or d >= ANOMALY_RANGE then return 0 end
	return clamp01((ANOMALY_RANGE - d) / (ANOMALY_RANGE - 1.5)) * 0.6
end

-- overall interference 0..1 from its sources (each 0..1)
function interference(storm, psy, rad, anomaly)
	local v = max(storm * 0.55, psy * 0.9, (rad - 0.25) * 0.6, anomaly)
	return clamp01(v)
end

-- Auto-exposure, like a small camera sensor: the gain the light where you stand needs (luminocity 0..1,
-- the engine's light level on you), reached through a slightly under-damped spring, so stepping from
-- a dark room into daylight blows out for a moment and the picture settles with a small overshoot.
EXP_MID, EXP_MIN, EXP_MAX = 0.42, 0.72, 1.75
EXP_STIFF, EXP_DAMP = 7.0, 3.6
function exposure_target(lum)
	lum = clamp01(tonumber(lum) or 0.5)
	return min(max(EXP_MID / (lum * 0.85 + 0.12), EXP_MIN), EXP_MAX)
end

function exposure_step(g, vel, target, dt)
	dt = min(max(dt or 0, 0), 0.1)
	vel = vel + ((target - g) * EXP_STIFF - vel * EXP_DAMP) * dt
	g = g + vel * dt
	return min(max(g, EXP_MIN * 0.8), EXP_MAX * 1.15), vel
end

local function read_lum_global(actor) return get_object_luminocity(actor) end
local function read_lum_level(actor) return level.get_object_luminocity(actor) end
function light_level(actor)
	for _, f in ipairs({ read_lum_global, read_lum_level }) do
		local ok, v = pcall(f, actor)
		if ok and tonumber(v) then return tonumber(v) end
	end
	return nil
end

-- low-light mode wanted? mode: 0 auto, 1 always, 2 off
function night_hours(h)
	h = tonumber(h) or 12
	return h >= 21 or h < 5
end

function ir_target(mode, hour, underground)
	if mode == 1 then return 1 end
	if mode == 2 then return 0 end
	return (underground or night_hours(hour)) and 1 or 0
end

-- levels that are always dark (labs and tunnels)
UNDERGROUND = {
	l03u_agr_underground = true, l04u_labx18 = true, l08u_brainlab = true, l10u_bunker = true,
	l12u_sarcofag = true, l12u_control_monolith = true, l13u_warlab = true, jupiter_underground = true,
	labx8 = true,
}

-- GPS line: the Chernobyl NPP plus the actor's offset on the level, in degrees (1 degree of latitude
-- is 111 320 m). x east, z north.
GPS_LAT, GPS_LON = 51.38912, 30.09921
function gps_text(x, z)
	x, z = tonumber(x) or 0, tonumber(z) or 0
	local lat = GPS_LAT + z / 111320
	local lon = GPS_LON + x / (111320 * cos(rad(GPS_LAT)))
	return string.format("N%.5f E%.5f", lat, lon)
end

---------------------------------------------------------------------------------------------------
-- State
---------------------------------------------------------------------------------------------------

local F = {
	glitch = 0,          -- smoothed interference 0..1
	burst = 0,           -- short hit burst 0..1, decays
	ir = 0,              -- low-light mix 0..1
	wet = 0,             -- rain on the lens 0..1
	rain_mark = 0,       -- arrivals marker, see rain_mark()
	wipe_t = 0,          -- time a lens wipe started (seconds, shader clock), 0 none
	blood_t = 0,         -- time the last blood splatter hit the lens (seconds, shader clock), 0 none
	blood_seed = 0,
	death_t = 0,         -- time of death (seconds, shader clock), 0 alive
	event = false,       -- show EVENT after REC
}
local event_until = 0
local next_anom_scan = 0
local anom_near = 0

function reset()
	F.glitch, F.burst, F.ir, F.wet, F.rain_mark, F.wipe_t = 0, 0, 0, 0, 0, 0
	F.blood_t, F.blood_seed, F.death_t = 0, 0, 0
	F.event = false
	event_until, next_anom_scan, anom_near = 0, 0, 0
end

local function now_s() return time_global() / 1000 end

local function read_psy(actor) return actor.psy_health end
local function read_rad(actor) return actor.radiation end

local function read_storm()
	local surge = surge_manager and surge_manager.is_started and surge_manager.is_started()
	local pm = psi_storm_manager and psi_storm_manager.get_psi_storm_manager
		and psi_storm_manager.get_psi_storm_manager()
	return surge or (pm and pm.started)
end

local function storm_active()
	local ok, s = pcall(read_storm)
	return ok and s and true or false
end

-- strongest anomaly interference around the actor (rescanned twice a second)
local function scan_anomalies(actor, now)
	if now < next_anom_scan then return anom_near end
	next_anom_scan = now + 0.5
	local best = 0
	local apos = actor:position()
	for _, a in pairs(db.anomaly_by_name or {}) do
		local obj = a and a.object
		if obj then
			local d = obj:position():distance_to(apos)
			if d < ANOMALY_RANGE then best = max(best, anomaly_interference(d)) end
		end
	end
	anom_near = best
	return best
end

local function underground()
	local n = level and level.name and level.name()
	return n and UNDERGROUND[n] or false
end

-- under a roof or in safe cover: no rain reaches the lens (same checks as the visor drops mods)
local function read_cover()
	if GetEvent and GetEvent("current_safe_cover") then return true end
	return level.rain_hemi and level.rain_hemi() <= 0.15 or false
end

-- a worn mask draws its own rain on the visor (actor_effects HUD mask + game rain droplets option)
local function read_visor_rain()
	if not (actor_effects and actor_effects.is_mask_on and actor_effects.is_mask_on()) then return false end
	local opt = ui_options and ui_options.get and ui_options.get("video/player/rain_droplets")
	return opt ~= false
end

local function visor_rain()
	local ok, on = pcall(read_visor_rain)
	return ok and on or false
end

-- rain only lands on the lens when the camera is not under cover or pointed steeply down
local function rain_reaches_lens()
	local ok, covered = pcall(read_cover)
	if ok and covered then return false end
	local dev = device and device()
	local dir = dev and dev.cam_dir
	return not (dir and dir.y < -0.866)
end

-- cfg: zbc_bodycam settings; dt seconds; is_powered: false decays effects while off. Returns the state table (read only).
function frame(cfg, dt, is_powered)
	cfg = cfg or {}
	local actor = db.actor
	local now = now_s()
	if not actor then return F end
	if F.death_t ~= 0 and actor.alive and actor:alive() then F.death_t = 0 end
	dt = min(max(dt or 0, 0), 0.1)
	local on = is_powered ~= false

	-- interference
	local target = 0
	if on and cfg.fx_glitch then
		local ok_p, psy = pcall(read_psy, actor)
		local ok_r, radv = pcall(read_rad, actor)
		target = interference(storm_active() and 1 or 0,
			1 - clamp01(ok_p and tonumber(psy) or 1),
			clamp01(ok_r and tonumber(radv) or 0),
			scan_anomalies(actor, now))
	elseif not cfg.fx_glitch then
		F.burst = 0
	end
	F.glitch = approach(F.glitch, target, 0.8, dt)
	F.burst = approach(F.burst, 0, 2.5, dt)

	-- low light
	local is_ug = underground()
	local ir_goal = 0
	if on then
		local hour = level and level.get_time_hours and level.get_time_hours() or 12
		ir_goal = ir_target(cfg.night_mode or 0, hour, is_ug)
	end
	F.ir = approach(F.ir, ir_goal, 0.7, dt)

	-- auto-exposure: follows the light where you stand, lagging and overshooting a little
	if cfg.auto_exposure then
		local lum = light_level(actor)
		if lum then
			F.exposure, F.exp_vel = exposure_step(F.exposure or 1, F.exp_vel or 0, exposure_target(lum), dt)
		end
	else
		F.exposure, F.exp_vel = 1, 0
	end

	-- rain on the lens: builds up while rain reaches it, dries slowly otherwise
	local rain = 0
	if cfg.lens_rain and not is_ug and level and level.rain_factor then
		rain = clamp01(tonumber(level.rain_factor()) or 0)
	end
	if not lens_rain_allowed(cfg.lens_rain, visor_rain()) then
		F.wet, F.rain_mark, F.wipe_t = 0, 0, 0
	elseif F.wipe_t > 0 then
		F.wet, F.rain_mark, F.wipe_t = lens_wipe(F.wet, F.rain_mark, F.wipe_t, now)
	else
		local exposed = rain > 0.001 and rain_reaches_lens()
		F.wet = lens_water(F.wet, rain, exposed, dt)
		F.rain_mark = rain_mark(F.rain_mark, exposed, now)
	end
	if not cfg.lens_dirt then F.blood_t = 0 end

	F.event = (on and cfg.event_marker and now < event_until) or false
	return F
end

---------------------------------------------------------------------------------------------------
-- Callbacks
---------------------------------------------------------------------------------------------------

local function enabled()
	return zbc_bodycam and zbc_bodycam.fx_enabled and zbc_bodycam.fx_enabled()
end

local function flag_event()
	event_until = now_s() + 5
end

local function actor_on_weapon_fired(obj)
	if obj and db.actor and obj:id() ~= db.actor:id() then return end
	flag_event()
end

local function read_power(shit) return shit.power end

local function actor_on_before_hit(shit)
	local ok, p = pcall(read_power, shit)
	p = ok and tonumber(p) or 0.3
	F.burst = max(F.burst, clamp01(p * 1.6))
	if p >= 0.25 then flag_event() end
end

-- blood on the lens when someone is hit right in front of the camera
local function on_hit_near(victim, amount)
	local actor = db.actor
	if not (actor and victim and enabled() and zbc_bodycam.fx_option("lens_dirt")) then return end
	if (tonumber(amount) or 0) <= 0 then return end
	local dev = device()
	local cam = dev and dev.cam_pos
	local dir = dev and dev.cam_dir
	if not (cam and dir) then return end
	local p = victim:position()
	local dx, dy, dz = p.x - cam.x, p.y + 1.2 - cam.y, p.z - cam.z
	local d = sqrt(dx * dx + dy * dy + dz * dz)
	if d > 2.5 or d < 0.01 then return end
	if (dx * dir.x + dy * dir.y + dz * dir.z) / d < 0.4 then return end
	F.blood_t = now_s()
	F.blood_seed = math.random(1, 997)
end

local function npc_on_hit_callback(npc, amount) on_hit_near(npc, amount) end
local function monster_on_hit_callback(monster, amount) on_hit_near(monster, amount) end

function actor_on_before_death(who, flags)
	if flags and flags.ret_value == false then return end
	if not (enabled() and zbc_bodycam.fx_option("signal_lost")) then return end
	F.death_t = now_s()
	if zbc_bodycam.signal_lost then zbc_bodycam.signal_lost(F.death_t) end
end

-- the mask-wipe key also wipes the camera lens, with or without a mask on
function wipe_lens()
	if F.wet > 0.002 and F.wipe_t == 0 then F.wipe_t = max(now_s(), 0.001) end
end

-- Hook the game's mask-wipe handler (actor_effects.Hit_MaskCleaning, called by its wipe key, and
-- replaced by FDDA / visor drops mods while scripts load), so one press wipes both and the key
-- binding stays theirs. Done on the first update, after every script has installed its version.
local wipe_hook
local function hook_mask_wipe()
	local ae = actor_effects
	if not (ae and type(ae.Hit_MaskCleaning) == "function") or ae.Hit_MaskCleaning == wipe_hook then return end
	local original = ae.Hit_MaskCleaning
	wipe_hook = function(...)
		wipe_lens()
		return original(...)
	end
	ae.Hit_MaskCleaning = wipe_hook
end

-- The wipe key itself (cam_zoom_in, T by default) wipes the lens too, so it still works when the
-- game's handler gives up (Mask HUD option off: it never sees a mask) or a mod swaps it out later.
-- Both paths may fire on one press; wipe_lens ignores the second while the sweep runs.
local function on_key_release(key)
	if key_bindings and dik_to_bind and dik_to_bind(key) == key_bindings.kCAM_ZOOM_IN then wipe_lens() end
end

local function actor_on_first_update()
	reset()
	pcall(hook_mask_wipe)
end

function on_game_start()
	RegisterScriptCallback("actor_on_first_update", actor_on_first_update)
	RegisterScriptCallback("actor_on_net_destroy", reset)
	RegisterScriptCallback("actor_on_weapon_fired", actor_on_weapon_fired)
	RegisterScriptCallback("actor_on_before_hit", actor_on_before_hit)
	RegisterScriptCallback("npc_on_hit_callback", npc_on_hit_callback)
	RegisterScriptCallback("monster_on_hit_callback", monster_on_hit_callback)
	RegisterScriptCallback("actor_on_before_death", actor_on_before_death)
	RegisterScriptCallback("on_key_release", on_key_release)
end
