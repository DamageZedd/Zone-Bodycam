--[[
	Zone Bodycam - MCM menu. Values are read by zbc_bodycam.script (defaults live there).
]]

local function d(id) return zbc_bodycam and zbc_bodycam.defaults and zbc_bodycam.defaults[id] end

function on_mcm_load()
	local colors = { { 0, "White" }, { 1, "Green" }, { 2, "Cyan" }, { 3, "Blue" }, { 4, "Yellow" },
		{ 5, "Red" }, { 6, "Purple" }, { 7, "None (hide)" } }
	return {
		id = "zone_bodycam", sh = true,
		gr = {
			{ id = "title",          type = "title", text = "ui_mcm_zone_bodycam_title", align = "c" },
			{ id = "enabled",        type = "check", val = 1, def = d("enabled") },

			{ id = "hdr_lens",       type = "line" },
			{ id = "lens_enabled",   type = "check", val = 1, def = d("lens_enabled") },
			{ id = "intensity",      type = "track", val = 2, min = 0,    max = 1,    step = 0.05,  def = d("intensity") },
			{ id = "distortion",     type = "track", val = 2, min = 0,    max = 0.8,  step = 0.02,  def = d("distortion") },
			{ id = "zoom",           type = "track", val = 2, min = 1,    max = 1.5,  step = 0.01,  def = d("zoom") },
			{ id = "aberration",     type = "track", val = 2, min = 0,    max = 1,    step = 0.05,  def = d("aberration") },
			{ id = "sharpen",        type = "track", val = 2, min = 0,    max = 1,    step = 0.05,  def = d("sharpen") },
			{ id = "edge_soft_blur", type = "track", val = 2, min = 0,    max = 1,    step = 0.05,  def = d("edge_soft_blur") },
			{ id = "edge_radius",    type = "track", val = 2, min = 0.4,  max = 1.35, step = 0.005, def = d("edge_radius") },
			{ id = "edge_shape",     type = "track", val = 2, min = 0,    max = 1,    step = 0.05,  def = d("edge_shape") },
			{ id = "housing_roundness", type = "track", val = 2, min = 0, max = 1,    step = 0.05,  def = d("housing_roundness") },
			{ id = "edge_softness",  type = "track", val = 2, min = 0.01, max = 0.5,  step = 0.01,  def = d("edge_softness") },
			{ id = "vignette",       type = "track", val = 2, min = 0,    max = 1,    step = 0.05,  def = d("vignette") },
			{ id = "rig_occlusion",  type = "track", val = 2, min = 0,    max = 1.5,  step = 0.05,  def = d("rig_occlusion") },
			{ id = "edge_follow",    type = "track", val = 2, min = 0,    max = 3,    step = 0.1,   def = d("edge_follow") },
			{ id = "edge_in_image",  type = "check", val = 1, def = d("edge_in_image") },
			{ id = "grain",          type = "track", val = 2, min = 0,    max = 1,    step = 0.05,  def = d("grain") },
			{ id = "sensor_grade",   type = "track", val = 2, min = 0,    max = 1,    step = 0.05,  def = d("sensor_grade") },
			{ id = "highlight_blowout", type = "track", val = 2, min = 0, max = 1,    step = 0.05,  def = d("highlight_blowout") },
			{ id = "compression",    type = "track", val = 2, min = 0,    max = 1,    step = 0.05,  def = d("compression") },
			{ id = "rolling_shutter", type = "track", val = 2, min = 0,   max = 1.5,  step = 0.05,  def = d("rolling_shutter") },

			{ id = "hdr_motion",     type = "line" },
			{ id = "motion",         type = "track", val = 2, min = 0,    max = 2,    step = 0.05,  def = d("motion") },
			{ id = "turn_lag",       type = "track", val = 2, min = 0,    max = 2,    step = 0.05,  def = d("turn_lag") },
			{ id = "turn_invert",    type = "check", val = 1, def = d("turn_invert") },
			{ id = "walk_bob",       type = "track", val = 2, min = 0,    max = 2,    step = 0.05,  def = d("walk_bob") },
			{ id = "roll",           type = "track", val = 2, min = 0,    max = 2,    step = 0.05,  def = d("roll") },
			{ id = "impacts",        type = "track", val = 2, min = 0,    max = 2,    step = 0.05,  def = d("impacts") },
			{ id = "breathing",      type = "track", val = 2, min = 0,    max = 2,    step = 0.05,  def = d("breathing") },

			{ id = "hdr_overlay",    type = "line" },
			{ id = "overlay",        type = "check", val = 1, def = d("overlay") },
			{ id = "device_label",   type = "input", val = 0, def = d("device_label") },
			{ id = "show_name",      type = "check", val = 1, def = d("show_name") },
			{ id = "logo_style",     type = "list",  val = 2, def = d("logo_style"), no_str = true,
				content = { { 0, "Official logo" }, { 1, "Swirl triangle (drawn)" }, { 2, "Plain triangle (drawn)" }, { 3, "None" } } },
			{ id = "timezone",       type = "list",  val = 2, def = d("timezone"), no_str = true,
				content = { { 0, "Zone time (+0200, +0300 in summer)" }, { 1, "UTC (+0000)" } } },
			{ id = "iso_t",          type = "check", val = 1, def = d("iso_t") },
			{ id = "font_size",      type = "list",  val = 2, def = d("font_size"), no_str = true,
				content = { { 0, "Small" }, { 1, "Real overlay size" }, { 2, "Large" } } },
			{ id = "text_opacity",   type = "track", val = 2, min = 0.2,  max = 1,    step = 0.05,  def = d("text_opacity") },
			{ id = "logo_opacity",   type = "track", val = 2, min = 0.2,  max = 1,    step = 0.05,  def = d("logo_opacity") },

			{ id = "hdr_allies",     type = "line" },
			{ id = "allies",         type = "check", val = 1, def = d("allies") },
			{ id = "allies_los",     type = "check", val = 1, def = d("allies_los") },
			{ id = "allies_style",   type = "list",  val = 2, def = d("allies_style"), no_str = true,
				content = { { 0, "Corner brackets" }, { 1, "Full box" } } },
			{ id = "allies_color_neutral",   type = "list", val = 2, def = d("allies_color_neutral"),   no_str = true, content = colors },
			{ id = "allies_color_companion", type = "list", val = 2, def = d("allies_color_companion"), no_str = true, content = colors },
			{ id = "allies_range",     type = "track", val = 2, min = 5,    max = 100,  step = 1,     def = d("allies_range") },
			{ id = "allies_dot_ratio", type = "track", val = 2, min = 0,    max = 1,    step = 0.05,  def = d("allies_dot_ratio") },
			{ id = "allies_size",      type = "track", val = 2, min = 0.5,  max = 2,    step = 0.05,  def = d("allies_size") },
			{ id = "allies_opacity",   type = "track", val = 2, min = 0.2,  max = 1,    step = 0.05,  def = d("allies_opacity") },
		},
	}
end
