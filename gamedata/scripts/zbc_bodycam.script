-- Overlay text
---------------------------------------------------------------------------------------------------

-- day of week, 0 = Sunday (Sakamoto)
local DOW_T = { 0, 3, 2, 5, 0, 3, 5, 1, 4, 6, 2, 4 }
local function dow(y, m, d)
	if m < 3 then y = y - 1 end
	return (y + floor(y / 4) - floor(y / 100) + floor(y / 400) + DOW_T[m] + d) % 7
end

local function last_sunday(y, m)
	local d = 31
	while dow(y, m, d) ~= 0 do d = d - 1 end
	return d
end

-- Ukraine: EET +2, EEST +3 from the last Sunday of March 03:00 to the last Sunday of October 04:00
local function zone_offset(Y, M, D, h)
	if M > 3 and M < 10 then return 3 end
	if M == 3 then
		local ls = last_sunday(Y, 3)
		return (D > ls or (D == ls and h >= 3)) and 3 or 2
	end
	if M == 10 then
		local ls = last_sunday(Y, 10)
		return (D < ls or (D == ls and h < 4)) and 3 or 2
	end
	return 2
end

local DAYS_IN = { 31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31 }
local function days_in(y, m)
	if m == 2 and ((y % 4 == 0 and y % 100 ~= 0) or y % 400 == 0) then return 29 end
	return DAYS_IN[m]
end

-- shift a date/time by whole hours (for UTC)
local function add_hours(Y, M, D, h, dh)
	h = h + dh
	while h < 0 do
		h = h + 24 ; D = D - 1
		if D < 1 then M = M - 1 ; if M < 1 then M = 12 ; Y = Y - 1 end ; D = days_in(Y, M) end
	end
	while h > 23 do
		h = h - 24 ; D = D + 1
		if D > days_in(Y, M) then D = 1 ; M = M + 1 ; if M > 12 then M = 1 ; Y = Y + 1 end end
	end
	return Y, M, D, h
end

local d_Y, d_M, d_D, d_h, d_mi, d_s, d_tz, d_iso, d_str

local function date_line()
	local Y, M, D, h, mi, s = game.get_game_time():get()
	Y, M, D = tonumber(Y) or 2012, tonumber(M) or 1, tonumber(D) or 1
	h, mi, s = tonumber(h) or 0, tonumber(mi) or 0, tonumber(s) or 0
	local tz_cfg = cfg.timezone
	local iso = (cfg.iso_t == true)
	if d_str and Y == d_Y and M == d_M and D == d_D
		and h == d_h and mi == d_mi and s == d_s
		and tz_cfg == d_tz and iso == d_iso then
		return d_str, d_s
	end
	d_Y, d_M, d_D, d_h, d_mi, d_s, d_tz, d_iso = Y, M, D, h, mi, s, tz_cfg, iso
	local oY, oM, oD, oh = Y, M, D, h
	local tz
	if tz_cfg == 1 then
		oY, oM, oD, oh = add_hours(oY, oM, oD, oh, -zone_offset(oY, oM, oD, oh))
		tz = "+0000"
	else
		tz = string.format("+%02d00", zone_offset(oY, oM, oD, oh))
	end
	d_str = string.format("%04d-%02d-%02d %s%02d:%02d:%02d %s", oY, oM, oD, iso and "T" or "", oh, mi, s, tz)
	return d_str, s
end

local function read_actor_name() return db.actor and db.actor:character_name() end

local function actor_name()
	local ok, name = pcall(read_actor_name)
	if ok and type(name) == "string" then return name end
	return ""
end

-- stable per character, in the style of a bodycam serial
local SERIAL_CHARS = "0123456789ABCDEFGHJKLMNPRSTUVWXYZ"
local cached_raw_name, cached_serial, cached_upper_name
local cached_dev_in, cached_dev_line

local function serial_for(name)
	if name == cached_raw_name and cached_serial then return cached_serial end
	local h = 5381
	for i = 1, #name do h = (h * 33 + string.byte(name, i)) % 2147483647 end
	local out = ""
	for _ = 1, 4 do
		local k = h % #SERIAL_CHARS
		out = out .. SERIAL_CHARS:sub(k + 1, k + 1)
		h = floor(h / #SERIAL_CHARS)
	end
	cached_raw_name = name
	cached_serial = "X6039" .. out
	cached_upper_name = (zbc_allies and zbc_allies.upper_cp1251) and zbc_allies.upper_cp1251(name) or string.upper(name)
	cached_dev_in = nil
	return cached_serial
end

local function actor_ident(dev_label)
	local name = actor_name()
	local ser = serial_for(name)
	if dev_label ~= cached_dev_in or not cached_dev_line then
		cached_dev_in = dev_label
		cached_dev_line = dev_label .. " " .. ser
	end
	return cached_dev_line, cached_upper_name
end

---------------------------------------------------------------------------------------------------
-- HUD
---------------------------------------------------------------------------------------------------

-- Overlay text is drawn from a glyph atlas (textures\ui\zbc_font.dds, built by tools\make_overlay_assets.py
-- from the overlay font), one HUD quad per character. The engine can only load its own fixed fonts.
local F = zbc_font_metrics
local MAX_CHARS = 40
local FONT_VW = { [0] = 1.0, [1] = 1.2, [2] = 1.4 }    -- the real overlay is 1.2vw
local REC_CHARS = 22                                    -- "REC 999:59:59 EVENT"
-- recording timer geometry in em, shared with shaders\r3\zbc_osd.h (keep in step)
local REC_DOT_D   = 1.06   -- dot square (the red core is 66% of it: about the capital height)
local REC_DOT_CY  = 0.56   -- dot centre below the line top (middle of the capitals)
local REC_GAP     = 0.15   -- space between the dot square and the text
-- VHS battery gauge above the dot, in em (shaders\r3\zbc_batt.h, keep in step)
local BATT_W      = 1.90   -- body 1.75 + terminal nub 0.15
local BATT_H      = 0.90
local BATT_ABOVE  = 0.22   -- gap between the gauge and the top of the dot square

local osd_char_rows = nil

-- Pack up to 4 lines x 40 Windows-1251 bytes into 41 uint4 rows for bus_zbc_osd_chars
-- (row 0: the four lengths; then 10 rows of 4 characters per line).
local OSD_LINES = 4
local function upload_osd_chars(s1, s2, s3, s4)
	if not (bus_ready() and supports_uint_bus() and tokens.osd_chars) then return end
	if not osd_char_rows then
		osd_char_rows = {}
		for r = 1, 1 + OSD_LINES * 10 do osd_char_rows[r] = { 0, 0, 0, 0 } end
	end
	local strs = { s1 or "", s2 or "", s3 or "", s4 or "" }
	local r0 = osd_char_rows[1]
	for i = 1, OSD_LINES do r0[i] = min(#strs[i], MAX_CHARS) end
	for i = 0, OSD_LINES - 1 do
		local str = strs[i + 1]
		local len = r0[i + 1]
		local base = 2 + i * 10
		for row_off = 0, 9 do
			local row = osd_char_rows[base + row_off]
			local c0 = row_off * 4
			for comp = 1, 4 do
				local c = c0 + comp
				row[comp] = (c <= len) and string.byte(str, c) or 0
			end
		end
	end
	shader_bus.set_array_uint(tokens.osd_chars, 0, osd_char_rows)
end

local tmp_v2, tmp_rect

class "ZbcHud" (CUIScriptWnd)

function ZbcHud:__init() super()
	tmp_rect = tmp_rect or Frect()
	self:SetWndRect(tmp_rect:set(0, 0, 1024, 768))
	self:SetAutoDelete(true)

	local xml = CScriptXmlInit()
	xml:ParseFile("ui_zbc_bodycam.xml")
	self.ring   = xml:InitStatic("zbc_ring", self)
	self.allies = zbc_allies.build(self, xml)      -- drawn above the housing, below the overlay
	self.logos  = {
		[0] = xml:InitStatic("zbc_logo_tex", self), -- official logo texture
		[1] = xml:InitStatic("zbc_logo", self),     -- procedural swirl
		[2] = xml:InitStatic("zbc_tri", self),      -- procedural plain triangle
	}
	local function new_line(n)
		local glyphs = {}
		for c = 1, n do
			local g = xml:InitStatic("zbc_glyph", self)
			g:SetStretchTexture(true)
			g:Show(false)
			glyphs[c] = g
		end
		return { glyphs = glyphs, text = nil, visible = false }
	end
	self.lines = {}
	for i = 1, OSD_LINES do self.lines[i] = new_line(MAX_CHARS) end
	-- recording timer (top left), used while the lens is off; with the lens on the post shader draws it
	self.rec_dot = xml:InitStatic("zbc_dot", self)
	self.rec_dot:Show(false)
	self.rec_dot_shown = false
	self.batt = xml:InitStatic("zbc_batt", self)
	self.batt:Show(false)
	self.batt_shown = false
	self.batt_color = nil
	self.rec_line = new_line(REC_CHARS)
	-- event log (zbc_eventlog.script): a few lines under the recording timer, always HUD-drawn
	self.log_lines = {}
	for i = 1, 3 do self.log_lines[i] = new_line(MAX_CHARS) end
	self.rec_sec = nil
	self.last_w = -1
	self.last_h = -1
	self.last_fs = -1
	self.asp = 16 / 9
	self.eff_w_u = 1
	self.eff_asp = 16 / 9
	self.em_v = 0
	self.ring_shown = nil
	self.logos_hidden = false
	self.shown_logo_style = nil
	self.osd_dirty = true
	self.osd_date = nil
	self.osd_dev = nil
	self.osd_show_name = nil
	self.osd_tz = nil
	self.osd_iso = nil
	self.osd_w = nil
	self.osd_h = nil
	self.osd_fs = nil
	self.sec_date = nil
	self:Apply()
end

function ZbcHud:__finalize() end

-- settings that change appearance
function ZbcHud:Apply()
	local ta = floor(255 * clamp01(cfg.text_opacity))
	for _, line in ipairs(self.lines) do
		for _, g in ipairs(line.glyphs) do g:SetTextureColor(GetARGB(ta, 255, 255, 255)) end
		line.text = nil                                  -- re-lay the glyphs
	end
	for _, g in ipairs(self.rec_line.glyphs) do g:SetTextureColor(GetARGB(ta, 255, 255, 255)) end
	self.rec_line.text = nil
	self.rec_dot:SetTextureColor(GetARGB(ta, 235, 30, 24))
	local la = floor(255 * clamp01(cfg.logo_opacity))
	self.logos[0]:SetTextureColor(GetARGB(la, 255, 255, 255))   -- the texture has its own colours
	self.logos[1]:SetTextureColor(GetARGB(la, 255, 225, 0))
	self.logos[2]:SetTextureColor(GetARGB(la, 255, 225, 0))
	-- the ring shader reads the grain amount from the red channel
	self.ring:SetTextureColor(GetARGB(255, floor(255 * clamp01(cfg.grain)), 255, 255))
	self.last_w = -1
	self.shown_logo_style = nil
	self.osd_dirty = true
end

-- the reference layout is in % of effective 16:9 width (eff_w), keeping ultrawide crisp in top-right
function ZbcHud:Layout()
	local dev = device()
	local W, H = dev and dev.width or 0, dev and dev.height or 0
	if W <= 0 or H <= 0 then return end
	local fs = cfg.font_size
	if W == self.last_w and H == self.last_h and fs == self.last_fs then return end
	self.last_w, self.last_h, self.last_fs = W, H, fs

	local ux, uy = 1024 / W, 768 / H                 -- UI units per screen pixel
	local eff_w = min(W, H * (16 / 9))

	tmp_v2 = tmp_v2 or vector2()
	self.ring:SetWndPos(tmp_v2:set(0, 0))
	self.ring:SetWndSize(tmp_v2:set(1024, 768))

	local logo_x = (W - 0.050 * eff_w) * ux
	local logo_y = (0.026 * eff_w) * uy
	local logo_w = (0.035 * eff_w) * ux
	local logo_h = (0.035 * eff_w) * uy
	for _, s in pairs(self.logos) do
		s:SetWndPos(tmp_v2:set(logo_x, logo_y))
		s:SetWndSize(tmp_v2:set(logo_w, logo_h))    -- square on screen
	end

	-- text: right edge just left of the logo, lines one em apart starting at 3vw
	local em_px = (FONT_VW[fs] or 1.2) * 0.01 * eff_w
	self.asp = W / H
	self.eff_w_u = eff_w / W
	self.eff_asp = eff_w / H
	self.em_v = em_px / H
	self.osd_dirty = true
	self.glyph = {
		scale = em_px / F.em,                          -- screen px per atlas px
		ux = ux, uy = uy,
		right = W - 0.054 * eff_w,                     -- screen px
		tops = { 0.030 * eff_w, 0.030 * eff_w + em_px, 0.030 * eff_w + 2 * em_px, 0.030 * eff_w + 3 * em_px },
	}
	for _, line in ipairs(self.lines) do line.text = nil end

	-- recording timer: mirrors the logo's margin on the left, on the first text line
	local rec_left = 0.015 * eff_w
	local dot_d = REC_DOT_D * em_px
	local dot_top = 0.030 * eff_w + REC_DOT_CY * em_px - dot_d / 2
	self.rec_dot:SetWndPos(tmp_v2:set(rec_left * ux, dot_top * uy))
	self.rec_dot:SetWndSize(tmp_v2:set(dot_d * ux, dot_d * uy))
	local batt_top = dot_top - (BATT_ABOVE + BATT_H) * em_px
	self.batt:SetWndPos(tmp_v2:set(rec_left * ux, batt_top * uy))
	self.batt:SetWndSize(tmp_v2:set(BATT_W * em_px * ux, BATT_H * em_px * uy))
	self.glyph.rec_x = rec_left + dot_d + REC_GAP * em_px
	self.glyph.log_x = rec_left
	if self.log_lines then for _, l in ipairs(self.log_lines) do l.text = nil end end
	self.rec_left_u = rec_left / W
	self.rec_line.text = nil
end

-- atlas cell of a Windows-1251 character (ASCII and Russian letters), nil for a space or no glyph
local function glyph_cell(code)
	if F.index then return F.index(code) end
	if code > 32 and code >= F.first and code <= F.last then return code - F.first end
	return nil
end
local function drawable(code) return glyph_cell(code) ~= nil end

-- lay out one line of glyphs from screen px (x0, y0)
local function lay_glyphs(line, str, G, x0, y0)
	line.text = str
	local count = #line.glyphs
	local n = min(#str, count)
	local adv = F.advance * G.scale
	tmp_v2 = tmp_v2 or vector2()
	tmp_rect = tmp_rect or Frect()
	local qw, qh = F.cell_w * G.scale * G.ux, F.cell_h * G.scale * G.uy
	for c = 1, count do
		local g = line.glyphs[c]
		local k = (c <= n) and glyph_cell(string.byte(str, c)) or nil
		if not k then
			g:Show(false)
		else
			local tx, ty = (k % F.cols) * F.cell_w, floor(k / F.cols) * F.cell_h
			g:SetTextureRect(tmp_rect:set(tx, ty, tx + F.cell_w, ty + F.cell_h))
			local px = x0 + (c - 1) * adv - F.pad * G.scale
			local py = y0 - F.pad * G.scale
			g:SetWndPos(tmp_v2:set(px * G.ux, py * G.uy))
			g:SetWndSize(tmp_v2:set(qw, qh))
			g:Show(line.visible)
		end
	end
end

local function show_line(line, vis)
	if line.visible == vis then return end
	line.visible = vis
	-- walk every glyph: text is nil after a re-layout request, and stale glyphs must still hide
	local str = line.text
	local n = str and #str or 0
	for c = 1, #line.glyphs do
		line.glyphs[c]:Show(vis and c <= n and drawable(string.byte(str, c)))
	end
end

-- one overlay line, right-aligned against the logo
function ZbcHud:SetLine(i, str)
	local line = self.lines[i]
	if line.text == str then return end
	local G = self.glyph
	local n = min(#str, MAX_CHARS)
	lay_glyphs(line, str, G, G.right - n * F.advance * G.scale, G.tops[i])
end

function ZbcHud:ShowLine(i, vis)
	show_line(self.lines[i], vis)
end

-- recording timer: shader-drawn while the lens is on, HUD glyphs otherwise
-- event log lines under the recording timer (newest last), left-aligned with the dot
function ZbcHud:RefreshLog(visible)
	if not (self.log_lines and self.glyph) then return end
	local lines = (visible and cfg.event_log and zbc_eventlog and zbc_eventlog.recent) and zbc_eventlog.recent() or {}
	local G = self.glyph
	for i = 1, #self.log_lines do
		local line, str = self.log_lines[i], lines[i]
		if str and G.tops[i + 1] then
			if line.text ~= str then
				line.visible = true
				lay_glyphs(line, str, G, G.log_x or 0, G.tops[i + 1] + 0.4 * (G.tops[2] - G.tops[1]))
			else
				show_line(line, true)
			end
		else
			show_line(line, false)
		end
	end
end

function ZbcHud:RefreshRec(visible, lens_on)
	local show = cfg.rec_timer and visible and rec.secs ~= nil
	local secs = rec_whole()
	local dot = rec_dot_on()
	local hud_text, hud_dot = false, false
	if lens_on then
		if show then
			send("osd_layout", 1.0 - 0.050 * self.eff_w_u, 0.026 * self.eff_asp, 0.035 * self.eff_w_u, self.em_v)
			send("rec", 1, dot and 1 or 0, secs, clamp01(cfg.text_opacity))
		else
			send("rec", 0, 0, 0, 0)
		end
	else
		if tokens then send("rec", 0, 0, 0, 0) end
		if show and self.glyph then
			local ev = fx_event and fx_event_on   -- blinks; " EVENT" is last, so nothing else moves
			if self.rec_line.text == nil or secs ~= self.rec_sec or ev ~= self.rec_ev then
				self.rec_sec, self.rec_ev = secs, ev
				local G = self.glyph
				lay_glyphs(self.rec_line, rec_text(secs, ev), G, G.rec_x, G.tops[1])
			end
			hud_text, hud_dot = true, dot
		end
	end
	show_line(self.rec_line, hud_text)
	if self.rec_dot_shown ~= hud_dot then
		self.rec_dot:Show(hud_dot)
		self.rec_dot_shown = hud_dot
	end

	-- VHS battery gauge, just above the dot (only with the bodycam item component)
	local level = (cfg.rec_timer and cfg.battery_gauge and visible) and battery_level() or nil
	local bars = level and battery_bars(level) or 0
	local last_on = not (level and battery_flashing(level)) or (time_global() % 1000) < 500   -- 1 Hz flash
	local op = clamp01(cfg.text_opacity)
	local hud_batt = false
	if lens_on then
		if level then send("osd_layout", 1.0 - 0.050 * self.eff_w_u, 0.026 * self.eff_asp, 0.035 * self.eff_w_u, self.em_v) end
		send("batt", level and 1 or 0, bars, last_on and 1 or 0, op)
	else
		if tokens then send("batt", 0, 0, 0, 0) end
		if level then
			hud_batt = true
			local col = GetARGB(floor(255 * op), floor(255 * bars / 4 + 0.5), last_on and 255 or 0, 255)
			if col ~= self.batt_color then
				self.batt:SetTextureColor(col)
				self.batt_color = col
			end
		end
	end
	if self.batt_shown ~= hud_batt then
		self.batt:Show(hud_batt)
		self.batt_shown = hud_batt
	end
end

-- the four overlay lines: date, device + serial, name, GPS. Hidden lines are left out, so the GPS
-- line moves up when the name is off.
function overlay_lines(date)
	local dev_str, upper_name = actor_ident(effective_device_label())
	local l = { date, dev_str }
	if cfg.show_name then l[#l + 1] = upper_name end
	local actor = db.actor
	if cfg.gps_line and actor and zbc_fx and zbc_fx.gps_text then
		local p = actor:position()
		l[#l + 1] = zbc_fx.gps_text(p.x, p.z)
	end
	return l[1] or "", l[2] or "", l[3] or "", l[4] or ""
end

function ZbcHud:Refresh(visible, lens_on, lens)
	self:Layout()

	zbc_allies.update(self.allies, cfg, lens, visible)
	if not self.glyph then return end
	local osd_in_post = lens_on and atlas_uploaded
	self:RefreshRec(visible, osd_in_post)
	self:RefreshLog(visible)

	-- the housing follows the lens itself, so it stays while the lens fades out (no exposed edges)
	local ring_vis = lens_on and not cfg.edge_in_image
	if self.ring_shown ~= ring_vis then
		self.ring:Show(ring_vis)
		self.ring_shown = ring_vis
	end

	local show = cfg.overlay and visible
	if osd_in_post then
		if not self.logos_hidden then
			for _, s in pairs(self.logos) do s:Show(false) end
			for i = 1, OSD_LINES do self:ShowLine(i, false) end
			self.logos_hidden = true
			self.shown_logo_style = -1
		end

		send("osd_info", show and 1 or 0, cfg.logo_style, clamp01(cfg.text_opacity), clamp01(cfg.logo_opacity))
		if not show then return end

		send("osd_layout", 1.0 - 0.050 * self.eff_w_u, 0.026 * self.eff_asp, 0.035 * self.eff_w_u, self.em_v)
		local date, sec = date_line()
		local dev = effective_device_label()
		if self.osd_dirty
			or date ~= self.osd_date
			or dev ~= self.osd_dev
			or cfg.show_name ~= self.osd_show_name
			or cfg.timezone ~= self.osd_tz
			or cfg.iso_t ~= self.osd_iso
			or self.last_w ~= self.osd_w
			or self.last_h ~= self.osd_h
			or self.last_fs ~= self.osd_fs
			or self.lines[1].text ~= nil
		then
			self.sec = sec
			self.osd_date = date
			self.osd_dev = dev
			self.osd_show_name = cfg.show_name
			self.osd_tz = cfg.timezone
			self.osd_iso = cfg.iso_t
			self.osd_w = self.last_w
			self.osd_h = self.last_h
			self.osd_fs = self.last_fs
			self.osd_dirty = false
			self.lines[1].text = nil
			upload_osd_chars(overlay_lines(date))
		end
		return
	end

	self.osd_dirty = true
	self.logos_hidden = false
	if tokens then
		send("osd_info", 0, cfg.logo_style, 0, 0)
	end

	local target_logo = show and cfg.logo_style or -1
	if self.shown_logo_style ~= target_logo then
		for style, s in pairs(self.logos) do s:Show(show and cfg.logo_style == style) end
		self.shown_logo_style = target_logo
	end
	if not show then
		for i = 1, OSD_LINES do self:ShowLine(i, false) end
		return
	end

	local date, sec = date_line()
	local dev = effective_device_label()
	if date ~= self.sec_date or sec ~= self.sec or dev ~= self.sec_dev or self.lines[1].text == nil then
		self.sec = sec
		self.sec_date = date
		self.sec_dev = dev
		local l = { overlay_lines(date) }
		for i = 1, OSD_LINES do
			self:SetLine(i, l[i])
			self:ShowLine(i, #l[i] > 0)
		end
	end
end

---------------------------------------------------------------------------------------------------
-- Lifecycle
---------------------------------------------------------------------------------------------------

local HUD = nil
local in_menu = false
lens_state = { k = 0, ox = 0, oy = 0, roll = 0, dist = 0, zoom = 1, shutter = 0 }

function get_rolling_shutter()
	return lens_state and lens_state.shutter or 0
end

local function hud_add()
	if HUD or not cfg.enabled or not powered() then return end
	HUD = ZbcHud()
	get_hud():AddDialogToRender(HUD)
end

local function hud_remove()
	if not HUD then return end
	local h = get_hud()
	if h then h:RemoveDialogToRender(HUD) end
	HUD = nil
end

local function read_hud_visible()
	return _HUD_STATE
		and actor_menu.last_mode == 0
		and pda.dialog_closed == true
		and not Check_UI()
		and get_console_cmd(1, "hud_draw")
end

-- main_hud_shown() without its two zoom conditions: a bodycam keeps recording while you scope in
-- (the effect never changes with aiming: it is driven by movement only)
local function hud_visible()
	local ok, shown = pcall(read_hud_visible)
	if ok then return shown and true or false end
	return true
end

-- the camera lost power (bodycam item component): everything off, like the MCM toggle
local was_powered = true

local function power_down()
	hud_remove()
	lens_off()
	motion_reset()
	lens_state.k = 0
	lens_state.shutter = 0
end

local fx_last = nil
local dead = false

-- Signal lost runs on real time. A death screen mod can stop game time when you die (Death Like
-- Romeo sets time_factor 0), and timers.x and time_global() stop with it, so the shader's own death
-- clock would sit at 0 s and nothing would play. time_continual() keeps going; the seconds since death
-- go to the shader in the glitch lane's w, ticked by a small HUD window, since UI windows keep
-- updating while game time is stopped (actor_on_update may not).
local death_real = nil                       -- real time of death in seconds, nil while alive
local death_game_t = 0                       -- the death time sent in the glitch lane's z
local death_clock = nil                      -- the window that ticks the clock
local death_logged = false                   -- one log line on the clock's first tick

local function real_now()
	if time_continual then return time_continual() / 1000 end
	return os.clock()
end

-- seconds since death on the real clock, 0 while alive
function death_age(now)
	if not death_real then return 0 end
	return max((now or real_now()) - death_real, 0)
end

function death_clock_tick()
	if not death_real then return end
	if not death_logged then
		death_logged = true
		printf("[Zone Bodycam] signal lost: clock running (game time %.2f s, real age %.2f s)",
			time_global() / 1000 - death_game_t, death_age())
	end
	send("glitch", 0, 0, death_game_t, death_age())
end

class "ZbcDeathClock" (CUIScriptWnd)

function ZbcDeathClock:__init() super()
	self:SetWndRect(Frect():set(0, 0, 1, 1))
	self:SetAutoDelete(true)
end

function ZbcDeathClock:Update()
	CUIScriptWnd.Update(self)
	death_clock_tick()
end

local function death_clock_stop()
	death_real = nil
	death_game_t = 0
	if not death_clock then return end
	local h = get_hud()
	if h then h:RemoveDialogToRender(death_clock) end
	death_clock = nil
end

local function death_clock_start(death_t)
	death_clock_stop()
	death_real = real_now()
	death_game_t = death_t
	death_logged = false
	death_clock = ZbcDeathClock()
	death_clock:Show(true)                   -- shown, like any HUD dialog, or the HUD skips its Update
	get_hud():AddDialogToRender(death_clock)
end

local function settings_changed()
	clear_send_cache()
	load_settings()
	sync_lens_settings()
	if not cfg.enabled then
		hud_remove()
		lens_off()
		motion_reset()
		rec.last_t = nil
		lens_state.k = 0
		lens_state.shutter = 0
		return
	end
	if not cfg.lens_enabled then
		lens_off()
		motion_reset()
		lens_state.k = 0
		lens_state.shutter = 0
	elseif in_menu and db.actor and not dead and powered() and bus_ready() then
		S.vis = 1
		S.out_i = cfg.intensity
		S.out_rs = 0
		send("motion",  cfg.intensity, S.out_x, S.out_y, S.out_r)
		send("vig",     S.out_vx, S.out_vy, S.out_vt, S.out_vr)
		send("vig_occ", S.out_ox, S.out_oy, cfg.rig_occlusion, housing_power())
		send("sensor",  cfg.highlight_blowout, cfg.compression, 0, cfg.sensor_grade)
		lens_state.k = clamp01(cfg.intensity)
		lens_state.ox, lens_state.oy, lens_state.roll = S.out_x, S.out_y, S.out_r
		lens_state.dist, lens_state.zoom, lens_state.shutter = cfg.distortion, cur_zoom or lens_zoom(), 0
	elseif in_menu then
		lens_off()
		lens_state.k = 0
		lens_state.shutter = 0
	end
	if db.actor and not dead then hud_add() end
	if HUD then HUD:Apply() end
end

function actor_on_first_update()
	in_menu = false                          -- loading from the title menu may not fire main_menu_on_quit
	dead = false
	death_clock_stop()
	fx_last = nil
	faces_was_on = false
	if zbc_faces and zbc_faces.reset then zbc_faces.reset() end
	if zbc_allies and zbc_allies.clear_known then zbc_allies.clear_known() end
	if tokens then send("glitch", 0, 0, 0, 0) end
	rec_on_first_update()
	clear_send_cache()
	cur_tier = read_tier()
	load_settings()
	motion_reset()
	was_powered = powered()
	sync_lens_settings()
	if not (cfg.enabled and cfg.lens_enabled and was_powered) then lens_off() end
	hud_add()
end

---------------------------------------------------------------------------------------------------
-- Camera effects (zbc_fx.script): interference, signal lost, low light, lens dirt, event marker
---------------------------------------------------------------------------------------------------

function fx_enabled() return cfg.enabled and powered() end
function fx_option(id) return cfg[id] and true or false end

local function fx_update()
	if not (zbc_fx and zbc_fx.frame and bus_ready()) then return end
	local now = time_global() / 1000
	local dt = fx_last and (now - fx_last) or 0
	fx_last = now
	local F = zbc_fx.frame(cfg, dt)
	fx_event = F.event and cfg.rec_timer or false
	fx_event_on = fx_event and F.event_on or false
	fx_shake = F.shake or 0
	send("glitch", F.glitch, F.burst, F.death_t, death_age())
	send("ir",     F.ir, F.exposure or 1, 0, 0)
	-- the camera tier's low-light noise: more grain in the dark on the old cameras, less on Body 5
	local T = tiers()
	if cfg.lens_enabled and cfg.dark_grain and cfg.dark_grain ~= 0 and T then
		send("extra", min(max(cfg.edge_follow, 0), 3), clamp01(cfg.sharpen),
			T.grain_in_dark(cfg.grain, cfg.dark_grain, F.dark), cfg.edge_in_image and 1.0 or 0.0)
	end
	local b = F.blood or {}
	local function bt(i) return b[i] and b[i].t or 0 end
	local function bd(i) return b[i] and b[i].drip or 0 end
	send("dirt",   bt(1), bt(2), bt(3), bt(4))
	send("blood",  bd(1), bd(2), bd(3), bd(4))
	send("event",  fx_event and 1 or 0, fx_event_on and 1 or 0, 0, 0)
end

-- compression blocks up while the camera swings (zbc_fx.compression_level)
function compression_now()
	if zbc_fx and zbc_fx.compression_level then return zbc_fx.compression_level(cfg.compression, fx_shake) end
	return cfg.compression
end

-- Called by zbc_fx on the actor's death: the shader takes it from here (glitch, cut to black,
-- "SIGNAL LOST" over the last timestamp), timed from death_t on its own clock, so it keeps going
-- even if the scripts stop updating.
function signal_lost(death_t)
	if dead or not bus_ready() then return end
	dead = true
	send("glitch", 0, 0, death_t, 0)               -- the shader times the break-up from death_t
	local ok, err = pcall(death_clock_start, death_t)   -- and from the real clock, if game time stops
	printf("[Zone Bodycam] signal lost at %.2f s%s", death_t, ok and "" or (": clock failed: " .. tostring(err)))
	-- the in-shader text: line 4 carries the translated "SIGNAL LOST", line 1 the last timestamp
	local date = date_line()
	upload_osd_chars(date, "", "", zbc_allies and zbc_allies.upper_cp1251
		and zbc_allies.upper_cp1251(game.translate_string("st_zbc_signal_lost")) or "SIGNAL LOST")
	hud_remove()                                   -- markers, labels and HUD text go with the feed
end

-- a different camera generation carried: the settings, lens lanes and overlay lines follow it
local function retier()
	local t = read_tier()
	if t == cur_tier then return false end
	cur_tier = t
	clear_send_cache()
	load_settings()
	sync_lens_settings()
	if HUD then HUD.osd_dirty = true end
	return true
end

function actor_on_update()
	if not cfg.enabled or in_menu then return end
	retier()
	if dead then
		if db.actor and db.actor:alive() then
			dead = false
			death_clock_stop()
			fx_last = nil
			if tokens then send("glitch", 0, 0, 0, 0) end
			hud_add()
			if HUD then HUD.osd_dirty = true end
		else
			return
		end
	end
	rec_tick()                               -- keeps recording while the camera has no power
	if not powered() then
		if was_powered then power_down() end
		was_powered = false
		if zbc_fx and zbc_fx.frame then
			local now = time_global() / 1000
			local dt = fx_last and (now - fx_last) or 0
			fx_last = now
			zbc_fx.frame(cfg, dt, false)
		end
		return
	end
	if not was_powered then
		was_powered = true
		motion_reset()                       -- fades back in
		hud_add()
	end
	local visible = hud_visible()
	local ox, oy, orr, inten = 0, 0, 0, 0
	local vx, vy, vt, vr, occ_x, occ_y, rs = 0, 0, 0, 0, 0, 0, 0
	if cfg.lens_enabled then
		ox, oy, orr, inten, vx, vy, vt, vr, occ_x, occ_y, rs = motion_update()
	end
	local lens_on = cfg.lens_enabled and inten > 0.002 and bus_ready()
	if lens_on then
		send("motion",  inten, ox, oy, orr)
		send("vig",     vx, vy, vt, vr)
		send("vig_occ", occ_x, occ_y, cfg.rig_occlusion, housing_power())
		send("sensor",  cfg.highlight_blowout, compression_now(), rs, cfg.sensor_grade)
	else
		lens_off(true)
		rs = 0
	end
	faces_update()
	fx_update()
	if HUD then
		-- the lens exactly as the shader sees it, for placing ally markers
		local L = lens_state
		L.k = lens_on and clamp01(inten) or 0
		L.ox, L.oy, L.roll = ox, oy, orr
		L.dist, L.zoom, L.shutter = cfg.distortion, cur_zoom or lens_zoom(), rs
		HUD:Refresh(visible, lens_on, L)
	end
end

function actor_on_net_destroy()
	dead = false
	death_clock_stop()
	fx_last = nil
	faces_was_on = false
	if zbc_faces and zbc_faces.reset then zbc_faces.reset() end
	if zbc_allies and zbc_allies.clear_known then zbc_allies.clear_known() end
	hud_remove()
	clear_send_cache()
	lens_off()
	motion_reset()
	lens_state.k = 0
	lens_state.shutter = 0
end

-- Title menu (no actor): turn the lens off. In-game pause/MCM: keep the lens active and zero rolling shutter.
function main_menu_on_init()
	in_menu = true
	clear_send_cache()
	if db.actor and cfg.enabled and cfg.lens_enabled and powered() then
		S.yaw_vel_s = 0
		S.shutter_shock = 0
		S.out_rs = 0
		lens_state.shutter = 0
		if tokens then
			send("sensor", cfg.highlight_blowout, cfg.compression, 0, cfg.sensor_grade)
			send("osd_info", 0, cfg.logo_style or defaults.logo_style or 0, 0, 0)
			send("rec", 0, 0, 0, 0)
			send("batt", 0, 0, 0, 0)
		end
	else
		lens_off()
		lens_state.k = 0
		lens_state.shutter = 0
	end
end

function main_menu_on_quit()
	in_menu = false
	S.t = nil
	S.ready = false
	rec.last_t = nil                         -- the pause is not recorded
end

function on_screen_resolution_changed()
	if HUD then HUD.last_w = -1 end
	if db.actor and cfg.enabled ~= nil then sync_lens_settings() end   -- the fill zoom depends on the aspect ratio
end

-- the footage review screen (zbc_review.script) opens and closes on its MCM key
function review_key_now() return cfg.review_key end

function on_key_press(key)
	if not (cfg.enabled and not in_menu and db.actor and zbc_review and zbc_review.toggle) then return end
	local rk = tonumber(cfg.review_key)
	if not rk or rk <= 0 or key ~= rk then
		-- the review key of a camera without playback (Axon Body 1 and 2): say so
		local urk = tonumber(user_cfg.review_key)
		if urk and urk > 0 and key == urk and actor_menu and actor_menu.set_msg then
			actor_menu.set_msg(1, game.translate_string("st_zbc_no_review"), 3)
		end
		return
	end
	if not (zbc_review.is_open and zbc_review.is_open()) then
		if Check_UI and Check_UI() then return end
		if actor_menu and actor_menu.last_mode and actor_menu.last_mode ~= 0 then return end
	end
	zbc_review.toggle()
end

function on_game_start()
	load_settings()
	lens_off()                               -- clears a value left in user.ltx by a crash
	RegisterScriptCallback("actor_on_first_update", actor_on_first_update)
	RegisterScriptCallback("actor_on_update", actor_on_update)
	RegisterScriptCallback("actor_on_net_destroy", actor_on_net_destroy)
	RegisterScriptCallback("actor_on_footstep", actor_on_footstep)
	RegisterScriptCallback("actor_on_jump", actor_on_jump)
	RegisterScriptCallback("actor_on_land", actor_on_land)
	RegisterScriptCallback("actor_on_weapon_fired", actor_on_weapon_fired)
	RegisterScriptCallback("actor_on_before_hit", actor_on_before_hit)
	RegisterScriptCallback("main_menu_on_init", main_menu_on_init)
	RegisterScriptCallback("main_menu_on_quit", main_menu_on_quit)
	RegisterScriptCallback("on_screen_resolution_changed", on_screen_resolution_changed)
	RegisterScriptCallback("on_option_change", settings_changed)
	RegisterScriptCallback("on_key_press", on_key_press)
end
