--[[
	Zone Bodycam (zbc_bodycam.script)

	A chest-mounted police bodycam look for Anomaly / GAMMA. The lens needs the Shader Bus of the
	modded exes (2026.10.11 or newer, bus version 7); the Slop-Ray engine also works.

	- Lens: barrel distortion, zoom, chromatic aberration, sharpening and a small-sensor grade, applied
	  in the display-resolution post chain (shaders\r3\postprocess*.ps + zbc_lens.h). Slop-Ray runs
	  that chain after DLSS/FSR reconstruction, so the upscaler never sees the warp.
	- Housing, vignette and grain: a procedural HUD layer (shader hud\zbc_ring), drawn after frame
	  generation's HUD-less capture so the static edge never smears.
	- Body motion: the camera is on the chest, not the head. Turn lag, gait bob and roll, strafe
	  lean, breathing, and spring-damped impacts (steps, landings, jumps, shots, hits, crouching).
	  Built on the two-stage damped chase of Sludge's Intrusive 3D Masks, made frame-rate independent.
	- Overlay (top right): game date and time with the Zone's UTC offset, device line with a serial,
	  character name, and the triangle logo. All procedural, no texture files.

	Shader values go through the modded exes' Shader Bus on private lanes (bus_zbc_motion per frame,
	bus_zbc_lens and bus_zbc_edge for settings), so nothing is written to the console or user.ltx.
	HUD shaders bind the base texture like the engine's hud_default: the UI expects every HUD shader to.
	The Lua name "bodycam" belongs to the engine's Immersive Bodycam, so everything here is "zbc".
]]

local exp, sin, abs, floor, min, max, asin = math.exp, math.sin, math.abs, math.floor, math.min, math.max, math.asin
local tanh = math.tanh
local TWO_PI = 2 * math.pi

local function clamp01(v) return min(max(v, 0), 1) end

---------------------------------------------------------------------------------------------------
-- Settings
---------------------------------------------------------------------------------------------------

defaults = {
	enabled           = true,
	-- lens & sensor
	lens_enabled      = true,
	intensity         = 1.0,
	distortion        = 0.20,
	aberration        = 0.28,
	zoom              = 1.24,
	sharpen           = 0.40,
	edge_soft_blur    = 0.45,
	edge_radius       = 0.68,
	edge_softness     = 0.22,
	edge_shape        = 0.65,   -- 0 = circle, 1 = screen aspect
	housing_roundness = 0.55,   -- 0..1 -> superellipse exponent 2.0..5.0
	lens_housing      = true,   -- the black rounded edge of the lens housing (off: full frame, vignette stays)
	vignette          = 0.55,
	rig_occlusion     = 0.85,
	grain             = 0.35,
	edge_in_image     = true,   -- housing, vignette and grain in the image: under the game HUD, frame generation friendly
	edge_follow       = 1.5,    -- how far the vignette/housing follows body motion (0 = fixed)
	highlight_blowout = 0.55,
