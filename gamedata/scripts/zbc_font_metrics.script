-- Zone Bodycam - glyph atlas layout, generated by tools\make_overlay_assets.py
-- from KlartextMonoBold.ttf + RobotoMono-VariableFont_wght.ttf (Russian letters). Do not edit by hand.
texture = "ui\\zbc_font"
tex_w, tex_h = 688, 891
cols, first, last = 16, 32, 126
cell_w, cell_h = 43, 81
em = 64
advance = 33.000
pad = 5

-- atlas cell (0-based) of a Windows-1251 character code; nil for a space or no glyph
function index(code)
	if code > 32 and code <= 126 then return code - 32 end
	if code == 168 then return 95 end
	if code == 184 then return 96 end
	if code >= 192 and code <= 255 then return code - 192 + 97 end
	return nil
end
