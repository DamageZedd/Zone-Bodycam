--[[
	Zone Bodycam - footage review screen (zbc_review.script)

	Opens on the MCM key (Delete by default): the camera's event history (zbc_eventlog.script) as a
	timeline of the recording, with a tick for every event coloured by kind, and the list around the
	selected one. Left / right scrub through the events, Home / End jump to the first / last, Escape
	or the key again closes it.

	Upgrades:
	- Displays typed event tags (SHOT FIRED, HIT TAKEN, KILL, EMISSION, SIGNAL TRIGGER, AUDIO MUTE,
	  FOUND FOOTAGE, SIGNAL LOST) and optional metadata cleanly.
	- Shows an Axon Body 5 (Draft One style) Incident Summary panel when active camera tier == 5.
	- Allows switching to recovered Found Footage records from dead stalkers (hidden when none exist).
]]

local floor, min, max = math.floor, math.min, math.max

LIST_ROWS = 9
KIND_COLORS = {
	shots          = { 255, 210, 60 },
	contact        = { 255, 70, 60 },
	hit            = { 255, 140, 40 },
	down           = { 255, 140, 40 },
	kill           = { 235, 235, 235 },
	ident          = { 80, 255, 90 },
	storm          = { 190, 110, 255 },
	signal         = { 90, 210, 255 },
	signal_trigger = { 90, 210, 255 },
	mute           = { 165, 175, 190 },
	audio_mute     = { 165, 175, 190 },
	found_footage  = { 255, 200, 90 },
	signal_lost    = { 255, 55, 55 },
}
local DEFAULT_COLOR = { 200, 200, 200 }

-- "01:23:45" for a number of seconds
function rec_clock(s)
	s = max(floor(tonumber(s) or 0), 0)
	return string.format("%02d:%02d:%02d", min(floor(s / 3600), 999), floor(s / 60) % 60, s % 60)
end

-- x of an event on the timeline [x0, x1] covering recorded seconds [t0, t1]
function timeline_x(rec, t0, t1, x0, x1)
	if t1 - t0 < 1 then return x1 end
	return x0 + (x1 - x0) * min(max((rec - t0) / (t1 - t0), 0), 1)
end

-- the first row shown so the selected event sits in the list (rows, newest at the bottom)
function list_start(sel, count, rows)
	if count <= rows then return 1 end
	return min(max(sel - floor(rows / 2), 1), count - rows + 1)
end

local tmp_pos, tmp_size = nil, nil
local function place(w, x, y, wd, ht)
	tmp_pos = tmp_pos or vector2()
	tmp_size = tmp_size or vector2()
	w:SetWndPos(tmp_pos:set(x, y))
	w:SetWndSize(tmp_size:set(wd, ht))
end

local function upper(s)
	s = tostring(s or "")
	return zbc_allies and zbc_allies.upper_cp1251 and zbc_allies.upper_cp1251(s) or string.upper(s)
end

local function tr(id, def)
	local s = game and game.translate_string and game.translate_string(id)
	if type(s) ~= "string" or s == "" or s == id then s = def end
	return upper(s)
end

local function current_tier()
	if zbc_bodycam and zbc_bodycam.active_tier then
		return tonumber(zbc_bodycam.active_tier())
	end
	return nil
end

local function found_footage_list()
	if zbc_found_footage and zbc_found_footage.get_records then
		local r = zbc_found_footage.get_records()
		if type(r) == "table" then return r end
	end
	return {}
end

-- Formats a single timeline row for display (pure logic, unit-testable)
function format_event_row(e, is_selected)
	if type(e) ~= "table" then return "" end
	local mark = is_selected and "> " or "  "
	local body
	if zbc_eventlog and zbc_eventlog.format_entry then
		body = zbc_eventlog.format_entry(e)
	else
		local tag = e.tag or (e.kind and upper(tostring(e.kind):gsub("_", " ")))
		local txt = tostring(e.text or tag or "")
		if tag and tag ~= "" and upper(txt) ~= upper(tag) and not upper(txt):find(tag, 1, true) then
			body = "[" .. tag .. "] " .. txt
		else
			body = txt
		end
	end
	return mark .. "REC " .. rec_clock(e.rec or 0) .. "   " .. tostring(e.clock or "00:00") .. "   " .. body
end

local function format_intel_ru(n)
	if zbc_intel and zbc_intel.format_ru then
		return zbc_intel.format_ru(n)
	end
	local s = tostring(floor(tonumber(n) or 0))
	while true do
		local next_s, k = s:gsub("^(%-?%d+)(%d%d%d)", "%1,%2")
		s = next_s
		if k == 0 then break end
	end
	return s
end

function format_intel_tag(ff_rec)
	if type(ff_rec) ~= "table" then return nil end
	if ff_rec.redeemed == true then return "[UPLOADED]" end
	if zbc_intel and zbc_intel.estimate_payout then
		local ru = zbc_intel.estimate_payout(ff_rec)
		return string.format("[INTEL: %s RU]", format_intel_ru(ru))
	end
	return nil
end

function found_footage_hint(ff_rec, at_hub, cfg)
	if type(ff_rec) ~= "table" then return nil end
	if cfg and cfg.intel_sell_enabled == false then return nil end
	if ui_mcm and ui_mcm.get and not (cfg and cfg.intel_sell_enabled ~= nil) then
		local ok, en = pcall(ui_mcm.get, "zone_bodycam/intel_sell_enabled")
		if ok and en == false then return nil end
	end
	if ff_rec.redeemed == true then return "[UPLOADED]" end
	if not (zbc_intel and zbc_intel.estimate_payout) then return nil end

	local ru = zbc_intel.estimate_payout(ff_rec)
	local anywhere = cfg and cfg.intel_sell_anywhere == true
	if not anywhere and ui_mcm and ui_mcm.get then
		local ok, sa = pcall(ui_mcm.get, "zone_bodycam/intel_sell_anywhere")
		if ok and sa == true then anywhere = true end
	end
	if at_hub == nil and zbc_intel.is_at_safe_hub then
		at_hub = zbc_intel.is_at_safe_hub()
	end
	if at_hub == true or anywhere then
		return string.format("[S] Upload intel (+%s RU)", format_intel_ru(ru))
	end
	return "[S] Upload intel at safe hub"
end

-- Computes the Body 5 Incident Summary / Found Footage header text for the active view (pure logic)
function active_header_text(mode, hist, tier, ff_rec, ff_idx, ff_count)
	if mode == "found_footage" and type(ff_rec) == "table" then
		local base = string.format("FOUND FOOTAGE [%d/%d]   %s (%s)   %s   LOC: %s   TIME: %s",
			ff_idx or 1, ff_count or 1,
			upper(ff_rec.stalker_name or "UNKNOWN"),
			upper(ff_rec.faction_label or ff_rec.faction or "STALKER"),
			upper(ff_rec.camera_model or "AXON BODY"),
			upper(ff_rec.level_name or ff_rec.level or "ZONE"),
			tostring(ff_rec.timestamp or ""))
		local tag = format_intel_tag(ff_rec)
		if tag then base = base .. "   " .. tag end
		return base
	end
	if tier and tier >= 5 and zbc_eventlog and zbc_eventlog.build_incident_summary then
		return zbc_eventlog.build_incident_summary(hist, tier)
	end
	return nil
end

class "ZbcReview" (CUIScriptWnd)

function ZbcReview:__init() super()
	self:SetWndRect(Frect():set(0, 0, 1024, 768))
	self:SetAutoDelete(true)
	self.opened_at = time_global and time_global() or 0
	local xml = CScriptXmlInit()
	xml:ParseFile("ui_zbc_bodycam.xml")
	self.bg = xml:InitStatic("zbc_fill", self)
	place(self.bg, 0, 0, 1024, 768)
	self.bg:SetTextureColor(GetARGB(225, 4, 6, 5))
	self.title = xml:InitStatic("zbc_text", self)
	place(self.title, 64, 40, 900, 24)
	self.mode_bar = xml:InitStatic("zbc_text", self)
	place(self.mode_bar, 64, 68, 900, 20)
	self.summary_bg = xml:InitStatic("zbc_fill", self)
	place(self.summary_bg, 64, 94, 896, 36)
	self.summary_bg:SetTextureColor(GetARGB(180, 14, 28, 34))
	self.summary_bg:Show(false)
	self.summary = xml:InitStatic("zbc_text", self)
	place(self.summary, 76, 102, 872, 22)
	self.summary:Show(false)
	self.hint = xml:InitStatic("zbc_text", self)
	place(self.hint, 64, 712, 900, 20)
	self.bar = xml:InitStatic("zbc_fill", self)
	self.ticks, self.rows = {}, {}
	for i = 1, (zbc_eventlog and zbc_eventlog.HISTORY_MAX or 300) do
		local t = xml:InitStatic("zbc_fill", self)
		t:Show(false)
		self.ticks[i] = t
	end
	self.cursor = xml:InitStatic("zbc_fill", self)
	for i = 1, LIST_ROWS do
		local r = xml:InitStatic("zbc_text", self)
		place(r, 96, 150 + (i - 1) * 34, 860, 24)
		self.rows[i] = r
	end
	self.mode = "live"
	self.ff_idx = 1
	self.sel = nil
	self:Refresh()
end

function ZbcReview:__finalize()
	if Unregister_UI then Unregister_UI("ZbcReview") end
end

function ZbcReview:_active_events()
	local ff_list = found_footage_list()
	if self.mode == "found_footage" then
		if #ff_list == 0 then
			self.mode = "live"
		else
			self.ff_idx = min(max(self.ff_idx or 1, 1), #ff_list)
			local rec = ff_list[self.ff_idx]
			local evs = (rec and rec.events) or {}
			local last_rec = (#evs > 0 and tonumber(evs[#evs].rec)) or 0
			return evs, last_rec, ff_list, rec
		end
	end
	local hist = zbc_eventlog and zbc_eventlog.history or {}
	local now_rec = zbc_bodycam and zbc_bodycam.rec_seconds and zbc_bodycam.rec_seconds() or 0
	return hist, now_rec, ff_list, nil
end

function ZbcReview:Refresh()
	local hist, now_rec, ff_list, ff_rec = self:_active_events()
	local count = #hist
	if not self.sel or self.sel > count then self.sel = count end
	if count > 0 and self.sel < 1 then self.sel = 1 end

	local tier = current_tier()
	local title_text = tr("st_zbc_review_title", "Footage review") .. "   REC " .. rec_clock(now_rec)
	if self.mode == "found_footage" and ff_rec then
		title_text = tr("st_zbc_review_ff_title", "Found footage") .. "   " .. upper(ff_rec.camera_model or "AXON BODY")
	elseif tier == 5 then
		title_text = title_text .. "   [AXON BODY 5]"
	end
	self.title:TextControl():SetText(title_text)

	if #ff_list > 0 then
		if self.mode == "found_footage" then
			local bar_text = string.format("[MODE: FOUND FOOTAGE %d/%d]   TAB: LIVE FEED   [/]: PREV/NEXT TAPE",
				self.ff_idx, #ff_list)
			if self.intel_status_msg and self.intel_status_msg ~= "" then
				bar_text = bar_text .. "   |   " .. upper(self.intel_status_msg)
			end
			self.mode_bar:TextControl():SetText(bar_text)
			self.mode_bar:TextControl():SetTextColor(GetARGB(255, 255, 200, 90))
		else
			self.mode_bar:TextControl():SetText(string.format("[MODE: LIVE FEED]   TAB: FOUND FOOTAGE (%d RECOVERED)", #ff_list))
			self.mode_bar:TextControl():SetTextColor(GetARGB(255, 130, 210, 235))
		end
		self.mode_bar:Show(true)
	else
		self.mode_bar:TextControl():SetText("")
		self.mode_bar:Show(false)
	end

	local header = active_header_text(self.mode, hist, tier, ff_rec, self.ff_idx, #ff_list)
	if header and header ~= "" then
		self.summary:TextControl():SetText(header)
		if self.mode == "found_footage" then
			self.summary_bg:SetTextureColor(GetARGB(190, 34, 24, 10))
			self.summary:TextControl():SetTextColor(GetARGB(255, 255, 215, 120))
		else
			self.summary_bg:SetTextureColor(GetARGB(190, 12, 30, 38))
			self.summary:TextControl():SetTextColor(GetARGB(255, 145, 235, 255))
		end
		self.summary_bg:Show(true)
		self.summary:Show(true)
	else
		self.summary_bg:Show(false)
		self.summary:Show(false)
	end

	local hint_text = tr("st_zbc_review_hint", "Left / right: scrub   Home / End: first / last   Esc: close")
	if #ff_list > 0 then
		hint_text = hint_text .. "   Tab: switch feed   [ / ]: cycle tapes"
	end
	if self.mode == "found_footage" and ff_rec then
		local intel_hint = found_footage_hint(ff_rec)
		if intel_hint and intel_hint ~= "" then
			hint_text = hint_text .. "   " .. intel_hint
		end
	end
	self.hint:TextControl():SetText(hint_text)
	self.hint:TextControl():SetTextColor(GetARGB(255, 150, 150, 150))

	-- timeline: the recording from the first event to now
	local x0, x1, y = 96, 928, 560
	place(self.bar, x0, y, x1 - x0, 4)
	self.bar:SetTextureColor(GetARGB(255, 90, 90, 90))
	local t0 = count > 0 and (hist[1].rec or 0) or now_rec
	local t1 = max(now_rec, t0 + 1)
	for i = 1, #self.ticks do
		local tk, e = self.ticks[i], hist[i]
		if e then
			local c = KIND_COLORS[e.kind] or DEFAULT_COLOR
			place(tk, timeline_x(e.rec or 0, t0, t1, x0, x1) - 1.5, y - 10, 3, 24)
			tk:SetTextureColor(GetARGB(255, c[1], c[2], c[3]))
			tk:Show(true)
		else
			tk:Show(false)
		end
	end
	if count > 0 then
		place(self.cursor, timeline_x(hist[self.sel].rec or 0, t0, t1, x0, x1) - 3, y - 18, 6, 40)
		self.cursor:SetTextureColor(GetARGB(255, 255, 255, 255))
		self.cursor:Show(true)
	else
		self.cursor:Show(false)
	end

	-- the list around the selected event
	local first = list_start(self.sel or 1, count, LIST_ROWS)
	for i = 1, LIST_ROWS do
		local k = first + i - 1
		local e = hist[k]
		local tc = self.rows[i]:TextControl()
		if count == 0 and i == 1 then
			tc:SetText(tr("st_zbc_review_empty", "No events recorded yet"))
			tc:SetTextColor(GetARGB(255, 160, 160, 160))
		elseif e then
			local c = KIND_COLORS[e.kind] or DEFAULT_COLOR
			tc:SetText(format_event_row(e, k == self.sel))
			local a = (k == self.sel) and 255 or 170
			tc:SetTextColor(GetARGB(a, c[1], c[2], c[3]))
		else
			tc:SetText("")
		end
	end
end

local CLOSE_DEBOUNCE_MS = 150

function ZbcReview:OnKeyboard(dik, action)
	CUIScriptWnd.OnKeyboard(self, dik, action)
	if action ~= ui_events.WINDOW_KEY_PRESSED then return true end
	local evs, _, ff_list = self:_active_events()
	local count = #evs
	local K = DIK_keys
	local now = time_global and time_global() or 0
	local rk = zbc_bodycam and zbc_bodycam.review_key_now and tonumber(zbc_bodycam.review_key_now())
	if K.DIK_ESCAPE and dik == K.DIK_ESCAPE then
		close()
		return true
	elseif rk and dik == rk then
		if now - (self.opened_at or 0) >= CLOSE_DEBOUNCE_MS then close() end
		return true
	elseif ((K.DIK_TAB and dik == K.DIK_TAB) or (K.DIK_F and dik == K.DIK_F)) and #ff_list > 0 then
		self.mode = (self.mode == "live") and "found_footage" or "live"
		self.sel = nil
		self.intel_status_msg = nil
	elseif self.mode == "found_footage" and #ff_list > 1 and
		((K.DIK_LBRACKET and dik == K.DIK_LBRACKET) or (K.DIK_PRIOR and dik == K.DIK_PRIOR) or (K.DIK_Q and dik == K.DIK_Q)) then
		self.ff_idx = ((self.ff_idx - 2) % #ff_list) + 1
		self.sel = nil
		self.intel_status_msg = nil
	elseif self.mode == "found_footage" and #ff_list > 1 and
		((K.DIK_RBRACKET and dik == K.DIK_RBRACKET) or (K.DIK_NEXT and dik == K.DIK_NEXT) or (K.DIK_E and dik == K.DIK_E)) then
		self.ff_idx = (self.ff_idx % #ff_list) + 1
		self.sel = nil
		self.intel_status_msg = nil
	elseif self.mode == "found_footage" and
		((K.DIK_S and dik == K.DIK_S) or (K.DIK_RETURN and dik == K.DIK_RETURN) or (K.DIK_NUMPADENTER and dik == K.DIK_NUMPADENTER)) then
		if zbc_intel and zbc_intel.sell_record then
			local at_hub = zbc_intel.is_at_safe_hub and zbc_intel.is_at_safe_hub() or false
			local _, _, _, msg = zbc_intel.sell_record(self.ff_idx, at_hub)
			self.intel_status_msg = msg
		end
	elseif (K.DIK_LEFT and dik == K.DIK_LEFT) or (K.DIK_A and dik == K.DIK_A)
		or (K.DIK_UP and dik == K.DIK_UP) or (K.DIK_W and dik == K.DIK_W) then
		self.sel = max((self.sel or 1) - 1, 1)
	elseif (K.DIK_RIGHT and dik == K.DIK_RIGHT) or (K.DIK_D and dik == K.DIK_D)
		or (K.DIK_DOWN and dik == K.DIK_DOWN) or (K.DIK_S and dik == K.DIK_S) then
		self.sel = min((self.sel or count) + 1, count)
	elseif K.DIK_HOME and dik == K.DIK_HOME then
		self.sel = 1
	elseif K.DIK_END and dik == K.DIK_END then
		self.sel = count
	else
		return true
	end
	self:Refresh()
	return true
end

local WND = nil

function is_open()
	return WND ~= nil and WND:IsShown()
end

function close()
	if WND then
		if WND:IsShown() then
			WND:HideDialog()
			WND:Show(false)
		end
		WND = nil
	end
	if Unregister_UI then Unregister_UI("ZbcReview") end
end

function toggle()
	if WND and WND:IsShown() then
		local now = time_global and time_global() or 0
		if now - (WND.opened_at or 0) >= CLOSE_DEBOUNCE_MS then close() end
		return
	end
	WND = ZbcReview()
	WND:ShowDialog(true)
	if Register_UI then Register_UI("ZbcReview", "zbc_review") end
end

function on_game_start()
	RegisterScriptCallback("actor_on_net_destroy", close)
end
