  <string id="ui_mcm_zone_bodycam_lens_housing">
    <text>Lens housing edge</text>
  </string>
  <string id="ui_mcm_zone_bodycam_lens_housing_desc">
    <text>The black rounded edge of the camera housing around the picture. Off: the picture fills the screen; the vignette has its own slider.</text>
  </string>
  <string id="ui_mcm_zone_bodycam_battery_gauge">
    <text>Battery gauge</text>
  </string>
  <string id="ui_mcm_zone_bodycam_battery_gauge_desc">
    <text>VHS-style battery bars above the recording dot. Needs the bodycam item component and the recording timer.</text>
  </string>
  <string id="ui_mcm_zone_bodycam_rec_timer">
    <text>Recording timer (top left)</text>
  </string>
  <string id="ui_mcm_zone_bodycam_rec_timer_desc">
    <text>Flashing red dot and how long the camera has been recording in this playthrough. Real time, saved with the game.</text>
  </string>
  <string id="ui_mcm_zone_bodycam_roll">
    <text>Camera roll</text>
